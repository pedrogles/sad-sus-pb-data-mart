// Fase VII — painel tecnico associativo isolado. TEST QVW only; never STORE.
// Baseline: main@dfc02527b3791a19bcf9d9db29cb3979061dea81.
// Boundaries 6/7, VI-P5 (SAD-LINK-V1), V2 semantic. No KPIs, charts or UI objects.
// All __...__ QVD placeholders are replaced by the versioned PowerShell executor.
SET ErrorMode=1;
LET vV7Errors=ScriptErrorCount;
TRACE [VII] START TECHNICAL_MODEL_ONLY;

V7_MAP_LINK: MAPPING LOAD [%LINK_KEY], 1 FROM [__LINK__] (qvd);
V7_MAP_EST: MAPPING LOAD [%SK_ESTABELECIMENTO], 1 FROM [__EST__] (qvd);
V7_MAP_MUN: MAPPING LOAD [%SK_MUNICIPIO], 1 FROM [__MUN__] (qvd);
V7_MAP_COMP: MAPPING LOAD DISTINCT [%SK_TEMPO_COMPETENCIA], 1 FROM [__TEMPO__] (qvd);
V7_MAP_ANO: MAPPING LOAD DISTINCT [%SK_TEMPO_ANO], 1 FROM [__TEMPO__] (qvd);
V7_MAP_DATA: MAPPING LOAD [%SK_TEMPO_DATA], 1 FROM [__TEMPO__] (qvd);
V7_MAP_PROC: MAPPING LOAD [%SK_PROCEDIMENTO], 1 FROM [__PROC__] (qvd);
V7_MAP_DIAG: MAPPING LOAD [%SK_DIAGNOSTICO], 1 FROM [__DIAG__] (qvd);
V7_MAP_CAR: MAPPING LOAD [%SK_CARATER_ATENDIMENTO], 1 FROM [__CAR__] (qvd);
V7_MAP_MOT: MAPPING LOAD [%SK_MOTIVO_SAIDA], 1 FROM [__MOT__] (qvd);
V7_MAP_BED: MAPPING LOAD [%SK_TIPO_LEITO], 1 FROM [__BED__] (qvd);

// T22/T23: verify CNES x observed competence against monthly historical ST dimension.
// These are read-only source scans, NOT inferred from the published Link QVD alone.
V7_T22:
NOCONCATENATE LOAD
 Count(*) AS _VII_ROWS,
 Sum(If(ApplyMap('V7_MAP_EST',Hash128('ESTAB',Trim(Text(CNES)),
     Trim(Text(_META_SOURCE_COMPETENCE))),0)<>1,1,0)) AS _VII_MISSING
FROM [__RD_STAGE__] (qvd);
LET vV7T22Rows=Peek('_VII_ROWS',0,'V7_T22');
LET vV7T22Missing=Peek('_VII_MISSING',0,'V7_T22');
DROP TABLE V7_T22;
TRACE [VII] T22 RD_ST_ROWS=$(vV7T22Rows) MISSING=$(vV7T22Missing);
IF $(vV7T22Rows)<>566672 OR $(vV7T22Missing)<>0 THEN
 TRACE [VII] VERDICT=BLOCKED_T22_RD_ST;
 EXIT SCRIPT;
ENDIF

V7_T23:
NOCONCATENATE LOAD
 Count(*) AS _VII_ROWS,
 Sum(If(ApplyMap('V7_MAP_EST',Hash128('ESTAB',Trim(Text(CNES)),
     Trim(Text(COMPETEN))),0)<>1,1,0)) AS _VII_MISSING
FROM [__LT_STAGE__] (qvd);
LET vV7T23Rows=Peek('_VII_ROWS',0,'V7_T23');
LET vV7T23Missing=Peek('_VII_MISSING',0,'V7_T23');
DROP TABLE V7_T23;
TRACE [VII] T23 LT_ST_ROWS=$(vV7T23Rows) MISSING=$(vV7T23Missing);
IF $(vV7T23Rows)<>35518 OR $(vV7T23Missing)<>0 THEN
 TRACE [VII] VERDICT=BLOCKED_T23_LT_ST;
 EXIT SCRIPT;
ENDIF

// A unique link row must carry exactly the appropriate role coordinates.
// The QVD must remain physically unchanged. Hash formula is the existing VI-P5 one.
LINK_ANALISE:
NOCONCATENATE LOAD
 [%LINK_KEY], [%SK_TEMPO_COMPETENCIA], [%SK_TEMPO_ANO],
 [%SK_MUNICIPIO_RESIDENCIA], [%SK_MUNICIPIO_SERVICO],
 [%SK_ESTABELECIMENTO]
FROM [__LINK__] (qvd);
V7_LINK_AUDIT:
NOCONCATENATE LOAD
 Count(*) AS _VII_ROWS,
 Count(DISTINCT [%LINK_KEY]) AS _VII_KEYS,
 Sum(If(IsNull([%LINK_KEY]) OR IsNull([%SK_TEMPO_ANO])
     OR IsNull([%SK_MUNICIPIO_SERVICO])
     OR ApplyMap('V7_MAP_ANO',[%SK_TEMPO_ANO],0)<>1
     OR ApplyMap('V7_MAP_MUN',[%SK_MUNICIPIO_SERVICO],0)<>1
     OR (NOT IsNull([%SK_TEMPO_COMPETENCIA]) AND
         ApplyMap('V7_MAP_COMP',[%SK_TEMPO_COMPETENCIA],0)<>1)
     OR (NOT IsNull([%SK_MUNICIPIO_RESIDENCIA]) AND
         ApplyMap('V7_MAP_MUN',[%SK_MUNICIPIO_RESIDENCIA],0)<>1)
     OR (NOT IsNull([%SK_ESTABELECIMENTO]) AND
         ApplyMap('V7_MAP_EST',[%SK_ESTABELECIMENTO],0)<>1)
     OR (IsNull([%SK_TEMPO_COMPETENCIA]) AND
         (IsNull([%SK_MUNICIPIO_RESIDENCIA]) OR
          NOT IsNull([%SK_ESTABELECIMENTO])))
     OR (NOT IsNull([%SK_TEMPO_COMPETENCIA]) AND
         IsNull([%SK_ESTABELECIMENTO])),1,0)) AS _VII_BAD
RESIDENT LINK_ANALISE;
LET vV7LinkRows=Peek('_VII_ROWS',0,'V7_LINK_AUDIT');
LET vV7LinkKeys=Peek('_VII_KEYS',0,'V7_LINK_AUDIT');
LET vV7LinkBad=Peek('_VII_BAD',0,'V7_LINK_AUDIT');
DROP TABLE V7_LINK_AUDIT;
IF $(vV7LinkRows)<>85705 OR $(vV7LinkKeys)<>85705 OR $(vV7LinkBad)<>0 THEN
 TRACE [VII] VERDICT=BLOCKED_LINK_COORDINATES;
 EXIT SCRIPT;
ENDIF
TRACE [VII] LINK_ROWS=$(vV7LinkRows) UNIQUE_KEYS=$(vV7LinkKeys) BAD=$(vV7LinkBad);

// The two persisted fact keys are consumed WITHOUT rebuilding them.
FATO_INTERNACAO:
NOCONCATENATE LOAD * FROM [__FI__] (qvd);
V7_FI_AUDIT:
NOCONCATENATE LOAD
 Count(*) AS _VII_ROWS,
 Count(DISTINCT SK_REGISTRO_INTERNACAO) AS _VII_UNIQUE,
 Sum(If(IsNull([%LINK_KEY])
     OR ApplyMap('V7_MAP_LINK',[%LINK_KEY],0)<>1,1,0)) AS _VII_LINK_BAD,
 Sum(If(IsNull([%SK_TEMPO_INTERNACAO]) OR IsNull([%SK_TEMPO_SAIDA])
     OR IsNull([%SK_PROCEDIMENTO]) OR IsNull([%SK_DIAGNOSTICO])
     OR IsNull([%SK_CARATER_ATENDIMENTO]) OR IsNull([%SK_MOTIVO_SAIDA])
     OR ApplyMap('V7_MAP_DATA',[%SK_TEMPO_INTERNACAO],0)<>1
     OR ApplyMap('V7_MAP_DATA',[%SK_TEMPO_SAIDA],0)<>1
     OR ApplyMap('V7_MAP_PROC',[%SK_PROCEDIMENTO],0)<>1
     OR ApplyMap('V7_MAP_DIAG',[%SK_DIAGNOSTICO],0)<>1
     OR ApplyMap('V7_MAP_CAR',[%SK_CARATER_ATENDIMENTO],0)<>1
     OR ApplyMap('V7_MAP_MOT',[%SK_MOTIVO_SAIDA],0)<>1,1,0)) AS _VII_DIM_BAD
RESIDENT FATO_INTERNACAO;
LET vV7FIRows=Peek('_VII_ROWS',0,'V7_FI_AUDIT');
LET vV7FIUnique=Peek('_VII_UNIQUE',0,'V7_FI_AUDIT');
LET vV7FILinkBad=Peek('_VII_LINK_BAD',0,'V7_FI_AUDIT');
LET vV7FIDimBad=Peek('_VII_DIM_BAD',0,'V7_FI_AUDIT');
DROP TABLE V7_FI_AUDIT;
IF $(vV7FIRows)<>566672 OR $(vV7FIUnique)<>566672 OR $(vV7FILinkBad)<>0 OR $(vV7FIDimBad)<>0 THEN
 TRACE [VII] VERDICT=BLOCKED_FATO_INTERNACAO;
 EXIT SCRIPT;
ENDIF
TRACE [VII] T17_T18_T19 FI_ROWS=$(vV7FIRows) FI_LINK_BAD=$(vV7FILinkBad) FI_DIM_BAD=$(vV7FIDimBad);

FATO_CAPACIDADE_LEITO:
NOCONCATENATE LOAD * FROM [__LT_FACT__] (qvd);
V7_LT_AUDIT:
NOCONCATENATE LOAD
 Count(*) AS _VII_ROWS,
 Count(DISTINCT SK_REGISTRO_CAPACIDADE_LEITO) AS _VII_UNIQUE,
 Sum(If(IsNull([%LINK_KEY])
     OR ApplyMap('V7_MAP_LINK',[%LINK_KEY],0)<>1,1,0)) AS _VII_LINK_BAD,
 Sum(If(IsNull([%SK_TIPO_LEITO])
     OR ApplyMap('V7_MAP_BED',[%SK_TIPO_LEITO],0)<>1,1,0)) AS _VII_DIM_BAD
RESIDENT FATO_CAPACIDADE_LEITO;
LET vV7LTRows=Peek('_VII_ROWS',0,'V7_LT_AUDIT');
LET vV7LTUnique=Peek('_VII_UNIQUE',0,'V7_LT_AUDIT');
LET vV7LTLinkBad=Peek('_VII_LINK_BAD',0,'V7_LT_AUDIT');
LET vV7LTDimBad=Peek('_VII_DIM_BAD',0,'V7_LT_AUDIT');
DROP TABLE V7_LT_AUDIT;
IF $(vV7LTRows)<>35518 OR $(vV7LTUnique)<>35518 OR $(vV7LTLinkBad)<>0 OR $(vV7LTDimBad)<>0 THEN
 TRACE [VII] VERDICT=BLOCKED_FATO_CAPACIDADE;
 EXIT SCRIPT;
ENDIF
TRACE [VII] T17_T18_T19 LT_ROWS=$(vV7LTRows) LT_LINK_BAD=$(vV7LTLinkBad) LT_DIM_BAD=$(vV7LTDimBad);

// Approved in-memory POP projection. It must match VI-P1 _POP_EXPECT exactly.
// Original SKs are intentionally NOT exposed with associative field names.
FATO_POPULACAO:
NOCONCATENATE LOAD
 Hash128('SAD-LINK-V1','C=N',
 'Y=' & If(IsNull([%SK_TEMPO_ANO]),'N','V' & Len(Text([%SK_TEMPO_ANO])) & ':' & Text([%SK_TEMPO_ANO])),
 'R=' & If(IsNull([%SK_MUNICIPIO]),'N','V' & Len(Text([%SK_MUNICIPIO])) & ':' & Text([%SK_MUNICIPIO])),
 'S=' & If(IsNull([%SK_MUNICIPIO]),'N','V' & Len(Text([%SK_MUNICIPIO])) & ':' & Text([%SK_MUNICIPIO])),
 'E=N') AS [%LINK_KEY],
 POPULACAO_ESTIMADA,
 FATO_POP_IBGE7_ORIGEM, FATO_POP_DATASUS6_REFERENCIA_PB,
 FATO_POP_ANO_ORIGEM, FATO_POP_ARQUIVO_ORIGEM
FROM [__POP__] (qvd);
V7_POP_AUDIT:
NOCONCATENATE LOAD
 Count(*) AS _VII_ROWS,
 Count(DISTINCT [%LINK_KEY]) AS _VII_UNIQUE,
 Sum(If(IsNull([%LINK_KEY])
     OR ApplyMap('V7_MAP_LINK',[%LINK_KEY],0)<>1,1,0)) AS _VII_LINK_BAD
RESIDENT FATO_POPULACAO;
LET vV7POPRows=Peek('_VII_ROWS',0,'V7_POP_AUDIT');
LET vV7POPUnique=Peek('_VII_UNIQUE',0,'V7_POP_AUDIT');
LET vV7POPBad=Peek('_VII_LINK_BAD',0,'V7_POP_AUDIT');
DROP TABLE V7_POP_AUDIT;
IF $(vV7POPRows)<>669 OR $(vV7POPUnique)<>669 OR $(vV7POPBad)<>0 THEN
 TRACE [VII] VERDICT=BLOCKED_FATO_POPULACAO;
 EXIT SCRIPT;
ENDIF
TRACE [VII] T17_T18_T19 POP_ROWS=$(vV7POPRows) POP_LINK_BAD=$(vV7POPBad);

// Four role-playing aliases of ONE canonical DIM_TEMPO.qvd.
DIM_TEMPO_COMPETENCIA:
NOCONCATENATE LOAD DISTINCT
 [%SK_TEMPO_COMPETENCIA], TEMPO_COMPETENCIA AS PERIODO_COMPETENCIA
FROM [__TEMPO__] (qvd);
DIM_TEMPO_ANO:
NOCONCATENATE LOAD DISTINCT
 [%SK_TEMPO_ANO], TEMPO_ANO AS PERIODO_ANO
FROM [__TEMPO__] (qvd);
DIM_TEMPO_INTERNACAO:
NOCONCATENATE LOAD DISTINCT
 [%SK_TEMPO_DATA] AS [%SK_TEMPO_INTERNACAO],
 TEMPO_DATA AS DATA_INTERNACAO,
 TEMPO_DATA_YYYYMMDD AS DATA_INTERNACAO_YYYYMMDD
FROM [__TEMPO__] (qvd);
DIM_TEMPO_SAIDA:
NOCONCATENATE LOAD DISTINCT
 [%SK_TEMPO_DATA] AS [%SK_TEMPO_SAIDA],
 TEMPO_DATA AS DATA_SAIDA,
 TEMPO_DATA_YYYYMMDD AS DATA_SAIDA_YYYYMMDD
FROM [__TEMPO__] (qvd);

// Two role-playing aliases of ONE canonical DIM_MUNICIPIO.qvd.
DIM_MUNICIPIO_RESIDENCIA:
NOCONCATENATE LOAD
 [%SK_MUNICIPIO] AS [%SK_MUNICIPIO_RESIDENCIA],
 COD_DATASUS_6 AS RES_COD_DATASUS_6,
 COD_IBGE_7 AS RES_COD_IBGE_7,
 NOME_MUNICIPIO AS RES_NOME_MUNICIPIO,
 UF AS RES_UF,
 MUNICIPIO_COBERTURA AS RES_COBERTURA
FROM [__MUN__] (qvd);
DIM_MUNICIPIO_SERVICO:
NOCONCATENATE LOAD
 [%SK_MUNICIPIO] AS [%SK_MUNICIPIO_SERVICO],
 COD_DATASUS_6 AS SERV_COD_DATASUS_6,
 COD_IBGE_7 AS SERV_COD_IBGE_7,
 NOME_MUNICIPIO AS SERV_NOME_MUNICIPIO,
 UF AS SERV_UF,
 MUNICIPIO_COBERTURA AS SERV_COBERTURA
FROM [__MUN__] (qvd);

// Shared historical dimension linked ONLY to the Link Table.
DIM_ESTABELECIMENTO:
NOCONCATENATE LOAD
 [%SK_ESTABELECIMENTO],
 CNES AS ESTAB_CNES,
 COMPETENCIA AS ESTAB_COMPETENCIA,
 CODUFMUN AS ESTAB_CODUFMUN,
 TP_UNID AS ESTAB_TP_UNID,
 TPGESTAO AS ESTAB_TPGESTAO,
 VINC_SUS AS ESTAB_VINC_SUS,
 NAT_JUR AS ESTAB_NAT_JUR,
 NOME_HISTORICO_STATUS AS ESTAB_NOME_HISTORICO_STATUS
FROM [__EST__] (qvd);

// Exclusive dimension roles: never create an additional cross-fact association.
DIM_PROCEDIMENTO:
NOCONCATENATE LOAD
 [%SK_PROCEDIMENTO], COD_PROCEDIMENTO,
 COMPETENCIA_REFERENCIA AS PROC_COMPETENCIA_REFERENCIA,
 NOME_PROCEDIMENTO, NO_GRUPO AS PROC_NOME_GRUPO,
 NO_SUB_GRUPO AS PROC_NOME_SUBGRUPO
FROM [__PROC__] (qvd);
DIM_DIAGNOSTICO:
NOCONCATENATE LOAD
 [%SK_DIAGNOSTICO], COD_DIAGNOSTICO,
 DESCRICAO_OFICIAL_DIAGNOSTICO, CID10_REFERENCIA_COMPETENCIA
FROM [__DIAG__] (qvd);
DIM_CARATER_ATENDIMENTO:
NOCONCATENATE LOAD
 [%SK_CARATER_ATENDIMENTO], COD_CARATER_ATENDIMENTO,
 DESCRICAO_OFICIAL_CARATER_ATENDIMENTO
FROM [__CAR__] (qvd);
DIM_MOTIVO_SAIDA_PERMANENCIA:
NOCONCATENATE LOAD
 [%SK_MOTIVO_SAIDA], COD_MOTIVO_SAIDA_FONTE,
 DESCRICAO_OFICIAL_MOTIVO_SAIDA, CATEGORIA_ENCERRAMENTO
FROM [__MOT__] (qvd);
DIM_TIPO_LEITO:
NOCONCATENATE LOAD
 [%SK_TIPO_LEITO], COD_TIPO_LEITO, COD_LEITO,
 COMPETENCIA_OBSERVACAO_LEITO
FROM [__BED__] (qvd);

// Exactly 3 facts + 1 link + 12 dimension aliases = 16 tables.
LET vV7Tables=NoOfTables();
LET vV7Syn=0;
FOR vV7I=0 TO $(vV7Tables)-1
 LET vV7Name=TableName($(vV7I));
 IF SubStringCount('$(vV7Name)','$Syn')>0 THEN
  LET vV7Syn=$(vV7Syn)+1;
 ENDIF
NEXT
TRACE [VII] MODEL_TABLES=$(vV7Tables) SYN_TABLES=$(vV7Syn);
IF ScriptErrorCount>$(vV7Errors) OR $(vV7Tables)<>16 OR $(vV7Syn)<>0
 OR NoOfRows('LINK_ANALISE')<>85705
 OR NoOfRows('FATO_INTERNACAO')<>566672
 OR NoOfRows('FATO_CAPACIDADE_LEITO')<>35518
 OR NoOfRows('FATO_POPULACAO')<>669 THEN
 TRACE [VII] VERDICT=BLOCKED_MODEL_STRUCTURE;
 EXIT SCRIPT;
ENDIF
TRACE [VII] VERDICT=PASS_SCRIPT_ASSOCIATIVE_CANDIDATE_ONLY;
TRACE [VII] T17_T18_T19_T20_T22_T23=SCRIPT_CHECKED T21=LOG_AND_TABLE_VIEWER_PENDING;
TRACE [VII] LINK_KEY_CONTRACT=NOT_APPROVED MEASURES_AND_DENOMINATOR_CONTRACT=NOT_APPROVED;
TRACE [VII] TABLE_VIEWER_REVIEW=PENDING PRODUCTION_APPROVED=False;
