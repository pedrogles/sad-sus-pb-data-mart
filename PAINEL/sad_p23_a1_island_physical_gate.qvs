// SAD-P2.3-A1-PHYSICAL-GATE-01 | isolated P2.3 observability projection.
// Companion to PAINEL/phase_vii_technical_model.qvs in a disposable QVW ONLY.
// Reuses VI-P4 observation/grade logic; no STORE or mutation of source files.
// All persisted columns are unique P23_* aliases. No %LINK_KEY / shared SK.
// ZERO_REAL_COMPROVADO=NOT_PROVEN; COBERTURA_HOSPITALAR=NOT_VERIFIED.
// Never interpret an absent LT row as a proven zero or hospital completeness.
SET ErrorMode=1;
LET vP23StartErrors=ScriptErrorCount;
TRACE [P23A1] START=ISLAND_MONTHLY_OBSERVABILITY_CANDIDATE_ONLY;

// Row-level LT/fact reconciliation, as established by VI-P4.
P23_FACT_REF:
NOCONCATENATE LOAD
 SK_REGISTRO_CAPACIDADE_LEITO AS P23_FACT_ID,
 QTD_LEITOS_SUS AS P23_FACT_SUS,
 QTD_LEITOS_EXISTENTES AS P23_FACT_EXIST,
 QTD_LEITOS_NAO_SUS AS P23_FACT_NSUS
FROM [__P23_FACT__] (qvd);
P23_FACT_MATCH_MAP: MAPPING LOAD P23_FACT_ID, 1 RESIDENT P23_FACT_REF;
P23_FACT_SUS_MAP: MAPPING LOAD P23_FACT_ID, P23_FACT_SUS RESIDENT P23_FACT_REF;
P23_FACT_EXIST_MAP: MAPPING LOAD P23_FACT_ID, P23_FACT_EXIST RESIDENT P23_FACT_REF;
P23_FACT_NSUS_MAP: MAPPING LOAD P23_FACT_ID, P23_FACT_NSUS RESIDENT P23_FACT_REF;

P23_POP_SOURCE:
NOCONCATENATE LOAD
 Trim(Text(FATO_POP_DATASUS6_REFERENCIA_PB)) AS P23_POP_MUN,
 Trim(Text(FATO_POP_ANO_ORIGEM)) AS P23_POP_YEAR
FROM [__P23_POP__] (qvd);
P23_POP_AUDIT:
NOCONCATENATE LOAD
 Count(*) AS P23_POP_ROWS,
 Count(DISTINCT P23_POP_MUN) AS P23_POP_MUNS,
 Count(DISTINCT P23_POP_MUN & '|' & P23_POP_YEAR) AS P23_POP_PAIRS
RESIDENT P23_POP_SOURCE;
LET vP23PopRows=Peek('P23_POP_ROWS',0,'P23_POP_AUDIT');
LET vP23PopMuns=Peek('P23_POP_MUNS',0,'P23_POP_AUDIT');
LET vP23PopPairs=Peek('P23_POP_PAIRS',0,'P23_POP_AUDIT');
DROP TABLE P23_POP_AUDIT;
IF ScriptErrorCount>$(vP23StartErrors) OR $(vP23PopRows)<>669 OR $(vP23PopMuns)<>223 OR $(vP23PopPairs)<>669 THEN
 TRACE [P23A1] VERDICT=BLOCKED_POP_UNIVERSE;
 EXIT SCRIPT;
ENDIF
P23_POP_MAP: MAPPING LOAD DISTINCT P23_POP_MUN,1 RESIDENT P23_POP_SOURCE;
P23_MUN_LIST:
NOCONCATENATE LOAD DISTINCT P23_POP_MUN AS P23_STAGE_MUN RESIDENT P23_POP_SOURCE;
DROP TABLE P23_POP_SOURCE;

P23_LT_SOURCE:
NOCONCATENATE LOAD
 Trim(Text(CODUFMUN)) AS P23_LT_MUN,
 Trim(Text(COMPETEN)) AS P23_LT_COMP,
 Trim(Text(_META_SOURCE_COMPETENCE)) AS P23_LT_SOURCE_COMP,
 Hash128('LT',Trim(Text(CNES)),Text(COMPETEN),Text(CODLEITO)) AS P23_LT_ID,
 QT_SUS AS P23_LT_SUS,
 QT_EXIST AS P23_LT_EXIST,
 QT_NSUS AS P23_LT_NSUS,
 ApplyMap('P23_FACT_MATCH_MAP',Hash128('LT',Trim(Text(CNES)),Text(COMPETEN),Text(CODLEITO)),0) AS P23_FACT_MATCH,
 ApplyMap('P23_FACT_SUS_MAP',Hash128('LT',Trim(Text(CNES)),Text(COMPETEN),Text(CODLEITO)),-1) AS P23_FACT_SUS_MATCH,
 ApplyMap('P23_FACT_EXIST_MAP',Hash128('LT',Trim(Text(CNES)),Text(COMPETEN),Text(CODLEITO)),-1) AS P23_FACT_EXIST_MATCH,
 ApplyMap('P23_FACT_NSUS_MAP',Hash128('LT',Trim(Text(CNES)),Text(COMPETEN),Text(CODLEITO)),-1) AS P23_FACT_NSUS_MATCH,
 ApplyMap('P23_POP_MAP',Trim(Text(CODUFMUN)),0) AS P23_IS_PB_MUN
FROM [__P23_LT__] (qvd);
P23_LT_AUDIT:
NOCONCATENATE LOAD
 Count(*) AS P23_ST_ROWS,
 Count(DISTINCT P23_LT_ID) AS P23_ST_UNIQUE,
 Count(DISTINCT P23_LT_COMP) AS P23_ST_MONTHS,
 Sum(P23_LT_SUS) AS P23_ST_SUS,
 Sum(P23_LT_EXIST) AS P23_ST_EXIST,
 Sum(P23_LT_NSUS) AS P23_ST_NSUS,
 Sum(If(P23_IS_PB_MUN<>1 OR P23_FACT_MATCH<>1
    OR P23_LT_SOURCE_COMP<>P23_LT_COMP
    OR NOT IsNum(P23_LT_SUS) OR NOT IsNum(P23_LT_EXIST) OR NOT IsNum(P23_LT_NSUS)
    OR P23_LT_SUS<0 OR P23_LT_EXIST<0 OR P23_LT_NSUS<0
    OR P23_LT_SUS>P23_LT_EXIST OR P23_LT_EXIST<>P23_LT_SUS+P23_LT_NSUS
    OR P23_LT_SUS<>P23_FACT_SUS_MATCH
    OR P23_LT_EXIST<>P23_FACT_EXIST_MATCH
    OR P23_LT_NSUS<>P23_FACT_NSUS_MATCH,1,0)) AS P23_ST_BAD
RESIDENT P23_LT_SOURCE;
LET vP23StRows=Peek('P23_ST_ROWS',0,'P23_LT_AUDIT');
LET vP23StUnique=Peek('P23_ST_UNIQUE',0,'P23_LT_AUDIT');
LET vP23StMonths=Peek('P23_ST_MONTHS',0,'P23_LT_AUDIT');
LET vP23StSus=Peek('P23_ST_SUS',0,'P23_LT_AUDIT');
LET vP23StExist=Peek('P23_ST_EXIST',0,'P23_LT_AUDIT');
LET vP23StNsus=Peek('P23_ST_NSUS',0,'P23_LT_AUDIT');
LET vP23StBad=Peek('P23_ST_BAD',0,'P23_LT_AUDIT');
DROP TABLE P23_LT_AUDIT;
IF ScriptErrorCount>$(vP23StartErrors) OR $(vP23StRows)<>35518 OR $(vP23StUnique)<>35518 OR $(vP23StMonths)<>36 OR $(vP23StSus)<>270076 OR $(vP23StExist)<>337147 OR $(vP23StNsus)<>67071 OR $(vP23StBad)<>0 THEN TRACE [P23A1] VERDICT=BLOCKED_LT_FACT_RECONCILIATION;
 EXIT SCRIPT;
ENDIF
DROP TABLE P23_FACT_REF;

// Aggregate observed records on the validated municipal/service monthly axis.
P23_OBS_MONTHLY:
NOCONCATENATE LOAD
 P23_LT_MUN AS P23_STAGE_MUN,
 P23_LT_COMP AS P23_STAGE_COMP,
 Hash128('P4-OBS',Trim(Text(P23_LT_MUN)),Trim(Text(P23_LT_COMP))) AS P23_PAIR_KEY_TMP,
 Count(*) AS P23_LINES_TMP,
 Sum(P23_LT_SUS) AS P23_SUS_TMP,
 Sum(P23_LT_EXIST) AS P23_EXIST_TMP
RESIDENT P23_LT_SOURCE GROUP BY P23_LT_MUN,P23_LT_COMP;
DROP TABLE P23_LT_SOURCE;

// Full cross product; never derive absence from an associative filter.
P23_MONTH_LIST:
NOCONCATENATE LOAD Text(Date(AddMonths(MakeDate(2017,1,1),RecNo()-1),'YYYYMM')) AS P23_STAGE_COMP
AUTOGENERATE 36;
P23_GRID:
NOCONCATENATE LOAD P23_STAGE_MUN RESIDENT P23_MUN_LIST;
JOIN (P23_GRID)
LOAD P23_STAGE_COMP RESIDENT P23_MONTH_LIST;
DROP TABLE P23_MUN_LIST;
DROP TABLE P23_MONTH_LIST;
IF ScriptErrorCount>$(vP23StartErrors) OR NoOfRows('P23_GRID')<>8028 THEN
 TRACE [P23A1] VERDICT=BLOCKED_GRID_SIZE;
 EXIT SCRIPT;
ENDIF

P23_GRID_KEYED:
NOCONCATENATE LOAD
 P23_STAGE_MUN,
 P23_STAGE_COMP,
 Hash128('P4-OBS',Trim(Text(P23_STAGE_MUN)),Trim(Text(P23_STAGE_COMP))) AS P23_PAIR_KEY_TMP
RESIDENT P23_GRID;
DROP TABLE P23_GRID;
RENAME TABLE P23_GRID_KEYED TO P23_GRID;
P23_GRID_MUN_MAP: MAPPING LOAD DISTINCT P23_STAGE_MUN,1 RESIDENT P23_GRID;
P23_GRID_COMP_MAP: MAPPING LOAD DISTINCT Hash128('P4-COMP',Trim(Text(P23_STAGE_COMP))),1 RESIDENT P23_GRID;
P23_GRID_PAIR_MAP: MAPPING LOAD P23_PAIR_KEY_TMP,1 RESIDENT P23_GRID;
P23_PREJOIN_AUDIT:
NOCONCATENATE LOAD
 Count(*) AS P23_OBS_PAIRS,
 Count(DISTINCT P23_PAIR_KEY_TMP) AS P23_OBS_UNIQUE,
 Sum(If(ApplyMap('P23_GRID_MUN_MAP',P23_STAGE_MUN,0)=1,1,0)) AS P23_MUN_MATCHES,
 Sum(If(ApplyMap('P23_GRID_COMP_MAP',Hash128('P4-COMP',Trim(Text(P23_STAGE_COMP))),0)=1,1,0)) AS P23_COMP_MATCHES,
 Sum(If(ApplyMap('P23_GRID_PAIR_MAP',P23_PAIR_KEY_TMP,0)=1,1,0)) AS P23_PAIR_MATCHES
RESIDENT P23_OBS_MONTHLY;
LET vP23ObsPairs=Peek('P23_OBS_PAIRS',0,'P23_PREJOIN_AUDIT');
LET vP23ObsUnique=Peek('P23_OBS_UNIQUE',0,'P23_PREJOIN_AUDIT');
LET vP23MunMatches=Peek('P23_MUN_MATCHES',0,'P23_PREJOIN_AUDIT');
LET vP23CompMatches=Peek('P23_COMP_MATCHES',0,'P23_PREJOIN_AUDIT');
LET vP23PairMatches=Peek('P23_PAIR_MATCHES',0,'P23_PREJOIN_AUDIT');
DROP TABLE P23_PREJOIN_AUDIT;
IF ScriptErrorCount>$(vP23StartErrors) OR $(vP23ObsPairs)<>3561 OR $(vP23ObsUnique)<>3561 OR $(vP23MunMatches)<>3561 OR $(vP23CompMatches)<>3561 OR $(vP23PairMatches)<>3561 THEN TRACE [P23A1] VERDICT=BLOCKED_PREJOIN_AXES_OR_PAIR;
 EXIT SCRIPT;
ENDIF

LEFT JOIN (P23_GRID)
LOAD P23_PAIR_KEY_TMP,P23_LINES_TMP,P23_SUS_TMP,P23_EXIST_TMP
RESIDENT P23_OBS_MONTHLY;
DROP TABLE P23_OBS_MONTHLY;

// Exactly six final fields; no shared keys, roles or temporal field names.
P23_A1_ISLAND:
NOCONCATENATE LOAD
 Text(P23_STAGE_MUN) AS P23_MUNICIPIO_6,
 Text(P23_STAGE_COMP) AS P23_COMPETENCIA,
 If(IsNull(P23_LINES_TMP),Null(),P23_LINES_TMP) AS P23_LINHAS_LT,
 If(IsNull(P23_SUS_TMP),Null(),P23_SUS_TMP) AS P23_QT_SUS_OBSERVADO,
 If(IsNull(P23_EXIST_TMP),Null(),P23_EXIST_TMP) AS P23_QT_EXIST_OBSERVADO,
 If(IsNull(P23_LINES_TMP),'ABSENT_NOT_ZERO_PROVEN',
    If(P23_SUS_TMP=0,'OBSERVED_ZERO_QT_SUS_SCOPE_UNVERIFIED',
       'OBSERVED_POSITIVE_QT_SUS_SCOPE_UNVERIFIED')) AS P23_ESTADO_OBSERVADO
RESIDENT P23_GRID;
DROP TABLE P23_GRID;

P23_FINAL_AUDIT:
NOCONCATENATE LOAD
 Count(*) AS P23_TOTAL,
 Count(DISTINCT P23_MUNICIPIO_6) AS P23_MUNS,
 Count(DISTINCT P23_COMPETENCIA) AS P23_COMPS,
 Count(DISTINCT P23_MUNICIPIO_6 & '|' & P23_COMPETENCIA) AS P23_UNIQUE_PAIRS,
 Sum(If(P23_ESTADO_OBSERVADO='ABSENT_NOT_ZERO_PROVEN',1,0)) AS P23_ABSENT,
 Sum(If(P23_ESTADO_OBSERVADO='OBSERVED_ZERO_QT_SUS_SCOPE_UNVERIFIED',1,0)) AS P23_ZERO,
 Sum(If(P23_ESTADO_OBSERVADO='OBSERVED_POSITIVE_QT_SUS_SCOPE_UNVERIFIED',1,0)) AS P23_POSITIVE,
 Sum(If(P23_ESTADO_OBSERVADO='ABSENT_NOT_ZERO_PROVEN'
      AND (NOT IsNull(P23_LINHAS_LT) OR NOT IsNull(P23_QT_SUS_OBSERVADO)
      OR NOT IsNull(P23_QT_EXIST_OBSERVADO)),1,0)) AS P23_BAD_NULL,
 Sum(If(NOT IsNull(P23_LINHAS_LT),1,0)) AS P23_PRESENT_PAIRS,
 Sum(If(NOT IsNull(P23_LINHAS_LT),P23_LINHAS_LT,0)) AS P23_ROWS,
 Sum(If(NOT IsNull(P23_QT_SUS_OBSERVADO),P23_QT_SUS_OBSERVADO,0)) AS P23_SUS_TOTAL,
 Sum(If(NOT IsNull(P23_QT_EXIST_OBSERVADO),P23_QT_EXIST_OBSERVADO,0)) AS P23_EXIST_TOTAL
RESIDENT P23_A1_ISLAND;
LET vP23Total=Peek('P23_TOTAL',0,'P23_FINAL_AUDIT');
LET vP23Muns=Peek('P23_MUNS',0,'P23_FINAL_AUDIT');
LET vP23Comps=Peek('P23_COMPS',0,'P23_FINAL_AUDIT');
LET vP23Unique=Peek('P23_UNIQUE_PAIRS',0,'P23_FINAL_AUDIT');
LET vP23Absent=Peek('P23_ABSENT',0,'P23_FINAL_AUDIT');
LET vP23Zero=Peek('P23_ZERO',0,'P23_FINAL_AUDIT');
LET vP23Positive=Peek('P23_POSITIVE',0,'P23_FINAL_AUDIT');
LET vP23BadNull=Peek('P23_BAD_NULL',0,'P23_FINAL_AUDIT');
LET vP23Present=Peek('P23_PRESENT_PAIRS',0,'P23_FINAL_AUDIT');
LET vP23Rows=Peek('P23_ROWS',0,'P23_FINAL_AUDIT');
LET vP23Sus=Peek('P23_SUS_TOTAL',0,'P23_FINAL_AUDIT');
LET vP23Exist=Peek('P23_EXIST_TOTAL',0,'P23_FINAL_AUDIT');
DROP TABLE P23_FINAL_AUDIT;
TRACE [P23A1] TOTAL=$(vP23Total) MUNICIPIOS=$(vP23Muns) MONTHS=$(vP23Comps) ABSENT=$(vP23Absent) ZERO_SUS=$(vP23Zero) POSITIVE_SUS=$(vP23Positive) LT_ROWS=$(vP23Rows) SUS_SNAPSHOT_SUM=$(vP23Sus) EXIST_SNAPSHOT_SUM=$(vP23Exist);
IF ScriptErrorCount>$(vP23StartErrors) OR $(vP23Total)<>8028 OR $(vP23Muns)<>223 OR $(vP23Comps)<>36 OR $(vP23Unique)<>8028 OR $(vP23Absent)<>4467 OR $(vP23Zero)<>97 OR $(vP23Positive)<>3464 OR $(vP23Present)<>3561 OR $(vP23Rows)<>35518 OR $(vP23Sus)<>270076 OR $(vP23Exist)<>337147 OR $(vP23BadNull)<>0 THEN TRACE [P23A1] VERDICT=BLOCKED_FINAL_ORACLE;
 EXIT SCRIPT;
ENDIF

LET vP23Tables=NoOfTables();
LET vP23Syn=0;
FOR vP23I=0 TO $(vP23Tables)-1
 LET vP23Name=TableName($(vP23I));
 IF SubStringCount('$(vP23Name)','$Syn')>0 THEN
  LET vP23Syn=$(vP23Syn)+1;
 ENDIF
NEXT
IF $(vP23Tables)<>17 OR $(vP23Syn)<>0 THEN
 TRACE [P23A1] VERDICT=BLOCKED_ASSOCIATIVE_MODEL;
 EXIT SCRIPT;
ENDIF
TRACE [P23A1] MODEL_TABLES=$(vP23Tables) SYN_TABLES=$(vP23Syn);
TRACE [P23A1] VERDICT=PASS_SCRIPT_CANDIDATE_ONLY;
TRACE [P23A1] ZERO_REAL_COMPROVADO=NOT_PROVEN COBERTURA_HOSPITALAR=NOT_VERIFIED;
TRACE [P23A1] VISUAL_ACCEPTED=False PHASE_IX=NOT_AUTHORIZED PRODUCTION_APPROVED=False;
