// Boundary 8 — QlikView local smoke test
// Create a temporary READINESS.qvw in this same directory and use only:
// $(Must_Include=readiness_smoke.qvs);

SET ErrorMode=0;

LET vReadinessErrorsBefore = ScriptErrorCount;

// 1) Validate that CSV generated by the DBC smoke is readable.
READINESS_CSV:
LOAD *
FROM [..\BASE\CONVERTIDA\readiness-smoke\RDPB1702.csv]
(txt, utf8, embedded labels, delimiter is ';', msq);

IF ScriptErrorCount > $(vReadinessErrorsBefore) THEN
    TRACE [READINESS] CSV LOAD failed. Errors=$(ScriptErrorList);
    EXIT SCRIPT;
ENDIF

LET vReadinessCsvRows = NoOfRows('READINESS_CSV');

IF $(vReadinessCsvRows) <> 13912 THEN
    TRACE [READINESS] CSV row count mismatch. Expected=13912 Actual=$(vReadinessCsvRows);
    EXIT SCRIPT;
ENDIF

// 2) Validate basic in-memory LOAD + QVD STORE.
READINESS_SMOKE:
LOAD * INLINE [
ID, VALUE
1, OK
];

IF ScriptErrorCount > $(vReadinessErrorsBefore) THEN
    TRACE [READINESS] Inline LOAD failed. Errors=$(ScriptErrorList);
    EXIT SCRIPT;
ENDIF

STORE READINESS_SMOKE INTO [readiness_smoke.qvd] (qvd);

IF ScriptErrorCount > $(vReadinessErrorsBefore) THEN
    TRACE [READINESS] QVD STORE failed. Errors=$(ScriptErrorList);
    EXIT SCRIPT;
ENDIF

// 3) Emit success marker only after all critical checks pass.
READINESS_SUCCESS:
LOAD
    Timestamp(Now(1)) AS generated_at,
    'READINESS_SMOKE' AS stage,
    'PASS' AS status,
    $(vReadinessCsvRows) AS csv_rows
AUTOGENERATE 1;

STORE READINESS_SUCCESS INTO [readiness_smoke_success.csv]
(txt, utf8, delimiter is ';', embedded labels);

IF ScriptErrorCount > $(vReadinessErrorsBefore) THEN
    TRACE [READINESS] Success marker failed. Errors=$(ScriptErrorList);
    EXIT SCRIPT;
ENDIF

TRACE [READINESS] PASS CSV_ROWS=$(vReadinessCsvRows);

DROP TABLE READINESS_SUCCESS;
DROP TABLE READINESS_SMOKE;
DROP TABLE READINESS_CSV;
