// FASE V — independent QlikView 12 physical QVD readback.
// A separate isolated QVW loads ONLY the persisted fact QVD (never source LT).
// Does not STORE, classify historic hospitals, or approve LINK_ANALISE.
SET ErrorMode=0;
LET vP5CapAuditStartErrors=ScriptErrorCount;
TRACE [V5-CAP-QVD-AUDIT] START_INDEPENDENT_QVD_REOPEN;
P5CAP_AUDIT_FACT:
NOCONCATENATE LOAD *
FROM [QVD\FATO_CAPACIDADE_LEITO.qvd] (qvd);
IF ScriptErrorCount > $(vP5CapAuditStartErrors) THEN
    TRACE [V5-CAP-QVD-AUDIT] VERDICT=BLOCKED_QVD_LOAD;
    EXIT SCRIPT;
ENDIF
LET vP5CapAuditRows=NoOfRows('P5CAP_AUDIT_FACT');
LET vP5CapAuditFields=NoOfFields('P5CAP_AUDIT_FACT');
TRACE [V5-CAP-QVD-AUDIT] HEADER ROWS=$(vP5CapAuditRows) FIELDS=$(vP5CapAuditFields);
IF $(vP5CapAuditRows)<>35518 OR $(vP5CapAuditFields)<>11 THEN
    TRACE [V5-CAP-QVD-AUDIT] VERDICT=BLOCKED_HEADER;
    EXIT SCRIPT;
ENDIF

// Independently enumerate schema name AND column ordering of persisted QVD.
P5CAP_AUDIT_SCHEMA:
NOCONCATENATE LOAD * INLINE [
FIELD
SK_REGISTRO_CAPACIDADE_LEITO
%LINK_KEY
%SK_TIPO_LEITO
QTD_LEITOS_EXISTENTES
QTD_LEITOS_SUS
QTD_LEITOS_NAO_SUS
FATO_LT_CNES_ORIGEM
FATO_LT_CODLEITO_ORIGEM
FATO_LT_TIPO_TEXTO_STAGING
FATO_LT_COMPETENCIA_ORIGEM
FATO_LT_ARQUIVO_ORIGEM
];
FOR vP5CapAuditIndex=0 TO 10
    LET vP5CapAuditPosition=$(vP5CapAuditIndex)+1;
    LET vP5CapAuditActual=FieldName($(vP5CapAuditPosition),'P5CAP_AUDIT_FACT');
    LET vP5CapAuditExpected=Peek('FIELD',$(vP5CapAuditIndex),'P5CAP_AUDIT_SCHEMA');
    IF '$(vP5CapAuditActual)' <> '$(vP5CapAuditExpected)' THEN
        TRACE [V5-CAP-QVD-AUDIT] VERDICT=BLOCKED_FIELD_ORDER POSITION=$(vP5CapAuditPosition) ACTUAL=$(vP5CapAuditActual) EXPECTED=$(vP5CapAuditExpected);
        EXIT SCRIPT;
    ENDIF
NEXT
DROP TABLE P5CAP_AUDIT_SCHEMA;
TRACE [V5-CAP-QVD-AUDIT] SCHEMA_EXACT_11=True;

// Readback MUST not trust in-memory SOURCE totals. Re-evaluate each persisted
// row's natural grain SK, A2 bed SK, domain, measures and provenance.
P5CAP_AUDIT_PROFILE:
NOCONCATENATE LOAD
    Count(*) AS _A_ROWS,
    Count(DISTINCT SK_REGISTRO_CAPACIDADE_LEITO) AS _A_UNIQUE,
    Count(DISTINCT [%LINK_KEY]) AS _A_LINKS,
    Count(DISTINCT FATO_LT_COMPETENCIA_ORIGEM) AS _A_MONTHS,
    Count(DISTINCT FATO_LT_ARQUIVO_ORIGEM) AS _A_FILES,
    Count(DISTINCT Left(Text(FATO_LT_TIPO_TEXTO_STAGING),1) & '|' & Text(FATO_LT_CODLEITO_ORIGEM)) AS _A_PAIRS,
    Count(DISTINCT Left(Text(FATO_LT_TIPO_TEXTO_STAGING),1) & '|' & Text(FATO_LT_CODLEITO_ORIGEM) & '|' & Text(FATO_LT_COMPETENCIA_ORIGEM)) AS _A_PAIR_MONTHS,
    Sum(If(Left(Text(FATO_LT_TIPO_TEXTO_STAGING),1)='3' AND Text(FATO_LT_CODLEITO_ORIGEM)='66',1,0)) AS _A_3_66,
    Sum(If(Left(Text(FATO_LT_TIPO_TEXTO_STAGING),1)='7' AND Text(FATO_LT_CODLEITO_ORIGEM)='70',1,0)) AS _A_7_70,
    Sum(If(IsNull(SK_REGISTRO_CAPACIDADE_LEITO) OR IsNull([%LINK_KEY])
        OR IsNull([%SK_TIPO_LEITO]) OR IsNull(QTD_LEITOS_EXISTENTES)
        OR IsNull(QTD_LEITOS_SUS) OR IsNull(QTD_LEITOS_NAO_SUS)
        OR IsNull(FATO_LT_CNES_ORIGEM) OR IsNull(FATO_LT_CODLEITO_ORIGEM)
        OR IsNull(FATO_LT_TIPO_TEXTO_STAGING)
        OR IsNull(FATO_LT_COMPETENCIA_ORIGEM)
        OR IsNull(FATO_LT_ARQUIVO_ORIGEM),1,0)) AS _A_NULL,
    Sum(If(SK_REGISTRO_CAPACIDADE_LEITO <> Hash128('LT',
            Trim(Text(FATO_LT_CNES_ORIGEM)),
            Text(FATO_LT_COMPETENCIA_ORIGEM),
            Text(FATO_LT_CODLEITO_ORIGEM))
        OR [%SK_TIPO_LEITO] <> Hash128('LEITO',
            Left(Text(FATO_LT_TIPO_TEXTO_STAGING),1),
            Text(FATO_LT_CODLEITO_ORIGEM),
            Text(FATO_LT_COMPETENCIA_ORIGEM)),1,0)) AS _A_SK_MISMATCH,
    Sum(If(IsNull(FATO_LT_CNES_ORIGEM) OR Len(Trim(Text(FATO_LT_CNES_ORIGEM)))=0
        OR IsNull(FATO_LT_COMPETENCIA_ORIGEM)
        OR Len(Text(FATO_LT_COMPETENCIA_ORIGEM))<>6
        OR Len(KeepChar(Text(FATO_LT_COMPETENCIA_ORIGEM),'0123456789'))<>6
        OR Text(FATO_LT_COMPETENCIA_ORIGEM)<'201701'
        OR Text(FATO_LT_COMPETENCIA_ORIGEM)>'201912'
        OR IsNull(FATO_LT_CODLEITO_ORIGEM)
        OR Len(Text(FATO_LT_CODLEITO_ORIGEM))<>2
        OR Len(KeepChar(Text(FATO_LT_CODLEITO_ORIGEM),'0123456789'))<>2
        OR IsNull(FATO_LT_TIPO_TEXTO_STAGING)
        OR Match(Left(Text(FATO_LT_TIPO_TEXTO_STAGING),1),'1','2','3','4','5','6','7')=0
        OR (Len(Text(FATO_LT_TIPO_TEXTO_STAGING))<>1
            AND (Len(Text(FATO_LT_TIPO_TEXTO_STAGING))<>2
                 OR Right(Text(FATO_LT_TIPO_TEXTO_STAGING),1)<>' '))
        OR IsNull(FATO_LT_ARQUIVO_ORIGEM)
        OR Len(Trim(Text(FATO_LT_ARQUIVO_ORIGEM)))=0,1,0)) AS _A_BAD_DOMAIN,
    Sum(QTD_LEITOS_EXISTENTES) AS _A_EXIST,
    Sum(QTD_LEITOS_SUS) AS _A_SUS,
    Sum(QTD_LEITOS_NAO_SUS) AS _A_NSUS,
    Sum(If(NOT IsNum(QTD_LEITOS_EXISTENTES)
        OR NOT IsNum(QTD_LEITOS_SUS)
        OR NOT IsNum(QTD_LEITOS_NAO_SUS)
        OR QTD_LEITOS_EXISTENTES<0 OR QTD_LEITOS_SUS<0 OR QTD_LEITOS_NAO_SUS<0
        OR QTD_LEITOS_EXISTENTES<>Round(QTD_LEITOS_EXISTENTES,1)
        OR QTD_LEITOS_SUS<>Round(QTD_LEITOS_SUS,1)
        OR QTD_LEITOS_NAO_SUS<>Round(QTD_LEITOS_NAO_SUS,1)
        OR QTD_LEITOS_SUS>QTD_LEITOS_EXISTENTES
        OR QTD_LEITOS_NAO_SUS<>QTD_LEITOS_EXISTENTES-QTD_LEITOS_SUS,1,0)) AS _A_INVALID
RESIDENT P5CAP_AUDIT_FACT;
LET vP5CARows=Peek('_A_ROWS',0,'P5CAP_AUDIT_PROFILE');
LET vP5CAUnique=Peek('_A_UNIQUE',0,'P5CAP_AUDIT_PROFILE');
LET vP5CALinks=Peek('_A_LINKS',0,'P5CAP_AUDIT_PROFILE');
LET vP5CAMonths=Peek('_A_MONTHS',0,'P5CAP_AUDIT_PROFILE');
LET vP5CAFiles=Peek('_A_FILES',0,'P5CAP_AUDIT_PROFILE');
LET vP5CAPairs=Peek('_A_PAIRS',0,'P5CAP_AUDIT_PROFILE');
LET vP5CAPairMonths=Peek('_A_PAIR_MONTHS',0,'P5CAP_AUDIT_PROFILE');
LET vP5CA366=Peek('_A_3_66',0,'P5CAP_AUDIT_PROFILE');
LET vP5CA770=Peek('_A_7_70',0,'P5CAP_AUDIT_PROFILE');
LET vP5CANull=Peek('_A_NULL',0,'P5CAP_AUDIT_PROFILE');
LET vP5CASKMismatch=Peek('_A_SK_MISMATCH',0,'P5CAP_AUDIT_PROFILE');
LET vP5CABadDomain=Peek('_A_BAD_DOMAIN',0,'P5CAP_AUDIT_PROFILE');
LET vP5CAExist=Peek('_A_EXIST',0,'P5CAP_AUDIT_PROFILE');
LET vP5CASus=Peek('_A_SUS',0,'P5CAP_AUDIT_PROFILE');
LET vP5CANsus=Peek('_A_NSUS',0,'P5CAP_AUDIT_PROFILE');
LET vP5CAInvalid=Peek('_A_INVALID',0,'P5CAP_AUDIT_PROFILE');
DROP TABLE P5CAP_AUDIT_PROFILE;
TRACE [V5-CAP-QVD-AUDIT] TOTAL ROWS=$(vP5CARows) UNIQUE=$(vP5CAUnique) LINKS=$(vP5CALinks) MONTHS=$(vP5CAMonths) FILES=$(vP5CAFiles) PAIRS=$(vP5CAPairs) PAIR_MONTHS=$(vP5CAPairMonths) TYPE3_BED66=$(vP5CA366) TYPE7_BED70=$(vP5CA770) NULL=$(vP5CANull) SK_MISMATCH=$(vP5CASKMismatch) DOMAIN_BAD=$(vP5CABadDomain) EXIST=$(vP5CAExist) SUS=$(vP5CASus) NSUS=$(vP5CANsus) INVALID=$(vP5CAInvalid);
IF ScriptErrorCount > $(vP5CapAuditStartErrors) OR $(vP5CARows)<>35518 OR $(vP5CAUnique)<>35518 OR $(vP5CALinks)<>7486 OR $(vP5CAMonths)<>36 OR $(vP5CAFiles)<>36 OR $(vP5CAPairs)<>57 OR $(vP5CAPairMonths)<>2021 OR $(vP5CA366)<>1480 OR $(vP5CA770)<>5 OR $(vP5CANull)<>0 OR $(vP5CASKMismatch)<>0 OR $(vP5CABadDomain)<>0 OR $(vP5CAExist)<>337147 OR $(vP5CASus)<>270076 OR $(vP5CANsus)<>67071 OR $(vP5CAInvalid)<>0 THEN
    TRACE [V5-CAP-QVD-AUDIT] VERDICT=BLOCKED_PERSISTED_DATA_RECONCILIATION;
    EXIT SCRIPT;
ENDIF

P5CAP_AUDIT_YEAR:
NOCONCATENATE LOAD
    Left(Text(FATO_LT_COMPETENCIA_ORIGEM),4) AS _A_YEAR,
    Count(*) AS _A_Y_ROWS,
    Count(DISTINCT FATO_LT_COMPETENCIA_ORIGEM) AS _A_Y_MONTHS,
    Sum(QTD_LEITOS_EXISTENTES) AS _A_Y_EXIST,
    Sum(QTD_LEITOS_SUS) AS _A_Y_SUS,
    Sum(QTD_LEITOS_NAO_SUS) AS _A_Y_NSUS
RESIDENT P5CAP_AUDIT_FACT GROUP BY Left(Text(FATO_LT_COMPETENCIA_ORIGEM),4);
P5CAP_AUDIT_YEAR_CHECK:
NOCONCATENATE LOAD
    If(Match(_A_YEAR,'2017','2018','2019')>0 AND _A_Y_MONTHS=12
       AND _A_Y_EXIST-_A_Y_SUS=_A_Y_NSUS,0,1) AS _A_YEAR_BAD
RESIDENT P5CAP_AUDIT_YEAR;
P5CAP_AUDIT_YEAR_TOTAL:
NOCONCATENATE LOAD Count(*) AS _A_YEAR_COUNT, Sum(_A_YEAR_BAD) AS _A_YEAR_INVALID
RESIDENT P5CAP_AUDIT_YEAR_CHECK;
LET vP5CAYearCount=Peek('_A_YEAR_COUNT',0,'P5CAP_AUDIT_YEAR_TOTAL');
LET vP5CAYearBad=Peek('_A_YEAR_INVALID',0,'P5CAP_AUDIT_YEAR_TOTAL');
DROP TABLE P5CAP_AUDIT_YEAR_CHECK;
DROP TABLE P5CAP_AUDIT_YEAR_TOTAL;
DROP TABLE P5CAP_AUDIT_YEAR;
TRACE [V5-CAP-QVD-AUDIT] ANNUAL YEARS=$(vP5CAYearCount) BAD=$(vP5CAYearBad);
IF ScriptErrorCount > $(vP5CapAuditStartErrors) OR $(vP5CAYearCount)<>3 OR $(vP5CAYearBad)<>0 THEN
    TRACE [V5-CAP-QVD-AUDIT] VERDICT=BLOCKED_YEAR_RECONCILIATION;
    EXIT SCRIPT;
ENDIF
TRACE [V5-CAP-QVD-AUDIT] VERDICT=PASS_PHYSICAL_QVD_READBACK_CANDIDATE_ONLY;
TRACE [V5-CAP-QVD-AUDIT] LINK_TABLE_NOT_TESTED=True PRODUCTION_APPROVED=False;
