// FASE V — FATO_CAPACIDADE_LEITO candidate, CNES/LT 2017-2019.
// AUTHORIZED SCOPE: isolated in-memory PREFLIGHT only. NO STORE / CREATE mode.
// 35,518 original LT observations; monthly snapshots are semi-additive in time.
// %LINK_KEY uses experimental SAD-LINK-V1 coordinates, NOT final cross-fact approval.
// Naming and record fingerprint remain candidate until physical/semantic review.
LET vFLCStartErrors=ScriptErrorCount;
TRACE [V5-CAP-FACT] START MODE=$(vP5CapacidadeMode);
IF '$(vP5CapacidadeMode)' <> 'PREFLIGHT' THEN
    TRACE [V5-CAP-FACT] VERDICT=BLOCKED_MODE_ONLY_PREFLIGHT_ALLOWED;
    EXIT SCRIPT;
ENDIF

P5FLC_MAP_COMP: MAPPING LOAD DISTINCT [%SK_TEMPO_COMPETENCIA], 1 FROM [QVD\DIM_TEMPO.qvd] (qvd);
P5FLC_MAP_YEAR: MAPPING LOAD DISTINCT [%SK_TEMPO_ANO], 1 FROM [QVD\DIM_TEMPO.qvd] (qvd);
P5FLC_MAP_MUN: MAPPING LOAD DISTINCT [%SK_MUNICIPIO], 1 FROM [QVD\DIM_MUNICIPIO.qvd] (qvd);
P5FLC_MAP_EST: MAPPING LOAD DISTINCT [%SK_ESTABELECIMENTO], 1 FROM [QVD\DIM_ESTABELECIMENTO.qvd] (qvd);
P5FLC_MAP_LEITO: MAPPING LOAD DISTINCT [%SK_TIPO_LEITO], 1 FROM [QVD\DIM_TIPO_LEITO.qvd] (qvd);
IF ScriptErrorCount > $(vFLCStartErrors) THEN
    TRACE [V5-CAP-FACT] VERDICT=BLOCKED_DIMENSION_INPUT;
    EXIT SCRIPT;
ENDIF

// Fingerprint scoped to a frozen LT snapshot. Do NOT interpret as immutable
// institutional bed identity after data corrections. Never use CODLEITO alone.
// Qlik QVD TP_LEITO is accepted only as N or N+one ASCII space (A2).
P5FLC_SOURCE:
NOCONCATENATE LOAD
    Hash128('LT',Trim(Text(CNES)),Text(COMPETEN),Text(CODLEITO)) AS _FLC_RECORD_SK,
    Hash128('MES',Text(Date(Date#(Text(COMPETEN),'YYYYMM'),'YYYYMM'))) AS _FLC_C,
    Hash128('ANO',Num#(Left(Text(COMPETEN),4),'####','.',',')) AS _FLC_Y,
    Hash128('MUN',Trim(Text(CODUFMUN))) AS _FLC_S,
    Hash128('ESTAB',Trim(Text(CNES)),Trim(Text(COMPETEN))) AS _FLC_E,
    Hash128('LEITO',Left(Text(TP_LEITO),1),Text(CODLEITO),Text(COMPETEN)) AS _FLC_BED_SK,
    Trim(Text(CNES)) AS _FLC_CNES,
    Text(CODUFMUN) AS _FLC_MUN,
    Text(COMPETEN) AS _FLC_COMP,
    Left(Text(COMPETEN),4) AS _FLC_YEAR,
    Text(_META_SOURCE_COMPETENCE) AS _FLC_META_COMP,
    Text(_META_SOURCE_FILE) AS _FLC_FILE,
    Text(TP_LEITO) AS _FLC_TYPE_STAGING,
    Left(Text(TP_LEITO),1) AS _FLC_TYPE,
    Text(CODLEITO) AS _FLC_BED_CODE,
    QT_EXIST AS _FLC_EXIST,
    QT_SUS AS _FLC_SUS,
    QT_NSUS AS _FLC_NSUS
FROM [..\EXTRACAO\QVD\SRC_CNES_LT.qvd] (qvd);
IF ScriptErrorCount > $(vFLCStartErrors) OR NoOfRows('P5FLC_SOURCE')<>35518 THEN
    TRACE [V5-CAP-FACT] VERDICT=BLOCKED_SOURCE_LOAD_OR_ROWS;
    EXIT SCRIPT;
ENDIF

P5FLC_FLAGS:
NOCONCATENATE LOAD
    If(ApplyMap('P5FLC_MAP_COMP',_FLC_C,0)=1,0,1) AS _FLC_MISS_COMP,
    If(ApplyMap('P5FLC_MAP_YEAR',_FLC_Y,0)=1,0,1) AS _FLC_MISS_YEAR,
    If(ApplyMap('P5FLC_MAP_MUN',_FLC_S,0)=1,0,1) AS _FLC_MISS_MUN,
    If(ApplyMap('P5FLC_MAP_EST',_FLC_E,0)=1,0,1) AS _FLC_MISS_EST,
    If(ApplyMap('P5FLC_MAP_LEITO',_FLC_BED_SK,0)=1,0,1) AS _FLC_MISS_BED,
    If(IsNull(_FLC_CNES) OR Len(_FLC_CNES)=0
        OR IsNull(_FLC_MUN) OR Len(Trim(_FLC_MUN))=0
        OR IsNull(_FLC_COMP) OR Len(_FLC_COMP)<>6
        OR Len(KeepChar(_FLC_COMP,'0123456789'))<>6
        OR _FLC_COMP<'201701' OR _FLC_COMP>'201912'
        OR _FLC_COMP<>_FLC_META_COMP
        OR IsNull(_FLC_BED_CODE) OR Len(_FLC_BED_CODE)<>2
        OR Len(KeepChar(_FLC_BED_CODE,'0123456789'))<>2
        OR IsNull(_FLC_TYPE_STAGING)
        OR Match(_FLC_TYPE,'1','2','3','4','5','6','7')=0
        OR (Len(_FLC_TYPE_STAGING)<>1
            AND (Len(_FLC_TYPE_STAGING)<>2 OR Right(_FLC_TYPE_STAGING,1)<>' '))
        OR IsNull(_FLC_FILE) OR Len(Trim(_FLC_FILE))=0,1,0) AS _FLC_BAD_DOMAIN,
    If(NOT IsNum(_FLC_EXIST) OR NOT IsNum(_FLC_SUS)
        OR NOT IsNum(_FLC_NSUS)
        OR _FLC_EXIST<0 OR _FLC_SUS<0 OR _FLC_NSUS<0
        OR _FLC_EXIST<>Round(_FLC_EXIST,1)
        OR _FLC_SUS<>Round(_FLC_SUS,1)
        OR _FLC_NSUS<>Round(_FLC_NSUS,1)
        OR _FLC_SUS>_FLC_EXIST
        OR _FLC_NSUS<>_FLC_EXIST-_FLC_SUS,1,0) AS _FLC_BAD_MEASURE
RESIDENT P5FLC_SOURCE;
IF ScriptErrorCount > $(vFLCStartErrors) OR NoOfRows('P5FLC_FLAGS')<>35518 THEN
    TRACE [V5-CAP-FACT] VERDICT=BLOCKED_FLAGS_LOAD;
    EXIT SCRIPT;
ENDIF

P5FLC_SOURCE_SUMMARY:
NOCONCATENATE LOAD
    Count(*) AS _FLC_ROWS,
    Count(DISTINCT _FLC_RECORD_SK) AS _FLC_UNIQUE,
    Count(DISTINCT _FLC_COMP) AS _FLC_MONTHS,
    Count(DISTINCT _FLC_FILE) AS _FLC_FILES,
    Count(DISTINCT _FLC_TYPE & '|' & _FLC_BED_CODE) AS _FLC_PAIRS,
    Count(DISTINCT _FLC_TYPE & '|' & _FLC_BED_CODE & '|' & _FLC_COMP) AS _FLC_PAIR_MONTHS,
    Sum(If(_FLC_TYPE='3' AND _FLC_BED_CODE='66',1,0)) AS _FLC_3_66,
    Sum(If(_FLC_TYPE='7' AND _FLC_BED_CODE='70',1,0)) AS _FLC_7_70,
    Sum(If(IsNull(_FLC_RECORD_SK) OR IsNull(_FLC_C) OR IsNull(_FLC_Y)
        OR IsNull(_FLC_S) OR IsNull(_FLC_E) OR IsNull(_FLC_BED_SK),1,0)) AS _FLC_NULL,
    Sum(_FLC_EXIST) AS _FLC_EXIST_SUM,
    Sum(_FLC_SUS) AS _FLC_SUS_SUM,
    Sum(_FLC_NSUS) AS _FLC_NSUS_SUM
RESIDENT P5FLC_SOURCE;
P5FLC_ROLES_SUMMARY:
NOCONCATENATE LOAD
    Sum(_FLC_MISS_COMP) AS _FLC_MCOMP,
    Sum(_FLC_MISS_YEAR) AS _FLC_MYEAR,
    Sum(_FLC_MISS_MUN) AS _FLC_MMUN,
    Sum(_FLC_MISS_EST) AS _FLC_MEST,
    Sum(_FLC_MISS_BED) AS _FLC_MBED,
    Sum(_FLC_BAD_DOMAIN) AS _FLC_BAD_DOMAIN_TOTAL,
    Sum(_FLC_BAD_MEASURE) AS _FLC_BAD_MEASURE_TOTAL
RESIDENT P5FLC_FLAGS;
IF ScriptErrorCount > $(vFLCStartErrors) THEN
    TRACE [V5-CAP-FACT] VERDICT=BLOCKED_SOURCE_PROFILING;
    EXIT SCRIPT;
ENDIF
LET vFLCRows=Peek('_FLC_ROWS',0,'P5FLC_SOURCE_SUMMARY');
LET vFLCUnique=Peek('_FLC_UNIQUE',0,'P5FLC_SOURCE_SUMMARY');
LET vFLCMonths=Peek('_FLC_MONTHS',0,'P5FLC_SOURCE_SUMMARY');
LET vFLCFiles=Peek('_FLC_FILES',0,'P5FLC_SOURCE_SUMMARY');
LET vFLCPairs=Peek('_FLC_PAIRS',0,'P5FLC_SOURCE_SUMMARY');
LET vFLCPairMonths=Peek('_FLC_PAIR_MONTHS',0,'P5FLC_SOURCE_SUMMARY');
LET vFLC366=Peek('_FLC_3_66',0,'P5FLC_SOURCE_SUMMARY');
LET vFLC770=Peek('_FLC_7_70',0,'P5FLC_SOURCE_SUMMARY');
LET vFLCNull=Peek('_FLC_NULL',0,'P5FLC_SOURCE_SUMMARY');
LET vFLCExist=Peek('_FLC_EXIST_SUM',0,'P5FLC_SOURCE_SUMMARY');
LET vFLCSus=Peek('_FLC_SUS_SUM',0,'P5FLC_SOURCE_SUMMARY');
LET vFLCNsus=Peek('_FLC_NSUS_SUM',0,'P5FLC_SOURCE_SUMMARY');
LET vFLCMComp=Peek('_FLC_MCOMP',0,'P5FLC_ROLES_SUMMARY');
LET vFLCMYear=Peek('_FLC_MYEAR',0,'P5FLC_ROLES_SUMMARY');
LET vFLCMMun=Peek('_FLC_MMUN',0,'P5FLC_ROLES_SUMMARY');
LET vFLCMEst=Peek('_FLC_MEST',0,'P5FLC_ROLES_SUMMARY');
LET vFLCMBed=Peek('_FLC_MBED',0,'P5FLC_ROLES_SUMMARY');
LET vFLCBadDomain=Peek('_FLC_BAD_DOMAIN_TOTAL',0,'P5FLC_ROLES_SUMMARY');
LET vFLCBadMeasure=Peek('_FLC_BAD_MEASURE_TOTAL',0,'P5FLC_ROLES_SUMMARY');
DROP TABLE P5FLC_SOURCE_SUMMARY;
DROP TABLE P5FLC_ROLES_SUMMARY;
DROP TABLE P5FLC_FLAGS;
TRACE [V5-CAP-FACT] SOURCE ROWS=$(vFLCRows) UNIQUE=$(vFLCUnique) MONTHS=$(vFLCMonths) FILES=$(vFLCFiles) PAIRS=$(vFLCPairs) PAIR_MONTHS=$(vFLCPairMonths) TYPE3_BED66=$(vFLC366) TYPE7_BED70=$(vFLC770) NULL=$(vFLCNull) BAD_DOMAIN=$(vFLCBadDomain) BAD_MEASURE=$(vFLCBadMeasure);
TRACE [V5-CAP-FACT] ROLES COMP=$(vFLCMComp) ANO=$(vFLCMYear) MUNICIPIO_SERVICO=$(vFLCMMun) ESTABELECIMENTO=$(vFLCMEst) TIPO_LEITO=$(vFLCMBed);
TRACE [V5-CAP-FACT] SNAPSHOT_SUMS_UNSAFE_AS_PERIOD_TOTAL EXIST=$(vFLCExist) SUS=$(vFLCSus) NSUS=$(vFLCNsus);
IF ScriptErrorCount > $(vFLCStartErrors) OR $(vFLCRows)<>35518 OR $(vFLCUnique)<>35518 OR $(vFLCMonths)<>36 OR $(vFLCFiles)<>36 OR $(vFLCPairs)<>57 OR $(vFLCPairMonths)<>2021 OR $(vFLC366)<>1480 OR $(vFLC770)<>5 OR $(vFLCNull)<>0 OR $(vFLCBadDomain)<>0 OR $(vFLCBadMeasure)<>0 OR $(vFLCMComp)<>0 OR $(vFLCMYear)<>0 OR $(vFLCMMun)<>0 OR $(vFLCMEst)<>0 OR $(vFLCMBed)<>0 OR $(vFLCExist)<>337147 OR $(vFLCSus)<>270076 OR $(vFLCNsus)<>67071 THEN
    TRACE [V5-CAP-FACT] VERDICT=BLOCKED_SOURCE_RECONCILIATION;
    EXIT SCRIPT;
ENDIF

// Three annual groups and all 12 administrative months in each year.
// Annual sums logged below are diagnostic, NOT annual capacity indicators.
P5FLC_YEAR:
NOCONCATENATE LOAD
    _FLC_YEAR AS _FLC_YEAR_GROUP,
    Count(*) AS _FLC_YEAR_ROWS,
    Count(DISTINCT _FLC_COMP) AS _FLC_YEAR_MONTHS,
    Sum(_FLC_EXIST) AS _FLC_YEAR_EXIST,
    Sum(_FLC_SUS) AS _FLC_YEAR_SUS,
    Sum(_FLC_NSUS) AS _FLC_YEAR_NSUS
RESIDENT P5FLC_SOURCE GROUP BY _FLC_YEAR;
P5FLC_YEAR_CHECK:
NOCONCATENATE LOAD
    If(Match(_FLC_YEAR_GROUP,'2017','2018','2019')>0 AND _FLC_YEAR_MONTHS=12
        AND _FLC_YEAR_EXIST-_FLC_YEAR_SUS=_FLC_YEAR_NSUS,0,1) AS _FLC_YEAR_BAD
RESIDENT P5FLC_YEAR;
P5FLC_YEAR_PROFILE:
NOCONCATENATE LOAD
    Count(*) AS _FLC_YEAR_COUNT,
    Sum(_FLC_YEAR_BAD) AS _FLC_YEAR_FAIL
RESIDENT P5FLC_YEAR_CHECK;
LET vFLCYearCount=Peek('_FLC_YEAR_COUNT',0,'P5FLC_YEAR_PROFILE');
LET vFLCYearBad=Peek('_FLC_YEAR_FAIL',0,'P5FLC_YEAR_PROFILE');
DROP TABLE P5FLC_YEAR_CHECK;
DROP TABLE P5FLC_YEAR_PROFILE;
DROP TABLE P5FLC_YEAR;
TRACE [V5-CAP-FACT] YEARS=$(vFLCYearCount) YEAR_BAD=$(vFLCYearBad);
IF ScriptErrorCount > $(vFLCStartErrors) OR $(vFLCYearCount)<>3 OR $(vFLCYearBad)<>0 THEN
    TRACE [V5-CAP-FACT] VERDICT=BLOCKED_YEAR_RECONCILIATION;
    EXIT SCRIPT;
ENDIF

// Only %LINK_KEY is the shared cross-fact coordinate. Residence intentionally
// NULL for capacity in Boundary 7; encode it as R=N in the candidate hash.
// This projection DOES NOT approve the global LINK_ANALISE physical contract.
FATO_CAPACIDADE_LEITO:
NOCONCATENATE LOAD
    _FLC_RECORD_SK AS SK_REGISTRO_CAPACIDADE_LEITO,
    Hash128('SAD-LINK-V1',
        'C=' & If(IsNull(_FLC_C),'N','V' & Len(Text(_FLC_C)) & ':' & Text(_FLC_C)),
        'Y=' & If(IsNull(_FLC_Y),'N','V' & Len(Text(_FLC_Y)) & ':' & Text(_FLC_Y)),
        'R=N',
        'S=' & If(IsNull(_FLC_S),'N','V' & Len(Text(_FLC_S)) & ':' & Text(_FLC_S)),
        'E=' & If(IsNull(_FLC_E),'N','V' & Len(Text(_FLC_E)) & ':' & Text(_FLC_E))
    ) AS [%LINK_KEY],
    _FLC_BED_SK AS [%SK_TIPO_LEITO],
    _FLC_EXIST AS QTD_LEITOS_EXISTENTES,
    _FLC_SUS AS QTD_LEITOS_SUS,
    _FLC_NSUS AS QTD_LEITOS_NAO_SUS,
    _FLC_CNES AS FATO_LT_CNES_ORIGEM,
    _FLC_BED_CODE AS FATO_LT_CODLEITO_ORIGEM,
    _FLC_TYPE_STAGING AS FATO_LT_TIPO_TEXTO_STAGING,
    _FLC_COMP AS FATO_LT_COMPETENCIA_ORIGEM,
    _FLC_FILE AS FATO_LT_ARQUIVO_ORIGEM
RESIDENT P5FLC_SOURCE;
IF ScriptErrorCount > $(vFLCStartErrors) OR NoOfRows('FATO_CAPACIDADE_LEITO')<>35518 OR NoOfFields('FATO_CAPACIDADE_LEITO')<>11 THEN
    TRACE [V5-CAP-FACT] VERDICT=BLOCKED_FACT_PROJECTION_OR_SCHEMA;
    EXIT SCRIPT;
ENDIF

P5FLC_OUTPUT_CHECK:
NOCONCATENATE LOAD
    Count(*) AS _FLC_O_ROWS,
    Count(DISTINCT SK_REGISTRO_CAPACIDADE_LEITO) AS _FLC_O_UNIQUE,
    Count(DISTINCT [%LINK_KEY]) AS _FLC_O_LINKS,
    Sum(If(IsNull(SK_REGISTRO_CAPACIDADE_LEITO)
        OR IsNull([%LINK_KEY]) OR IsNull([%SK_TIPO_LEITO])
        OR IsNull(FATO_LT_CNES_ORIGEM)
        OR IsNull(FATO_LT_CODLEITO_ORIGEM)
        OR IsNull(FATO_LT_TIPO_TEXTO_STAGING)
        OR IsNull(FATO_LT_COMPETENCIA_ORIGEM)
        OR IsNull(FATO_LT_ARQUIVO_ORIGEM),1,0)) AS _FLC_O_NULL,
    Sum(QTD_LEITOS_EXISTENTES) AS _FLC_O_EXIST,
    Sum(QTD_LEITOS_SUS) AS _FLC_O_SUS,
    Sum(QTD_LEITOS_NAO_SUS) AS _FLC_O_NSUS,
    Sum(If(NOT IsNum(QTD_LEITOS_EXISTENTES) OR NOT IsNum(QTD_LEITOS_SUS)
        OR NOT IsNum(QTD_LEITOS_NAO_SUS)
        OR QTD_LEITOS_EXISTENTES<0
        OR QTD_LEITOS_SUS<0 OR QTD_LEITOS_NAO_SUS<0
        OR QTD_LEITOS_EXISTENTES<>Round(QTD_LEITOS_EXISTENTES,1)
        OR QTD_LEITOS_SUS<>Round(QTD_LEITOS_SUS,1)
        OR QTD_LEITOS_NAO_SUS<>Round(QTD_LEITOS_NAO_SUS,1)
        OR QTD_LEITOS_NAO_SUS<>QTD_LEITOS_EXISTENTES-QTD_LEITOS_SUS,1,0)) AS _FLC_O_INVALID
RESIDENT FATO_CAPACIDADE_LEITO;
LET vFLCOrows=Peek('_FLC_O_ROWS',0,'P5FLC_OUTPUT_CHECK');
LET vFLCOunique=Peek('_FLC_O_UNIQUE',0,'P5FLC_OUTPUT_CHECK');
LET vFLCOlinks=Peek('_FLC_O_LINKS',0,'P5FLC_OUTPUT_CHECK');
LET vFLCOnull=Peek('_FLC_O_NULL',0,'P5FLC_OUTPUT_CHECK');
LET vFLCOexist=Peek('_FLC_O_EXIST',0,'P5FLC_OUTPUT_CHECK');
LET vFLCOsus=Peek('_FLC_O_SUS',0,'P5FLC_OUTPUT_CHECK');
LET vFLCOnsus=Peek('_FLC_O_NSUS',0,'P5FLC_OUTPUT_CHECK');
LET vFLCOinvalid=Peek('_FLC_O_INVALID',0,'P5FLC_OUTPUT_CHECK');
DROP TABLE P5FLC_OUTPUT_CHECK;
TRACE [V5-CAP-FACT] OUTPUT ROWS=$(vFLCOrows) UNIQUE=$(vFLCOunique) LINKS=$(vFLCOlinks) NULL=$(vFLCOnull) EXIST=$(vFLCOexist) SUS=$(vFLCOsus) NSUS=$(vFLCOnsus) INVALID=$(vFLCOinvalid);
IF ScriptErrorCount > $(vFLCStartErrors) OR $(vFLCOrows)<>35518 OR $(vFLCOunique)<>35518 OR $(vFLCOlinks)<=0 OR $(vFLCOlinks)>35518 OR $(vFLCOnull)<>0 OR $(vFLCOexist)<>337147 OR $(vFLCOsus)<>270076 OR $(vFLCOnsus)<>67071 OR $(vFLCOinvalid)<>0 THEN
    TRACE [V5-CAP-FACT] VERDICT=BLOCKED_FACT_RECONCILIATION;
    EXIT SCRIPT;
ENDIF
DROP TABLE P5FLC_SOURCE;
TRACE [V5-CAP-FACT] VERDICT=PASS_IN_MEMORY_CANDIDATE_ONLY_NOT_PHYSICAL_APPROVAL;
TRACE [V5-CAP-FACT] FACT_QVD_GENERATED=False LINK_TABLE_NOT_TESTED=True PRODUCTION_APPROVED=False;
