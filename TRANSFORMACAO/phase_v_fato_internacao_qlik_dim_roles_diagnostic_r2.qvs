// FASE V — read-only R2 DIAGNOSTIC for date/competence hash and one MOT unmatched.
// No QVDs written; no joins; no fact or Link Table generated.
// Runs separately from V5_RD_DIM_ROLES_PREFLIGHT.qvw (R1 preserved).
SET ErrorMode=0;
LET vP5DiagErrorStart = ScriptErrorCount;
TRACE [V5-RD-DIAG] START READ_ONLY_DIM_ROLE_ROOT_CAUSE;

P5D_ORIG_MONTH:
MAPPING LOAD DISTINCT [%SK_TEMPO_COMPETENCIA], 1 FROM [QVD\DIM_TEMPO.qvd] (qvd);
P5D_ORIG_DAY:
MAPPING LOAD DISTINCT [%SK_TEMPO_DATA], 1 FROM [QVD\DIM_TEMPO.qvd] (qvd);
P5D_RAW_MONTH:
MAPPING LOAD DISTINCT Text(TEMPO_COMPETENCIA), 1 FROM [QVD\DIM_TEMPO.qvd] (qvd);
P5D_RAW_DAY:
MAPPING LOAD DISTINCT Text(TEMPO_DATA_YYYYMMDD), 1 FROM [QVD\DIM_TEMPO.qvd] (qvd);
P5D_REHASH_MONTH:
MAPPING LOAD DISTINCT Hash128('MES', Text(TEMPO_COMPETENCIA)), 1 FROM [QVD\DIM_TEMPO.qvd] (qvd);
P5D_REHASH_DAY:
MAPPING LOAD DISTINCT Hash128('DATA', Text(TEMPO_DATA_YYYYMMDD)), 1 FROM [QVD\DIM_TEMPO.qvd] (qvd);
P5D_ORIG_MOT:
MAPPING LOAD DISTINCT [%SK_MOTIVO_SAIDA], 1 FROM [QVD\DIM_MOTIVO_SAIDA_PERMANENCIA.qvd] (qvd);
P5D_RAW_MOT:
MAPPING LOAD DISTINCT Text(COD_MOTIVO_SAIDA_FONTE), 1 FROM [QVD\DIM_MOTIVO_SAIDA_PERMANENCIA.qvd] (qvd);
P5D_REHASH_MOT:
MAPPING LOAD DISTINCT Hash128('MOT', Text(COD_MOTIVO_SAIDA_FONTE)), 1 FROM [QVD\DIM_MOTIVO_SAIDA_PERMANENCIA.qvd] (qvd);

IF ScriptErrorCount > $(vP5DiagErrorStart) THEN
    TRACE [V5-RD-DIAG] VERDICT=BLOCKED_MAPPING_LOAD;
    EXIT SCRIPT;
ENDIF

// Compare stored dimension SK, natural dimension attributes, and rehashed attributes.
P5D_CAL_CHECK:
NOCONCATENATE LOAD
    If([%SK_TEMPO_COMPETENCIA]=Hash128('MES',Text(TEMPO_COMPETENCIA)),0,1) AS _P5D_DIM_MONTH_REHASH_MISS,
    If([%SK_TEMPO_DATA]=Hash128('DATA',Text(TEMPO_DATA_YYYYMMDD)),0,1) AS _P5D_DIM_DAY_REHASH_MISS
FROM [QVD\DIM_TEMPO.qvd] (qvd);

P5D_CAL_PROFILE:
NOCONCATENATE LOAD
    Count(*) AS _P5D_CAL_ROWS,
    Sum(_P5D_DIM_MONTH_REHASH_MISS) AS _P5D_CAL_MONTH_REHASH_MISS,
    Sum(_P5D_DIM_DAY_REHASH_MISS) AS _P5D_CAL_DAY_REHASH_MISS
RESIDENT P5D_CAL_CHECK;

P5D_MOT_CHECK:
NOCONCATENATE LOAD
    If([%SK_MOTIVO_SAIDA]=Hash128('MOT',Text(COD_MOTIVO_SAIDA_FONTE)),0,1) AS _P5D_DIM_MOT_REHASH_MISS
FROM [QVD\DIM_MOTIVO_SAIDA_PERMANENCIA.qvd] (qvd);

P5D_MOT_PROFILE:
NOCONCATENATE LOAD
    Count(*) AS _P5D_MOT_ROWS,
    Sum(_P5D_DIM_MOT_REHASH_MISS) AS _P5D_DIM_MOT_REHASH_MISS
RESIDENT P5D_MOT_CHECK;

IF ScriptErrorCount > $(vP5DiagErrorStart) THEN
    TRACE [V5-RD-DIAG] VERDICT=BLOCKED_DIMENSION_ATTRIBUTE_CHECK;
    EXIT SCRIPT;
ENDIF

// Exact 11-role original verification is already recorded in R1. Here test only failed roles.
P5D_RD_FLAGS:
NOCONCATENATE LOAD
    Text(_META_SOURCE_COMPETENCE) AS _P5D_COMP,
    Text(DT_INTER) AS _P5D_INTER,
    Text(DT_SAIDA) AS _P5D_SAIDA,
    Text(Right('00' & KeepChar(Text(COBRANCA),'0123456789'),2)) AS _P5D_MOT_CODE,
    If(ApplyMap('P5D_ORIG_MONTH',Hash128('MES',Trim(Text(_META_SOURCE_COMPETENCE))),0)=1,0,1) AS _P5D_MISS_MONTH_ORIG,
    If(ApplyMap('P5D_RAW_MONTH',Trim(Text(_META_SOURCE_COMPETENCE)),0)=1,0,1) AS _P5D_MISS_MONTH_NAT,
    If(ApplyMap('P5D_REHASH_MONTH',Hash128('MES',Trim(Text(_META_SOURCE_COMPETENCE))),0)=1,0,1) AS _P5D_MISS_MONTH_REHASH,
    If(ApplyMap('P5D_ORIG_MONTH',Hash128('MES',Text(Date(Date#(Trim(Text(_META_SOURCE_COMPETENCE)),'YYYYMM'),'YYYYMM'))),0)=1,0,1) AS _P5D_MISS_MONTH_DATEFORM,
    If(ApplyMap('P5D_ORIG_DAY',Hash128('DATA',Trim(Text(DT_INTER))),0)=1,0,1) AS _P5D_MISS_INTER_ORIG,
    If(ApplyMap('P5D_RAW_DAY',Trim(Text(DT_INTER)),0)=1,0,1) AS _P5D_MISS_INTER_NAT,
    If(ApplyMap('P5D_REHASH_DAY',Hash128('DATA',Trim(Text(DT_INTER))),0)=1,0,1) AS _P5D_MISS_INTER_REHASH,
    If(ApplyMap('P5D_ORIG_DAY',Hash128('DATA',Text(Date(Date#(Trim(Text(DT_INTER)),'YYYYMMDD'),'YYYYMMDD'))),0)=1,0,1) AS _P5D_MISS_INTER_DATEFORM,
    If(ApplyMap('P5D_ORIG_DAY',Hash128('DATA',Trim(Text(DT_SAIDA))),0)=1,0,1) AS _P5D_MISS_SAIDA_ORIG,
    If(ApplyMap('P5D_RAW_DAY',Trim(Text(DT_SAIDA)),0)=1,0,1) AS _P5D_MISS_SAIDA_NAT,
    If(ApplyMap('P5D_REHASH_DAY',Hash128('DATA',Trim(Text(DT_SAIDA))),0)=1,0,1) AS _P5D_MISS_SAIDA_REHASH,
    If(ApplyMap('P5D_ORIG_DAY',Hash128('DATA',Text(Date(Date#(Trim(Text(DT_SAIDA)),'YYYYMMDD'),'YYYYMMDD'))),0)=1,0,1) AS _P5D_MISS_SAIDA_DATEFORM,
    If(ApplyMap('P5D_ORIG_MOT',Hash128('MOT',Text(Right('00' & KeepChar(Text(COBRANCA),'0123456789'),2))),0)=1,0,1) AS _P5D_MISS_MOT_ORIG,
    If(ApplyMap('P5D_RAW_MOT',Text(Right('00' & KeepChar(Text(COBRANCA),'0123456789'),2)),0)=1,0,1) AS _P5D_MISS_MOT_NAT,
    If(ApplyMap('P5D_REHASH_MOT',Hash128('MOT',Text(Right('00' & KeepChar(Text(COBRANCA),'0123456789'),2))),0)=1,0,1) AS _P5D_MISS_MOT_REHASH
FROM [..\EXTRACAO\QVD\SRC_SIH_RD.qvd] (qvd);

IF ScriptErrorCount > $(vP5DiagErrorStart) THEN
    TRACE [V5-RD-DIAG] VERDICT=BLOCKED_RD_DIAGNOSTIC_LOAD;
    EXIT SCRIPT;
ENDIF
IF NoOfRows('P5D_RD_FLAGS') <> 566672 THEN
    TRACE [V5-RD-DIAG] VERDICT=BLOCKED_RD_ROW_COUNT;
    EXIT SCRIPT;
ENDIF

P5D_RD_PROFILE:
NOCONCATENATE LOAD
    Count(*) AS _P5D_ROWS,
    Count(DISTINCT _P5D_COMP) AS _P5D_MONTHS,
    Sum(_P5D_MISS_MONTH_ORIG) AS _P5D_COUNT_MONTH_ORIG,
    Sum(_P5D_MISS_MONTH_NAT) AS _P5D_COUNT_MONTH_NAT,
    Sum(_P5D_MISS_MONTH_REHASH) AS _P5D_COUNT_MONTH_REHASH,
    Sum(_P5D_MISS_MONTH_DATEFORM) AS _P5D_COUNT_MONTH_DATEFORM,
    Sum(_P5D_MISS_INTER_ORIG) AS _P5D_COUNT_INTER_ORIG,
    Sum(_P5D_MISS_INTER_NAT) AS _P5D_COUNT_INTER_NAT,
    Sum(_P5D_MISS_INTER_REHASH) AS _P5D_COUNT_INTER_REHASH,
    Sum(_P5D_MISS_INTER_DATEFORM) AS _P5D_COUNT_INTER_DATEFORM,
    Sum(_P5D_MISS_SAIDA_ORIG) AS _P5D_COUNT_SAIDA_ORIG,
    Sum(_P5D_MISS_SAIDA_NAT) AS _P5D_COUNT_SAIDA_NAT,
    Sum(_P5D_MISS_SAIDA_REHASH) AS _P5D_COUNT_SAIDA_REHASH,
    Sum(_P5D_MISS_SAIDA_DATEFORM) AS _P5D_COUNT_SAIDA_DATEFORM,
    Sum(_P5D_MISS_MOT_ORIG) AS _P5D_COUNT_MOT_ORIG,
    Sum(_P5D_MISS_MOT_NAT) AS _P5D_COUNT_MOT_NAT,
    Sum(_P5D_MISS_MOT_REHASH) AS _P5D_COUNT_MOT_REHASH
RESIDENT P5D_RD_FLAGS;

P5D_MOT_EXCEPTION:
NOCONCATENATE LOAD
    _P5D_MOT_CODE AS _P5D_EXC_CODE,
    Count(*) AS _P5D_EXC_ROWS,
    Sum(_P5D_MISS_MOT_NAT) AS _P5D_EXC_CODE_NOT_FOUND
RESIDENT P5D_RD_FLAGS
WHERE _P5D_MISS_MOT_ORIG=1
GROUP BY _P5D_MOT_CODE;

IF ScriptErrorCount > $(vP5DiagErrorStart) THEN
    TRACE [V5-RD-DIAG] VERDICT=BLOCKED_RD_DIAGNOSTIC_AGGREGATION;
    EXIT SCRIPT;
ENDIF

LET vP5Drows = Peek('_P5D_ROWS',0,'P5D_RD_PROFILE');
LET vP5Dmonths = Peek('_P5D_MONTHS',0,'P5D_RD_PROFILE');
LET vP5DcalRows = Peek('_P5D_CAL_ROWS',0,'P5D_CAL_PROFILE');
LET vP5DdimMonthDiff = Peek('_P5D_CAL_MONTH_REHASH_MISS',0,'P5D_CAL_PROFILE');
LET vP5DdimDayDiff = Peek('_P5D_CAL_DAY_REHASH_MISS',0,'P5D_CAL_PROFILE');
LET vP5DmotDimRows = Peek('_P5D_MOT_ROWS',0,'P5D_MOT_PROFILE');
LET vP5DmotDimDiff = Peek('_P5D_DIM_MOT_REHASH_MISS',0,'P5D_MOT_PROFILE');
LET vP5DMONTH_ORIG = Peek('_P5D_COUNT_MONTH_ORIG',0,'P5D_RD_PROFILE');
LET vP5DMONTH_NAT = Peek('_P5D_COUNT_MONTH_NAT',0,'P5D_RD_PROFILE');
LET vP5DMONTH_REHASH = Peek('_P5D_COUNT_MONTH_REHASH',0,'P5D_RD_PROFILE');
LET vP5DMONTH_DATEFORM = Peek('_P5D_COUNT_MONTH_DATEFORM',0,'P5D_RD_PROFILE');
LET vP5DINTER_ORIG = Peek('_P5D_COUNT_INTER_ORIG',0,'P5D_RD_PROFILE');
LET vP5DINTER_NAT = Peek('_P5D_COUNT_INTER_NAT',0,'P5D_RD_PROFILE');
LET vP5DINTER_REHASH = Peek('_P5D_COUNT_INTER_REHASH',0,'P5D_RD_PROFILE');
LET vP5DINTER_DATEFORM = Peek('_P5D_COUNT_INTER_DATEFORM',0,'P5D_RD_PROFILE');
LET vP5DSAIDA_ORIG = Peek('_P5D_COUNT_SAIDA_ORIG',0,'P5D_RD_PROFILE');
LET vP5DSAIDA_NAT = Peek('_P5D_COUNT_SAIDA_NAT',0,'P5D_RD_PROFILE');
LET vP5DSAIDA_REHASH = Peek('_P5D_COUNT_SAIDA_REHASH',0,'P5D_RD_PROFILE');
LET vP5DSAIDA_DATEFORM = Peek('_P5D_COUNT_SAIDA_DATEFORM',0,'P5D_RD_PROFILE');
LET vP5DMOT_ORIG = Peek('_P5D_COUNT_MOT_ORIG',0,'P5D_RD_PROFILE');
LET vP5DMOT_NAT = Peek('_P5D_COUNT_MOT_NAT',0,'P5D_RD_PROFILE');
LET vP5DMOT_REHASH = Peek('_P5D_COUNT_MOT_REHASH',0,'P5D_RD_PROFILE');
TRACE [V5-RD-DIAG] CALENDAR ROWS=$(vP5DcalRows) DIM_MONTH_REHASH_MISS=$(vP5DdimMonthDiff) DIM_DAY_REHASH_MISS=$(vP5DdimDayDiff) MOT_DIM_ROWS=$(vP5DmotDimRows) DIM_MOT_REHASH_MISS=$(vP5DmotDimDiff);
TRACE [V5-RD-DIAG] RD ROWS=$(vP5Drows) MONTHS=$(vP5Dmonths) MONTH_ORIG=$(vP5DMONTH_ORIG) MONTH_NAT=$(vP5DMONTH_NAT) MONTH_REHASH=$(vP5DMONTH_REHASH) MONTH_DATEFORM=$(vP5DMONTH_DATEFORM) INTER_ORIG=$(vP5DINTER_ORIG) INTER_NAT=$(vP5DINTER_NAT) INTER_REHASH=$(vP5DINTER_REHASH) INTER_DATEFORM=$(vP5DINTER_DATEFORM) SAIDA_ORIG=$(vP5DSAIDA_ORIG) SAIDA_NAT=$(vP5DSAIDA_NAT) SAIDA_REHASH=$(vP5DSAIDA_REHASH) SAIDA_DATEFORM=$(vP5DSAIDA_DATEFORM) MOT_ORIG=$(vP5DMOT_ORIG) MOT_NAT=$(vP5DMOT_NAT) MOT_REHASH=$(vP5DMOT_REHASH);
LET vP5DMotExceptions = NoOfRows('P5D_MOT_EXCEPTION');
TRACE [V5-RD-DIAG] MOT_EXCEPTION_GROUPS=$(vP5DMotExceptions);
IF $(vP5DMotExceptions) > 0 THEN
    FOR vP5Didx = 0 TO $(vP5DMotExceptions)-1
        LET vP5DCode = Peek('_P5D_EXC_CODE',$(vP5Didx),'P5D_MOT_EXCEPTION');
        LET vP5DCodeRows = Peek('_P5D_EXC_ROWS',$(vP5Didx),'P5D_MOT_EXCEPTION');
        LET vP5DCodeNotFound = Peek('_P5D_EXC_CODE_NOT_FOUND',$(vP5Didx),'P5D_MOT_EXCEPTION');
        TRACE [V5-RD-DIAG] MOT_EXCEPTION_CODE=$(vP5DCode) ROWS=$(vP5DCodeRows) NAT_NOT_FOUND=$(vP5DCodeNotFound);
    NEXT vP5Didx
ENDIF

IF $(vP5Drows) <> 566672 OR $(vP5Dmonths) <> 36 OR $(vP5DmotDimRows) <> 28 THEN
    TRACE [V5-RD-DIAG] VERDICT=BLOCKED_DIAG_BASELINE;
    EXIT SCRIPT;
ENDIF

DROP TABLE P5D_MOT_EXCEPTION;
DROP TABLE P5D_RD_PROFILE;
DROP TABLE P5D_RD_FLAGS;
DROP TABLE P5D_MOT_PROFILE;
DROP TABLE P5D_MOT_CHECK;
DROP TABLE P5D_CAL_PROFILE;
DROP TABLE P5D_CAL_CHECK;
TRACE [V5-RD-DIAG] VERDICT=DIAG_CAPTURED_NOT_APPROVED;
TRACE [V5-RD-DIAG] FACT_QVD_GENERATED=False OUTPUT_DATA_FILES_WRITTEN=0 ROLEPLAY_ASSOCIATIVE_MODEL=NOT_TESTED LINK_KEY_GATE=NOT_EXECUTED;
