// FASE V — independent physical readback of the persisted FATO_INTERNACAO QVD.
// QVW exclusively for audit: no transformation/main include, STORE or QVD writes.
// Does not approve the global Link Table, indicators, filters or PAINEL.
SET ErrorMode=0;
LET vFIAuditErrStart=ScriptErrorCount;
TRACE [V5-FACT-AUDIT] START_INDEPENDENT_QVD_REOPEN;

P5FI_AUDIT_FACT:
NOCONCATENATE LOAD *
FROM [QVD\FATO_INTERNACAO.qvd] (qvd);

IF ScriptErrorCount > $(vFIAuditErrStart) THEN
    TRACE [V5-FACT-AUDIT] VERDICT=BLOCKED_FACT_QVD_READ;
    EXIT SCRIPT;
ENDIF
LET vFIAuditRows=NoOfRows('P5FI_AUDIT_FACT');
LET vFIAuditFields=NoOfFields('P5FI_AUDIT_FACT');
TRACE [V5-FACT-AUDIT] HEADER ROWS=$(vFIAuditRows) FIELDS=$(vFIAuditFields);
IF $(vFIAuditRows) <> 566672 OR $(vFIAuditFields) <> 17 THEN
    TRACE [V5-FACT-AUDIT] VERDICT=BLOCKED_QVD_ROW_OR_FIELD_COUNT;
    EXIT SCRIPT;
ENDIF

// Audit all 17 persisted columns, including order, against the versioned schema.
P5FI_AUDIT_SCHEMA_EXPECT:
NOCONCATENATE LOAD * INLINE [
FIELD
SK_REGISTRO_INTERNACAO
%LINK_KEY
%SK_TEMPO_INTERNACAO
%SK_TEMPO_SAIDA
%SK_PROCEDIMENTO
%SK_DIAGNOSTICO
%SK_CARATER_ATENDIMENTO
%SK_MOTIVO_SAIDA
N_AIH
IDENT
QTD_REGISTRO_AIH
QTD_INTERNACAO
DIAS_PERMANENCIA
VALOR_TOTAL
INDICADOR_OBITO
FATO_RD_ARQUIVO_ORIGEM
FATO_RD_COMPETENCIA_ORIGEM
];
FOR vFIAuditIndex=0 TO 16
    LET vFIAuditPosition=$(vFIAuditIndex)+1;
    LET vFIAuditFieldName=FieldName($(vFIAuditPosition),'P5FI_AUDIT_FACT');
    LET vFIAuditExpectedName=Peek('FIELD',$(vFIAuditIndex),'P5FI_AUDIT_SCHEMA_EXPECT');
    IF '$(vFIAuditFieldName)' <> '$(vFIAuditExpectedName)' THEN
        TRACE [V5-FACT-AUDIT] VERDICT=BLOCKED_SCHEMA_FIELD_MISMATCH POSITION=$(vFIAuditPosition) ACTUAL=$(vFIAuditFieldName) EXPECTED=$(vFIAuditExpectedName);
        EXIT SCRIPT;
    ENDIF
NEXT
DROP TABLE P5FI_AUDIT_SCHEMA_EXPECT;
TRACE [V5-FACT-AUDIT] SCHEMA_EXACT_17=True;

// Audit persisted data, not the in-memory table that preceded STORE.
P5FI_AUDIT_TOTAL:
NOCONCATENATE LOAD
    Count(*) AS _FI_A_ROWS,
    Count(DISTINCT SK_REGISTRO_INTERNACAO) AS _FI_A_UNIQUE,
    Count(DISTINCT [%LINK_KEY]) AS _FI_A_LINKS,
    Count(DISTINCT FATO_RD_COMPETENCIA_ORIGEM) AS _FI_A_MONTHS,
    Count(DISTINCT FATO_RD_ARQUIVO_ORIGEM) AS _FI_A_FILES,
    Sum(If(IsNull(SK_REGISTRO_INTERNACAO) OR IsNull([%LINK_KEY])
        OR IsNull([%SK_TEMPO_INTERNACAO]) OR IsNull([%SK_TEMPO_SAIDA])
        OR IsNull([%SK_PROCEDIMENTO]) OR IsNull([%SK_DIAGNOSTICO])
        OR IsNull([%SK_CARATER_ATENDIMENTO]) OR IsNull([%SK_MOTIVO_SAIDA])
        OR IsNull(FATO_RD_ARQUIVO_ORIGEM) OR IsNull(FATO_RD_COMPETENCIA_ORIGEM),1,0)) AS _FI_A_NULL,
    Sum(QTD_REGISTRO_AIH) AS _FI_A_REG,
    Sum(QTD_INTERNACAO) AS _FI_A_NEW,
    Sum(If(IDENT='5',1,0)) AS _FI_A_CONT,
    Sum(INDICADOR_OBITO) AS _FI_A_DEATHS,
    Sum(DIAS_PERMANENCIA) AS _FI_A_DAYS,
    Sum(Round(VALOR_TOTAL*100,1)) AS _FI_A_CENTS,
    Sum(If(QTD_REGISTRO_AIH<>1 OR Match(IDENT,'1','5')=0
        OR QTD_INTERNACAO<>If(IDENT='1',1,0)
        OR NOT IsNum(DIAS_PERMANENCIA) OR DIAS_PERMANENCIA<0
        OR DIAS_PERMANENCIA<>Round(DIAS_PERMANENCIA,1)
        OR NOT IsNum(VALOR_TOTAL) OR VALOR_TOTAL<0
        OR Fabs(VALOR_TOTAL*100-Round(VALOR_TOTAL*100,1))>0.001
        OR NOT IsNum(INDICADOR_OBITO)
        OR Match(Text(INDICADOR_OBITO),'0','1')=0,1,0)) AS _FI_A_INVALID
RESIDENT P5FI_AUDIT_FACT;

LET vFIA_Rows=Peek('_FI_A_ROWS',0,'P5FI_AUDIT_TOTAL');
LET vFIA_Unique=Peek('_FI_A_UNIQUE',0,'P5FI_AUDIT_TOTAL');
LET vFIA_Links=Peek('_FI_A_LINKS',0,'P5FI_AUDIT_TOTAL');
LET vFIA_Months=Peek('_FI_A_MONTHS',0,'P5FI_AUDIT_TOTAL');
LET vFIA_Files=Peek('_FI_A_FILES',0,'P5FI_AUDIT_TOTAL');
LET vFIA_Null=Peek('_FI_A_NULL',0,'P5FI_AUDIT_TOTAL');
LET vFIA_Reg=Peek('_FI_A_REG',0,'P5FI_AUDIT_TOTAL');
LET vFIA_New=Peek('_FI_A_NEW',0,'P5FI_AUDIT_TOTAL');
LET vFIA_Cont=Peek('_FI_A_CONT',0,'P5FI_AUDIT_TOTAL');
LET vFIA_Deaths=Peek('_FI_A_DEATHS',0,'P5FI_AUDIT_TOTAL');
LET vFIA_Days=Peek('_FI_A_DAYS',0,'P5FI_AUDIT_TOTAL');
LET vFIA_Cents=Peek('_FI_A_CENTS',0,'P5FI_AUDIT_TOTAL');
LET vFIA_Invalid=Peek('_FI_A_INVALID',0,'P5FI_AUDIT_TOTAL');
DROP TABLE P5FI_AUDIT_TOTAL;
TRACE [V5-FACT-AUDIT] TOTAL ROWS=$(vFIA_Rows) UNIQUE=$(vFIA_Unique) LINKS=$(vFIA_Links) MONTHS=$(vFIA_Months) FILES=$(vFIA_Files) NULL=$(vFIA_Null) REG=$(vFIA_Reg) NEW=$(vFIA_New) CONT=$(vFIA_Cont) DEATHS=$(vFIA_Deaths) DAYS=$(vFIA_Days) CENTS=$(vFIA_Cents) INVALID=$(vFIA_Invalid);
IF ScriptErrorCount > $(vFIAuditErrStart) OR $(vFIA_Rows)<>566672 OR $(vFIA_Unique)<>566672 OR $(vFIA_Links)<>77550 OR $(vFIA_Months)<>36 OR $(vFIA_Files)<>36 OR $(vFIA_Null)<>0 OR $(vFIA_Reg)<>566672 OR $(vFIA_New)<>555089 OR $(vFIA_Cont)<>11583 OR $(vFIA_Deaths)<>26611 OR $(vFIA_Days)<>3133578 OR $(vFIA_Cents)<>65938464905 OR $(vFIA_Invalid)<>0 THEN
    TRACE [V5-FACT-AUDIT] VERDICT=BLOCKED_QVD_TOTAL_RECONCILIATION;
    EXIT SCRIPT;
ENDIF

// Period controls to prevent swapped years despite matching global totals.
P5FI_AUDIT_YEAR:
NOCONCATENATE LOAD
    Left(FATO_RD_COMPETENCIA_ORIGEM,4) AS _FI_AYR,
    Count(*) AS _FI_AROWS,
    Sum(QTD_INTERNACAO) AS _FI_ANEW,
    Sum(If(IDENT='5',1,0)) AS _FI_ACONT,
    Sum(INDICADOR_OBITO) AS _FI_ADEATHS,
    Sum(DIAS_PERMANENCIA) AS _FI_ADAYS,
    Sum(Round(VALOR_TOTAL*100,1)) AS _FI_ACENTS,
    Count(DISTINCT FATO_RD_COMPETENCIA_ORIGEM) AS _FI_AMONTHS
RESIDENT P5FI_AUDIT_FACT
GROUP BY Left(FATO_RD_COMPETENCIA_ORIGEM,4);

P5FI_AUDIT_YEAR_CHECK:
NOCONCATENATE LOAD
    If((_FI_AYR='2017' AND _FI_AROWS=187726 AND _FI_ANEW=183532
         AND _FI_ACONT=4194 AND _FI_ADEATHS=8626 AND _FI_ADAYS=1039396
         AND _FI_ACENTS=20888212074 AND _FI_AMONTHS=12)
      OR (_FI_AYR='2018' AND _FI_AROWS=187293 AND _FI_ANEW=183311
         AND _FI_ACONT=3982 AND _FI_ADEATHS=8649 AND _FI_ADAYS=1038921
         AND _FI_ACENTS=21826753676 AND _FI_AMONTHS=12)
      OR (_FI_AYR='2019' AND _FI_AROWS=191653 AND _FI_ANEW=188246
         AND _FI_ACONT=3407 AND _FI_ADEATHS=9336 AND _FI_ADAYS=1055261
         AND _FI_ACENTS=23223499155 AND _FI_AMONTHS=12),0,1) AS _FI_ABAD
RESIDENT P5FI_AUDIT_YEAR;
P5FI_AUDIT_YEAR_SUMMARY:
NOCONCATENATE LOAD Count(*) AS _FI_YCOUNT, Sum(_FI_ABAD) AS _FI_YBAD
RESIDENT P5FI_AUDIT_YEAR_CHECK;
LET vFIA_Years=Peek('_FI_YCOUNT',0,'P5FI_AUDIT_YEAR_SUMMARY');
LET vFIA_YearsBad=Peek('_FI_YBAD',0,'P5FI_AUDIT_YEAR_SUMMARY');
DROP TABLE P5FI_AUDIT_YEAR;
DROP TABLE P5FI_AUDIT_YEAR_CHECK;
DROP TABLE P5FI_AUDIT_YEAR_SUMMARY;
TRACE [V5-FACT-AUDIT] ANNUAL YEARS=$(vFIA_Years) BAD=$(vFIA_YearsBad);
IF ScriptErrorCount > $(vFIAuditErrStart) OR $(vFIA_Years)<>3 OR $(vFIA_YearsBad)<>0 THEN
    TRACE [V5-FACT-AUDIT] VERDICT=BLOCKED_QVD_ANNUAL_RECONCILIATION;
    EXIT SCRIPT;
ENDIF

DROP TABLE P5FI_AUDIT_FACT;
TRACE [V5-FACT-AUDIT] VERDICT=PASS_PHYSICAL_QVD_READBACK_CANDIDATE_ONLY;
TRACE [V5-FACT-AUDIT] LINK_TABLE_NOT_TESTED=True PRODUCTION_APPROVAL=False;
