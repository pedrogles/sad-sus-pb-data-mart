// Fase V — independent physical readback of persisted FATO_POPULACAO.qvd.
// Independent QVW: ONLY the physical fact QVD is loaded; never STORE.
// Does not construct a Link Table, denominators, filters, KPIs or dashboard.
SET ErrorMode=0;
LET vP5PopQvdAuditErrors=ScriptErrorCount;
TRACE [V5-POP-QVD-AUDIT] START_INDEPENDENT_QVD_REOPEN;

P5POP_AUDIT_FACT:
NOCONCATENATE LOAD *
FROM [QVD\FATO_POPULACAO.qvd] (qvd);
IF ScriptErrorCount > $(vP5PopQvdAuditErrors) THEN
    TRACE [V5-POP-QVD-AUDIT] VERDICT=BLOCKED_QVD_READ;
    EXIT SCRIPT;
ENDIF
LET vP5PopAuditRows=NoOfRows('P5POP_AUDIT_FACT');
LET vP5PopAuditFields=NoOfFields('P5POP_AUDIT_FACT');
TRACE [V5-POP-QVD-AUDIT] HEADER ROWS=$(vP5PopAuditRows) FIELDS=$(vP5PopAuditFields);
IF $(vP5PopAuditRows)<>669 OR $(vP5PopAuditFields)<>7 THEN
    TRACE [V5-POP-QVD-AUDIT] VERDICT=BLOCKED_QVD_HEADER;
    EXIT SCRIPT;
ENDIF

// Physical schema and column order exactly match the validated RAM projection.
P5POP_AUDIT_SCHEMA:
NOCONCATENATE LOAD * INLINE [
FIELD
%SK_MUNICIPIO
%SK_TEMPO_ANO
POPULACAO_ESTIMADA
FATO_POP_IBGE7_ORIGEM
FATO_POP_DATASUS6_REFERENCIA_PB
FATO_POP_ANO_ORIGEM
FATO_POP_ARQUIVO_ORIGEM
];
FOR vP5PopAuditI=0 TO 6
    LET vP5PopAuditPos=$(vP5PopAuditI)+1;
    LET vP5PopAuditField=FieldName($(vP5PopAuditPos),'P5POP_AUDIT_FACT');
    LET vP5PopAuditExpected=Peek('FIELD',$(vP5PopAuditI),'P5POP_AUDIT_SCHEMA');
    IF '$(vP5PopAuditField)' <> '$(vP5PopAuditExpected)' THEN
        TRACE [V5-POP-QVD-AUDIT] VERDICT=BLOCKED_SCHEMA_FIELD POSITION=$(vP5PopAuditPos) ACTUAL=$(vP5PopAuditField) EXPECTED=$(vP5PopAuditExpected);
        EXIT SCRIPT;
    ENDIF
NEXT
DROP TABLE P5POP_AUDIT_SCHEMA;
TRACE [V5-POP-QVD-AUDIT] SCHEMA_EXACT_7=True;

// Audit physical records without loading source staging or dimension QVDs.
// Recalculate each dimension SK from persisted provenance, check the natural grain.
P5POP_AUDIT_PROFILE:
NOCONCATENATE LOAD
    Count(*) AS _P5PA_ROWS,
    Count(DISTINCT FATO_POP_IBGE7_ORIGEM & '|' & FATO_POP_ANO_ORIGEM) AS _P5PA_GRAIN,
    Count(DISTINCT Text([%SK_MUNICIPIO]) & '|' & Text([%SK_TEMPO_ANO])) AS _P5PA_SK_PAIRS,
    Count(DISTINCT FATO_POP_IBGE7_ORIGEM) AS _P5PA_MUNICIPIOS,
    Count(DISTINCT FATO_POP_ANO_ORIGEM) AS _P5PA_YEARS,
    Count(DISTINCT FATO_POP_ARQUIVO_ORIGEM) AS _P5PA_FILES,
    Sum(If(IsNull([%SK_MUNICIPIO]) OR IsNull([%SK_TEMPO_ANO])
        OR IsNull(POPULACAO_ESTIMADA) OR IsNull(FATO_POP_IBGE7_ORIGEM)
        OR IsNull(FATO_POP_DATASUS6_REFERENCIA_PB)
        OR IsNull(FATO_POP_ANO_ORIGEM) OR IsNull(FATO_POP_ARQUIVO_ORIGEM),1,0)) AS _P5PA_NULL,
    Sum(If([%SK_MUNICIPIO]<>Hash128('MUN',FATO_POP_DATASUS6_REFERENCIA_PB)
        OR [%SK_TEMPO_ANO]<>Hash128('ANO',Num#(FATO_POP_ANO_ORIGEM)),1,0)) AS _P5PA_BAD_SK,
    Sum(If(Len(Trim(Text(FATO_POP_IBGE7_ORIGEM)))<>7
        OR Len(KeepChar(Text(FATO_POP_IBGE7_ORIGEM),'0123456789'))<>7
        OR Left(Text(FATO_POP_IBGE7_ORIGEM),2)<>'25'
        OR Len(Trim(Text(FATO_POP_DATASUS6_REFERENCIA_PB)))<>6
        OR Len(KeepChar(Text(FATO_POP_DATASUS6_REFERENCIA_PB),'0123456789'))<>6
        OR Left(Text(FATO_POP_IBGE7_ORIGEM),6)<>Text(FATO_POP_DATASUS6_REFERENCIA_PB)
        OR Match(Text(FATO_POP_ANO_ORIGEM),'2017','2018','2019')=0
        OR Len(Trim(Text(FATO_POP_ARQUIVO_ORIGEM)))=0,1,0)) AS _P5PA_BAD_DOMAIN,
    Sum(If(NOT IsNum(POPULACAO_ESTIMADA) OR POPULACAO_ESTIMADA<=0
        OR POPULACAO_ESTIMADA<>Round(POPULACAO_ESTIMADA,1),1,0)) AS _P5PA_BAD_MEASURE
RESIDENT P5POP_AUDIT_FACT;
LET vP5PArows=Peek('_P5PA_ROWS',0,'P5POP_AUDIT_PROFILE');
LET vP5PAgrain=Peek('_P5PA_GRAIN',0,'P5POP_AUDIT_PROFILE');
LET vP5PApairs=Peek('_P5PA_SK_PAIRS',0,'P5POP_AUDIT_PROFILE');
LET vP5PAmun=Peek('_P5PA_MUNICIPIOS',0,'P5POP_AUDIT_PROFILE');
LET vP5PAyears=Peek('_P5PA_YEARS',0,'P5POP_AUDIT_PROFILE');
LET vP5PAfiles=Peek('_P5PA_FILES',0,'P5POP_AUDIT_PROFILE');
LET vP5PAnull=Peek('_P5PA_NULL',0,'P5POP_AUDIT_PROFILE');
LET vP5PAsk=Peek('_P5PA_BAD_SK',0,'P5POP_AUDIT_PROFILE');
LET vP5PAdomain=Peek('_P5PA_BAD_DOMAIN',0,'P5POP_AUDIT_PROFILE');
LET vP5PAmeasure=Peek('_P5PA_BAD_MEASURE',0,'P5POP_AUDIT_PROFILE');
DROP TABLE P5POP_AUDIT_PROFILE;
TRACE [V5-POP-QVD-AUDIT] TOTAL ROWS=$(vP5PArows) GRAIN=$(vP5PAgrain) SK_PAIRS=$(vP5PApairs) MUNICIPIOS=$(vP5PAmun) YEARS=$(vP5PAyears) FILES=$(vP5PAfiles) NULL=$(vP5PAnull) BAD_SK=$(vP5PAsk) BAD_DOMAIN=$(vP5PAdomain) BAD_MEASURE=$(vP5PAmeasure);
IF ScriptErrorCount > $(vP5PopQvdAuditErrors) OR $(vP5PArows)<>669 OR $(vP5PAgrain)<>669 OR $(vP5PApairs)<>669 OR $(vP5PAmun)<>223 OR $(vP5PAyears)<>3 OR $(vP5PAfiles)<>3 OR $(vP5PAnull)<>0 OR $(vP5PAsk)<>0 OR $(vP5PAdomain)<>0 OR $(vP5PAmeasure)<>0 THEN
    TRACE [V5-POP-QVD-AUDIT] VERDICT=BLOCKED_PHYSICAL_RECONCILIATION;
    EXIT SCRIPT;
ENDIF

// Three year snapshots: 223 municipalities and one source file each.
// This is control arithmetic, NEVER a recommendation to sum population over years.
P5POP_AUDIT_BY_YEAR:
NOCONCATENATE LOAD
    FATO_POP_ANO_ORIGEM AS _P5PA_YEAR,
    Count(*) AS _P5PA_YR_ROWS,
    Count(DISTINCT FATO_POP_IBGE7_ORIGEM) AS _P5PA_YR_MUN,
    Count(DISTINCT FATO_POP_ARQUIVO_ORIGEM) AS _P5PA_YR_FILE,
    Sum(POPULACAO_ESTIMADA) AS _P5PA_YR_POP
RESIDENT P5POP_AUDIT_FACT
GROUP BY FATO_POP_ANO_ORIGEM;
P5POP_AUDIT_BY_YEAR_FLAGS:
NOCONCATENATE LOAD
    If(_P5PA_YR_ROWS<>223 OR _P5PA_YR_MUN<>223 OR _P5PA_YR_FILE<>1
        OR Match(_P5PA_YEAR,'2017','2018','2019')=0
        OR (_P5PA_YEAR='2017' AND _P5PA_YR_POP<>4025558)
        OR (_P5PA_YEAR='2018' AND _P5PA_YR_POP<>3996496)
        OR (_P5PA_YEAR='2019' AND _P5PA_YR_POP<>4018127),1,0) AS _P5PA_YEAR_BAD
RESIDENT P5POP_AUDIT_BY_YEAR;
P5POP_AUDIT_YEAR_TOTAL:
NOCONCATENATE LOAD
    Count(*) AS _P5PA_YEAR_GROUPS,
    Sum(_P5PA_YEAR_BAD) AS _P5PA_YEAR_BAD_TOTAL
RESIDENT P5POP_AUDIT_BY_YEAR_FLAGS;
LET vP5PAyearGroups=Peek('_P5PA_YEAR_GROUPS',0,'P5POP_AUDIT_YEAR_TOTAL');
LET vP5PAyearBad=Peek('_P5PA_YEAR_BAD_TOTAL',0,'P5POP_AUDIT_YEAR_TOTAL');
DROP TABLE P5POP_AUDIT_YEAR_TOTAL;
DROP TABLE P5POP_AUDIT_BY_YEAR_FLAGS;
DROP TABLE P5POP_AUDIT_BY_YEAR;
TRACE [V5-POP-QVD-AUDIT] ANNUAL GROUPS=$(vP5PAyearGroups) BAD=$(vP5PAyearBad) POP2017=4025558 POP2018=3996496 POP2019=4018127;
IF ScriptErrorCount > $(vP5PopQvdAuditErrors) OR $(vP5PAyearGroups)<>3 OR $(vP5PAyearBad)<>0 THEN
    TRACE [V5-POP-QVD-AUDIT] VERDICT=BLOCKED_ANNUAL_RECONCILIATION;
    EXIT SCRIPT;
ENDIF

DROP TABLE P5POP_AUDIT_FACT;
TRACE [V5-POP-QVD-AUDIT] VERDICT=PASS_PHYSICAL_QVD_READBACK_CANDIDATE_ONLY;
TRACE [V5-POP-QVD-AUDIT] LINK_TABLE_NOT_TESTED=True PRODUCTION_APPROVED=False;
