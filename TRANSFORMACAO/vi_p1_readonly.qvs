// SAD VI-P1 — READ-ONLY physical association candidate. NOT APPROVED.
// All LOADs read existing QVDs. Only disposable QVW/log in %TEMP% is written by PowerShell.
// This does not modify facts, generate LINK_ANALISE.qvd or implement KPIs.
SET ErrorMode=0;
LET vP1StartErr=ScriptErrorCount;
TRACE [P1] START READ_ONLY_FACT_QVD_AND_STAGING_RECONCILIATION;

P1_FI_FACT_KEYS:
NOCONCATENATE LOAD
  SK_REGISTRO_INTERNACAO AS _FI_FACT_ID,
  [%LINK_KEY] AS _FI_FACT_LINK
FROM [__FI_QVD__] (qvd);
P1_FI_MAP: MAPPING LOAD _FI_FACT_ID, _FI_FACT_LINK RESIDENT P1_FI_FACT_KEYS;
IF ScriptErrorCount>$(vP1StartErr) OR NoOfRows('P1_FI_FACT_KEYS')<>566672 THEN
 TRACE [P1] VERDICT=BLOCKED_RD_FACT_READ; EXIT SCRIPT;
ENDIF

// Rebuild exact 17-field RD original row fingerprint and five coordinates.
P1_FI_SOURCE:
NOCONCATENATE LOAD
 Hash128('RD',
   Text(_META_SOURCE_FILE),Text(ANO_CMPT),Text(MES_CMPT),
   Text(N_AIH),Text(IDENT),Text(MUNIC_RES),Text(MUNIC_MOV),
   Text(CNES),Text(PROC_SOLIC),Text(PROC_REA),Text(DIAG_PRINC),
   Text(CAR_INT),Text(COBRANCA),Text(DT_INTER),Text(DT_SAIDA),
   Text(DIAS_PERM),Text(VAL_TOT),Text(MORTE)) AS _FI_ID,
 Hash128('MES',Text(Date(Date#(Trim(Text(_META_SOURCE_COMPETENCE)),'YYYYMM'),'YYYYMM'))) AS _FI_C,
 Hash128('ANO',Num#(Trim(Text(ANO_CMPT)),'####','.',',')) AS _FI_Y,
 Hash128('MUN',Trim(Text(MUNIC_RES))) AS _FI_R,
 Hash128('MUN',Trim(Text(MUNIC_MOV))) AS _FI_S,
 Hash128('ESTAB',Trim(Text(CNES)),Trim(Text(_META_SOURCE_COMPETENCE))) AS _FI_E
FROM [__RD_QVD__] (qvd);
IF ScriptErrorCount>$(vP1StartErr) OR NoOfRows('P1_FI_SOURCE')<>566672 THEN
 TRACE [P1] VERDICT=BLOCKED_RD_STAGE_READ; EXIT SCRIPT;
ENDIF
P1_FI_COORD:
NOCONCATENATE LOAD
 _FI_ID,_FI_C,_FI_Y,_FI_R,_FI_S,_FI_E,
 Hash128('SAD-LINK-V1',
 'C=' & If(IsNull(_FI_C),'N','V' & Len(Text(_FI_C)) & ':' & Text(_FI_C)),
 'Y=' & If(IsNull(_FI_Y),'N','V' & Len(Text(_FI_Y)) & ':' & Text(_FI_Y)),
 'R=' & If(IsNull(_FI_R),'N','V' & Len(Text(_FI_R)) & ':' & Text(_FI_R)),
 'S=' & If(IsNull(_FI_S),'N','V' & Len(Text(_FI_S)) & ':' & Text(_FI_S)),
 'E=' & If(IsNull(_FI_E),'N','V' & Len(Text(_FI_E)) & ':' & Text(_FI_E))
 ) AS _FI_EXPECT,
 ApplyMap('P1_FI_MAP',_FI_ID,'#NO_FACT#') AS _FI_ACTUAL
RESIDENT P1_FI_SOURCE;
DROP TABLE P1_FI_SOURCE;
P1_FI_CHECK:
NOCONCATENATE LOAD
 Count(*) AS _ROWS,
 Count(DISTINCT _FI_ID) AS _UNIQUE_SOURCE,
 Count(DISTINCT _FI_EXPECT) AS _DISTINCT_LINKS,
 Sum(If(IsNull(_FI_ID) OR IsNull(_FI_C) OR IsNull(_FI_Y) OR IsNull(_FI_R)
  OR IsNull(_FI_S) OR IsNull(_FI_E) OR IsNull(_FI_EXPECT)
  OR _FI_ACTUAL='#NO_FACT#' OR _FI_ACTUAL<>_FI_EXPECT,1,0)) AS _BAD
RESIDENT P1_FI_COORD;
LET vP1FIRows=Peek('_ROWS',0,'P1_FI_CHECK');
LET vP1FIUnique=Peek('_UNIQUE_SOURCE',0,'P1_FI_CHECK');
LET vP1FILinks=Peek('_DISTINCT_LINKS',0,'P1_FI_CHECK');
LET vP1FIBad=Peek('_BAD',0,'P1_FI_CHECK');
DROP TABLE P1_FI_CHECK;
DROP TABLE P1_FI_FACT_KEYS;
TRACE [P1] RD_ROWS=$(vP1FIRows) RD_SOURCE_UNIQUE=$(vP1FIUnique) RD_LINKS=$(vP1FILinks) RD_BAD=$(vP1FIBad);
IF ScriptErrorCount>$(vP1StartErr) OR $(vP1FIRows)<>566672 OR $(vP1FIUnique)<>566672 OR $(vP1FILinks)<>77550 OR $(vP1FIBad)<>0 THEN
 TRACE [P1] VERDICT=BLOCKED_RD_PHYSICAL_LINK_RECONCILIATION; EXIT SCRIPT;
ENDIF

P1_LT_FACT_KEYS:
NOCONCATENATE LOAD
 SK_REGISTRO_CAPACIDADE_LEITO AS _LT_FACT_ID,
 [%LINK_KEY] AS _LT_FACT_LINK
FROM [__LT_FACT_QVD__] (qvd);
P1_LT_MAP: MAPPING LOAD _LT_FACT_ID, _LT_FACT_LINK RESIDENT P1_LT_FACT_KEYS;
IF ScriptErrorCount>$(vP1StartErr) OR NoOfRows('P1_LT_FACT_KEYS')<>35518 THEN
 TRACE [P1] VERDICT=BLOCKED_LT_FACT_READ; EXIT SCRIPT;
ENDIF
P1_LT_SOURCE:
NOCONCATENATE LOAD
 Hash128('LT',Trim(Text(CNES)),Text(COMPETEN),Text(CODLEITO)) AS _LT_ID,
 Hash128('MES',Text(Date(Date#(Text(COMPETEN),'YYYYMM'),'YYYYMM'))) AS _LT_C,
 Hash128('ANO',Num#(Left(Text(COMPETEN),4),'####','.',',')) AS _LT_Y,
 Hash128('MUN',Trim(Text(CODUFMUN))) AS _LT_S,
 Hash128('ESTAB',Trim(Text(CNES)),Trim(Text(COMPETEN))) AS _LT_E
FROM [__LT_STAGE_QVD__] (qvd);
IF ScriptErrorCount>$(vP1StartErr) OR NoOfRows('P1_LT_SOURCE')<>35518 THEN
 TRACE [P1] VERDICT=BLOCKED_LT_STAGE_READ; EXIT SCRIPT;
ENDIF
P1_LT_COORD:
NOCONCATENATE LOAD
 _LT_ID,_LT_C,_LT_Y,_LT_S,_LT_E,
 Hash128('SAD-LINK-V1',
 'C=' & If(IsNull(_LT_C),'N','V' & Len(Text(_LT_C)) & ':' & Text(_LT_C)),
 'Y=' & If(IsNull(_LT_Y),'N','V' & Len(Text(_LT_Y)) & ':' & Text(_LT_Y)),
 'R=N',
 'S=' & If(IsNull(_LT_S),'N','V' & Len(Text(_LT_S)) & ':' & Text(_LT_S)),
 'E=' & If(IsNull(_LT_E),'N','V' & Len(Text(_LT_E)) & ':' & Text(_LT_E))
 ) AS _LT_EXPECT,
 ApplyMap('P1_LT_MAP',_LT_ID,'#NO_FACT#') AS _LT_ACTUAL
RESIDENT P1_LT_SOURCE;
DROP TABLE P1_LT_SOURCE;
P1_LT_CHECK:
NOCONCATENATE LOAD
 Count(*) AS _ROWS,
 Count(DISTINCT _LT_ID) AS _UNIQUE_SOURCE,
 Count(DISTINCT _LT_EXPECT) AS _DISTINCT_LINKS,
 Sum(If(IsNull(_LT_ID) OR IsNull(_LT_C) OR IsNull(_LT_Y) OR IsNull(_LT_S)
  OR IsNull(_LT_E) OR IsNull(_LT_EXPECT) OR _LT_ACTUAL='#NO_FACT#'
  OR _LT_ACTUAL<>_LT_EXPECT,1,0)) AS _BAD
RESIDENT P1_LT_COORD;
LET vP1LTRows=Peek('_ROWS',0,'P1_LT_CHECK');
LET vP1LTUnique=Peek('_UNIQUE_SOURCE',0,'P1_LT_CHECK');
LET vP1LTLinks=Peek('_DISTINCT_LINKS',0,'P1_LT_CHECK');
LET vP1LTBad=Peek('_BAD',0,'P1_LT_CHECK');
DROP TABLE P1_LT_CHECK;
DROP TABLE P1_LT_FACT_KEYS;
TRACE [P1] LT_ROWS=$(vP1LTRows) LT_SOURCE_UNIQUE=$(vP1LTUnique) LT_LINKS=$(vP1LTLinks) LT_BAD=$(vP1LTBad);
IF ScriptErrorCount>$(vP1StartErr) OR $(vP1LTRows)<>35518 OR $(vP1LTUnique)<>35518 OR $(vP1LTLinks)<>7486 OR $(vP1LTBad)<>0 THEN
 TRACE [P1] VERDICT=BLOCKED_LT_PHYSICAL_LINK_RECONCILIATION; EXIT SCRIPT;
ENDIF

// Population: derive a temporary hash from the persisted two-dimensional keys.
// Does NOT persist a link field back into FATO_POPULACAO.qvd.
P1_POP_KEYS:
NOCONCATENATE LOAD
 [%SK_MUNICIPIO] AS _POP_M,
 [%SK_TEMPO_ANO] AS _POP_Y,
 POPULACAO_ESTIMADA AS _POP_VALUE,
 FATO_POP_DATASUS6_REFERENCIA_PB AS _POP_CODE,
 FATO_POP_ANO_ORIGEM AS _POP_YEAR
FROM [__POP_QVD__] (qvd);
IF ScriptErrorCount>$(vP1StartErr) OR NoOfRows('P1_POP_KEYS')<>669 THEN
 TRACE [P1] VERDICT=BLOCKED_POP_FACT_READ; EXIT SCRIPT;
ENDIF
P1_POP_COORD:
NOCONCATENATE LOAD
 _POP_M,_POP_Y,_POP_VALUE,_POP_CODE,_POP_YEAR,
 Hash128('SAD-LINK-V1', 'C=N',
 'Y=' & If(IsNull(_POP_Y),'N','V' & Len(Text(_POP_Y)) & ':' & Text(_POP_Y)),
 'R=' & If(IsNull(_POP_M),'N','V' & Len(Text(_POP_M)) & ':' & Text(_POP_M)),
 'S=' & If(IsNull(_POP_M),'N','V' & Len(Text(_POP_M)) & ':' & Text(_POP_M)),
 'E=N') AS _POP_EXPECT
RESIDENT P1_POP_KEYS;
DROP TABLE P1_POP_KEYS;
P1_POP_CHECK:
NOCONCATENATE LOAD
 Count(*) AS _ROWS,
 Count(DISTINCT _POP_CODE & '|' & _POP_YEAR) AS _GRAIN,
 Count(DISTINCT _POP_EXPECT) AS _DISTINCT_LINKS,
 Sum(If(IsNull(_POP_M) OR IsNull(_POP_Y) OR IsNull(_POP_EXPECT)
  OR _POP_M<>Hash128('MUN',_POP_CODE)
  OR _POP_Y<>Hash128('ANO',Num#(_POP_YEAR)),1,0)) AS _BAD
RESIDENT P1_POP_COORD;
LET vP1POPRows=Peek('_ROWS',0,'P1_POP_CHECK');
LET vP1POPGrain=Peek('_GRAIN',0,'P1_POP_CHECK');
LET vP1POPLinks=Peek('_DISTINCT_LINKS',0,'P1_POP_CHECK');
LET vP1POPBad=Peek('_BAD',0,'P1_POP_CHECK');
DROP TABLE P1_POP_CHECK;
TRACE [P1] POP_ROWS=$(vP1POPRows) POP_GRAIN=$(vP1POPGrain) POP_LINKS=$(vP1POPLinks) POP_BAD=$(vP1POPBad);
IF ScriptErrorCount>$(vP1StartErr) OR $(vP1POPRows)<>669 OR $(vP1POPGrain)<>669 OR $(vP1POPLinks)<>669 OR $(vP1POPBad)<>0 THEN
 TRACE [P1] VERDICT=BLOCKED_POP_PHYSICAL_LINK_PROJECTION; EXIT SCRIPT;
ENDIF

// All three QVD facts have now been independently checked against input coordinates.
P1_LINK_COORDS:
NOCONCATENATE LOAD
 _FI_EXPECT AS [%LINK_KEY], _FI_C AS [%SK_TEMPO_COMPETENCIA],
 _FI_Y AS [%SK_TEMPO_ANO], _FI_R AS [%SK_MUNICIPIO_RESIDENCIA],
 _FI_S AS [%SK_MUNICIPIO_SERVICO], _FI_E AS [%SK_ESTABELECIMENTO]
RESIDENT P1_FI_COORD;
CONCATENATE (P1_LINK_COORDS)
LOAD
 _LT_EXPECT AS [%LINK_KEY], _LT_C AS [%SK_TEMPO_COMPETENCIA],
 _LT_Y AS [%SK_TEMPO_ANO], Null() AS [%SK_MUNICIPIO_RESIDENCIA],
 _LT_S AS [%SK_MUNICIPIO_SERVICO], _LT_E AS [%SK_ESTABELECIMENTO]
RESIDENT P1_LT_COORD;
CONCATENATE (P1_LINK_COORDS)
LOAD
 _POP_EXPECT AS [%LINK_KEY], Null() AS [%SK_TEMPO_COMPETENCIA],
 _POP_Y AS [%SK_TEMPO_ANO], _POP_M AS [%SK_MUNICIPIO_RESIDENCIA],
 _POP_M AS [%SK_MUNICIPIO_SERVICO], Null() AS [%SK_ESTABELECIMENTO]
RESIDENT P1_POP_COORD;

P1_LINK_SIMULADA:
NOCONCATENATE LOAD DISTINCT * RESIDENT P1_LINK_COORDS;
DROP TABLE P1_LINK_COORDS;
LET vP1LinkRows=NoOfRows('P1_LINK_SIMULADA');
TRACE [P1] LINK_SIMULADA_ROWS=$(vP1LinkRows) EXPECTED=85705;
IF ScriptErrorCount>$(vP1StartErr) OR $(vP1LinkRows)<>85705 THEN
 TRACE [P1] VERDICT=BLOCKED_LINK_COORD_DEDUP; EXIT SCRIPT;
ENDIF

// Simulated facts. Carry only the intended %LINK_KEY across these tables.
P1_FATO_RD:
NOCONCATENATE LOAD [%LINK_KEY],SK_REGISTRO_INTERNACAO AS P1_RD_ID,
 QTD_INTERNACAO AS P1_QTD_INTERNACAO
FROM [__FI_QVD__] (qvd);
P1_FATO_LT:
NOCONCATENATE LOAD [%LINK_KEY],SK_REGISTRO_CAPACIDADE_LEITO AS P1_LT_ID,
 QTD_LEITOS_SUS AS P1_QTD_LEITOS_SUS
FROM [__LT_FACT_QVD__] (qvd);
P1_FATO_POP:
NOCONCATENATE LOAD _POP_EXPECT AS [%LINK_KEY],
 _POP_CODE AS P1_POP_CODE, _POP_VALUE AS P1_POPULACAO
RESIDENT P1_POP_COORD;

DROP TABLE P1_FI_COORD;
DROP TABLE P1_LT_COORD;
DROP TABLE P1_POP_COORD;

// Conformed dimensions physically projected into independent role aliases.
P1_DIM_COMP:
NOCONCATENATE LOAD DISTINCT [%SK_TEMPO_COMPETENCIA],
 TEMPO_COMPETENCIA AS P1_COMPETENCIA
FROM [__TEMPO_QVD__] (qvd);
P1_DIM_ANO:
NOCONCATENATE LOAD DISTINCT [%SK_TEMPO_ANO],
 TEMPO_ANO AS P1_ANO
FROM [__TEMPO_QVD__] (qvd);
P1_DIM_RES:
NOCONCATENATE LOAD [%SK_MUNICIPIO] AS [%SK_MUNICIPIO_RESIDENCIA],
 COD_DATASUS_6 AS P1_RES_CODE
FROM [__MUN_QVD__] (qvd);
P1_DIM_SERV:
NOCONCATENATE LOAD [%SK_MUNICIPIO] AS [%SK_MUNICIPIO_SERVICO],
 COD_DATASUS_6 AS P1_SERV_CODE
FROM [__MUN_QVD__] (qvd);
P1_DIM_EST:
NOCONCATENATE LOAD [%SK_ESTABELECIMENTO],
 CNES AS P1_EST_CNES, COMPETENCIA AS P1_EST_COMPETENCIA
FROM [__EST_QVD__] (qvd);

// Evaluate table shape only AFTER scratch maps and profiling tables are dropped.
LET vP1TableCount=NoOfTables();
LET vP1SynCount=0;
FOR vP1i=0 TO $(vP1TableCount)-1
 LET vP1name=TableName($(vP1i));
 IF SubStringCount('$(vP1name)','$Syn')>0 THEN
  LET vP1SynCount=$(vP1SynCount)+1;
 ENDIF
NEXT
TRACE [P1] FINAL_MODEL TABLES=$(vP1TableCount) SYNTHETIC=$(vP1SynCount);
IF ScriptErrorCount>$(vP1StartErr) OR $(vP1TableCount)<>9 OR $(vP1SynCount)<>0 OR NoOfRows('P1_FATO_RD')<>566672 OR NoOfRows('P1_FATO_LT')<>35518 OR NoOfRows('P1_FATO_POP')<>669 THEN
 TRACE [P1] VERDICT=BLOCKED_TEMPORARY_MODEL_STRUCTURE; EXIT SCRIPT;
ENDIF
TRACE [P1] VERDICT=PASS_PHYSICAL_KEYS_AND_TEMPORARY_MODEL_NOT_FINAL;
TRACE [P1] LINK_ANALISE_QVD_GENERATED=False PRODUCTION_APPROVED=False;
