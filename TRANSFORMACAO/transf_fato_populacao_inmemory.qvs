// FASE V — FATO_POPULACAO in-memory candidate, isolated QlikView 12 only.
// Explicitly NOT a physical QVD, final link-table association, or production approval.
// Grano aprovado: IBGE municipio × ano. Populacao anual e semi-aditiva no tempo.
// Input PB DATASUS6 must be looked up via validated III-C5.2 bridge; NEVER invent IBGE7.
LET vP5PopImplStartErrors=ScriptErrorCount;
IF '$(vP5PopImplMode)' <> 'PREFLIGHT' THEN
    TRACE [V5-POP-FACT] VERDICT=BLOCKED_MODE_ONLY_PREFLIGHT_ALLOWED;
    EXIT SCRIPT;
ENDIF
TRACE [V5-POP-FACT] START MODE=PREFLIGHT FACT_IN_MEMORY_ONLY=True;

// Use ONLY the four QVDs already audited by population preflight R2 (PR #93).
P5PIM_BRIDGE_MAP:
MAPPING LOAD
    'I|' & Trim(Text(COD_IBGE_7)) AS _P5PIM_BRIDGE_IBGE7,
    Trim(Text(COD_DATASUS_6)) AS _P5PIM_BRIDGE_DATASUS6
FROM [..\EXTRACAO\QVD\REF_MUNICIPIO_PB_DERIVADA.qvd] (qvd);
P5PIM_MUNICIPIO_MAP:
MAPPING LOAD
    'M|' & Trim(Text(COD_DATASUS_6)) AS _P5PIM_DIM_CODE6,
    [%SK_MUNICIPIO] AS _P5PIM_DIM_SK
FROM [QVD\DIM_MUNICIPIO.qvd] (qvd)
WHERE Trim(Text(MUNICIPIO_COBERTURA))='PB_COM_REFERENCIA_IBGE';
P5PIM_YEAR_MAP:
MAPPING LOAD DISTINCT
    'Y|' & Trim(Text(TEMPO_ANO)) AS _P5PIM_DIM_YEAR,
    [%SK_TEMPO_ANO] AS _P5PIM_DIM_YEAR_SK
FROM [QVD\DIM_TEMPO.qvd] (qvd)
WHERE Match(Trim(Text(TEMPO_ANO)),'2017','2018','2019')>0;
IF ScriptErrorCount > $(vP5PopImplStartErrors) THEN
    TRACE [V5-POP-FACT] VERDICT=BLOCKED_DIMENSION_AND_BRIDGE_LOAD;
    EXIT SCRIPT;
ENDIF

P5PIM_SOURCE:
NOCONCATENATE LOAD
    Trim(Text(COD_IBGE_7)) AS _P5PIM_IBGE7,
    Trim(Text(ANO_REFERENCIA)) AS _P5PIM_YEAR,
    Trim(Text(UF)) AS _P5PIM_UF,
    Trim(Text(COD_UF_IBGE_2)) AS _P5PIM_UF2,
    Trim(Text(COD_MUNIC_IBGE_5)) AS _P5PIM_MUN5,
    POPULACAO_ESTIMADA AS _P5PIM_POP,
    Trim(Text(_META_SOURCE_FILE)) AS _P5PIM_FILE,
    Trim(Text(_META_SOURCE_YEAR)) AS _P5PIM_META_YEAR,
    Trim(Text(_META_SOURCE_FAMILY)) AS _P5PIM_FAMILY
FROM [..\EXTRACAO\QVD\SRC_IBGE_POPULACAO.qvd] (qvd);
IF ScriptErrorCount > $(vP5PopImplStartErrors) OR NoOfRows('P5PIM_SOURCE')<>669 THEN
    TRACE [V5-POP-FACT] VERDICT=BLOCKED_SOURCE_OR_ROW_COUNT;
    EXIT SCRIPT;
ENDIF

// Mapping is read-only and cannot fabricate a code: missing maps return sentinels/null.
P5PIM_RESOLVED:
NOCONCATENATE LOAD
    _P5PIM_IBGE7,
    _P5PIM_YEAR,
    _P5PIM_UF,
    _P5PIM_UF2,
    _P5PIM_MUN5,
    _P5PIM_POP,
    _P5PIM_FILE,
    _P5PIM_META_YEAR,
    _P5PIM_FAMILY,
    ApplyMap('P5PIM_BRIDGE_MAP','I|' & _P5PIM_IBGE7,'#NO_BRIDGE#') AS _P5PIM_DATASUS6,
    ApplyMap('P5PIM_MUNICIPIO_MAP','M|' &
        ApplyMap('P5PIM_BRIDGE_MAP','I|' & _P5PIM_IBGE7,'#NO_BRIDGE#'),Null()) AS _P5PIM_SK_MUN,
    ApplyMap('P5PIM_YEAR_MAP','Y|' & _P5PIM_YEAR,Null()) AS _P5PIM_SK_ANO
RESIDENT P5PIM_SOURCE;
IF ScriptErrorCount > $(vP5PopImplStartErrors) OR NoOfRows('P5PIM_RESOLVED')<>669 THEN
    TRACE [V5-POP-FACT] VERDICT=BLOCKED_RESOLUTION_LOAD;
    EXIT SCRIPT;
ENDIF

P5PIM_STAGE_PROFILE:
NOCONCATENATE LOAD
    Count(*) AS _P5PIM_STAGE_ROWS,
    Count(DISTINCT _P5PIM_IBGE7 & '|' & _P5PIM_YEAR) AS _P5PIM_STAGE_GRAIN,
    Count(DISTINCT _P5PIM_IBGE7) AS _P5PIM_STAGE_MUNICIPIOS,
    Count(DISTINCT _P5PIM_YEAR) AS _P5PIM_STAGE_YEARS,
    Count(DISTINCT _P5PIM_FILE) AS _P5PIM_STAGE_FILES,
    Sum(If(_P5PIM_DATASUS6='#NO_BRIDGE#'
        OR IsNull(_P5PIM_SK_MUN) OR IsNull(_P5PIM_SK_ANO),1,0)) AS _P5PIM_STAGE_MISS,
    Sum(If(IsNull(_P5PIM_IBGE7) OR IsNull(_P5PIM_YEAR)
        OR Len(_P5PIM_IBGE7)<>7 OR Len(KeepChar(_P5PIM_IBGE7,'0123456789'))<>7
        OR Left(_P5PIM_IBGE7,2)<>'25' OR Len(_P5PIM_DATASUS6)<>6
        OR Left(_P5PIM_IBGE7,6)<>_P5PIM_DATASUS6
        OR Match(_P5PIM_YEAR,'2017','2018','2019')=0
        OR _P5PIM_UF<>'PB' OR _P5PIM_UF2<>'25'
        OR _P5PIM_IBGE7<>_P5PIM_UF2 & _P5PIM_MUN5
        OR IsNull(_P5PIM_FILE) OR Len(_P5PIM_FILE)=0
        OR _P5PIM_META_YEAR<>_P5PIM_YEAR OR _P5PIM_FAMILY<>'IBGE_POPULACAO',1,0)) AS _P5PIM_STAGE_DOMAIN_BAD,
    Sum(If(NOT IsNum(_P5PIM_POP) OR _P5PIM_POP<=0
        OR _P5PIM_POP<>Round(_P5PIM_POP,1),1,0)) AS _P5PIM_STAGE_MEASURE_BAD,
    Sum(If(_P5PIM_SK_MUN<>Hash128('MUN',_P5PIM_DATASUS6)
        OR _P5PIM_SK_ANO<>Hash128('ANO',Num#(_P5PIM_YEAR)),1,0)) AS _P5PIM_STAGE_SK_BAD
RESIDENT P5PIM_RESOLVED;
LET vP5PIMStageRows=Peek('_P5PIM_STAGE_ROWS',0,'P5PIM_STAGE_PROFILE');
LET vP5PIMStageGrain=Peek('_P5PIM_STAGE_GRAIN',0,'P5PIM_STAGE_PROFILE');
LET vP5PIMStageMun=Peek('_P5PIM_STAGE_MUNICIPIOS',0,'P5PIM_STAGE_PROFILE');
LET vP5PIMStageYears=Peek('_P5PIM_STAGE_YEARS',0,'P5PIM_STAGE_PROFILE');
LET vP5PIMStageFiles=Peek('_P5PIM_STAGE_FILES',0,'P5PIM_STAGE_PROFILE');
LET vP5PIMStageMiss=Peek('_P5PIM_STAGE_MISS',0,'P5PIM_STAGE_PROFILE');
LET vP5PIMStageDomain=Peek('_P5PIM_STAGE_DOMAIN_BAD',0,'P5PIM_STAGE_PROFILE');
LET vP5PIMStageMeasure=Peek('_P5PIM_STAGE_MEASURE_BAD',0,'P5PIM_STAGE_PROFILE');
LET vP5PIMStageSK=Peek('_P5PIM_STAGE_SK_BAD',0,'P5PIM_STAGE_PROFILE');
DROP TABLE P5PIM_STAGE_PROFILE;
TRACE [V5-POP-FACT] SOURCE ROWS=$(vP5PIMStageRows) GRAIN=$(vP5PIMStageGrain) MUNICIPIOS=$(vP5PIMStageMun) YEARS=$(vP5PIMStageYears) FILES=$(vP5PIMStageFiles) MISS=$(vP5PIMStageMiss) BAD_DOMAIN=$(vP5PIMStageDomain) BAD_MEASURE=$(vP5PIMStageMeasure) BAD_SK=$(vP5PIMStageSK);
IF ScriptErrorCount > $(vP5PopImplStartErrors) OR $(vP5PIMStageRows)<>669 OR $(vP5PIMStageGrain)<>669 OR $(vP5PIMStageMun)<>223 OR $(vP5PIMStageYears)<>3 OR $(vP5PIMStageFiles)<>3 OR $(vP5PIMStageMiss)<>0 OR $(vP5PIMStageDomain)<>0 OR $(vP5PIMStageMeasure)<>0 OR $(vP5PIMStageSK)<>0 THEN
    TRACE [V5-POP-FACT] VERDICT=BLOCKED_SOURCE_RECONCILIATION;
    EXIT SCRIPT;
ENDIF

// Candidate table: two conformed SKs, annual measure, four auditable source fields.
// No %LINK_KEY yet: inter-fact contract has NOT been approved.
FATO_POPULACAO:
NOCONCATENATE LOAD
    _P5PIM_SK_MUN AS [%SK_MUNICIPIO],
    _P5PIM_SK_ANO AS [%SK_TEMPO_ANO],
    _P5PIM_POP AS POPULACAO_ESTIMADA,
    _P5PIM_IBGE7 AS FATO_POP_IBGE7_ORIGEM,
    _P5PIM_DATASUS6 AS FATO_POP_DATASUS6_REFERENCIA_PB,
    _P5PIM_YEAR AS FATO_POP_ANO_ORIGEM,
    _P5PIM_FILE AS FATO_POP_ARQUIVO_ORIGEM
RESIDENT P5PIM_RESOLVED;
IF ScriptErrorCount > $(vP5PopImplStartErrors) OR NoOfRows('FATO_POPULACAO')<>669 OR NoOfFields('FATO_POPULACAO')<>7 THEN
    TRACE [V5-POP-FACT] VERDICT=BLOCKED_FACT_PROJECTION_OR_SCHEMA;
    EXIT SCRIPT;
ENDIF

P5PIM_OUTPUT_PROFILE:
NOCONCATENATE LOAD
    Count(*) AS _P5PIM_OUT_ROWS,
    Count(DISTINCT FATO_POP_IBGE7_ORIGEM & '|' & FATO_POP_ANO_ORIGEM) AS _P5PIM_OUT_GRAIN,
    Count(DISTINCT Text([%SK_MUNICIPIO]) & '|' & Text([%SK_TEMPO_ANO])) AS _P5PIM_OUT_SK_PAIRS,
    Count(DISTINCT FATO_POP_IBGE7_ORIGEM) AS _P5PIM_OUT_MUNICIPIOS,
    Count(DISTINCT FATO_POP_ANO_ORIGEM) AS _P5PIM_OUT_YEARS,
    Count(DISTINCT FATO_POP_ARQUIVO_ORIGEM) AS _P5PIM_OUT_FILES,
    Sum(If(IsNull([%SK_MUNICIPIO]) OR IsNull([%SK_TEMPO_ANO])
        OR IsNull(POPULACAO_ESTIMADA) OR IsNull(FATO_POP_IBGE7_ORIGEM)
        OR IsNull(FATO_POP_DATASUS6_REFERENCIA_PB)
        OR IsNull(FATO_POP_ANO_ORIGEM) OR IsNull(FATO_POP_ARQUIVO_ORIGEM),1,0)) AS _P5PIM_OUT_NULL,
    Sum(If([%SK_MUNICIPIO]<>Hash128('MUN',FATO_POP_DATASUS6_REFERENCIA_PB)
        OR [%SK_TEMPO_ANO]<>Hash128('ANO',Num#(FATO_POP_ANO_ORIGEM)),1,0)) AS _P5PIM_OUT_BAD_SK
RESIDENT FATO_POPULACAO;
LET vP5PIMOutRows=Peek('_P5PIM_OUT_ROWS',0,'P5PIM_OUTPUT_PROFILE');
LET vP5PIMOutGrain=Peek('_P5PIM_OUT_GRAIN',0,'P5PIM_OUTPUT_PROFILE');
LET vP5PIMOutSKPairs=Peek('_P5PIM_OUT_SK_PAIRS',0,'P5PIM_OUTPUT_PROFILE');
LET vP5PIMOutMun=Peek('_P5PIM_OUT_MUNICIPIOS',0,'P5PIM_OUTPUT_PROFILE');
LET vP5PIMOutYears=Peek('_P5PIM_OUT_YEARS',0,'P5PIM_OUTPUT_PROFILE');
LET vP5PIMOutFiles=Peek('_P5PIM_OUT_FILES',0,'P5PIM_OUTPUT_PROFILE');
LET vP5PIMOutNull=Peek('_P5PIM_OUT_NULL',0,'P5PIM_OUTPUT_PROFILE');
LET vP5PIMOutBadSK=Peek('_P5PIM_OUT_BAD_SK',0,'P5PIM_OUTPUT_PROFILE');
DROP TABLE P5PIM_OUTPUT_PROFILE;
TRACE [V5-POP-FACT] OUTPUT ROWS=$(vP5PIMOutRows) GRAIN=$(vP5PIMOutGrain) SK_PAIRS=$(vP5PIMOutSKPairs) MUNICIPIOS=$(vP5PIMOutMun) YEARS=$(vP5PIMOutYears) FILES=$(vP5PIMOutFiles) NULL=$(vP5PIMOutNull) BAD_SK=$(vP5PIMOutBadSK) FIELDS=7;
IF ScriptErrorCount > $(vP5PopImplStartErrors) OR $(vP5PIMOutRows)<>669 OR $(vP5PIMOutGrain)<>669 OR $(vP5PIMOutSKPairs)<>669 OR $(vP5PIMOutMun)<>223 OR $(vP5PIMOutYears)<>3 OR $(vP5PIMOutFiles)<>3 OR $(vP5PIMOutNull)<>0 OR $(vP5PIMOutBadSK)<>0 THEN
    TRACE [V5-POP-FACT] VERDICT=BLOCKED_OUTPUT_INTEGRITY;
    EXIT SCRIPT;
ENDIF

P5PIM_YEAR:
NOCONCATENATE LOAD
    FATO_POP_ANO_ORIGEM AS _P5PIM_YEAR_GROUP,
    Count(*) AS _P5PIM_YEAR_ROWS,
    Count(DISTINCT FATO_POP_IBGE7_ORIGEM) AS _P5PIM_YEAR_MUN,
    Count(DISTINCT FATO_POP_ARQUIVO_ORIGEM) AS _P5PIM_YEAR_FILE,
    Sum(POPULACAO_ESTIMADA) AS _P5PIM_YEAR_POP
RESIDENT FATO_POPULACAO
GROUP BY FATO_POP_ANO_ORIGEM;
P5PIM_YEAR_FLAGS:
NOCONCATENATE LOAD
    If(_P5PIM_YEAR_ROWS<>223 OR _P5PIM_YEAR_MUN<>223 OR _P5PIM_YEAR_FILE<>1
        OR Match(_P5PIM_YEAR_GROUP,'2017','2018','2019')=0
        OR (_P5PIM_YEAR_GROUP='2017' AND _P5PIM_YEAR_POP<>4025558)
        OR (_P5PIM_YEAR_GROUP='2018' AND _P5PIM_YEAR_POP<>3996496)
        OR (_P5PIM_YEAR_GROUP='2019' AND _P5PIM_YEAR_POP<>4018127),1,0) AS _P5PIM_YEAR_BAD
RESIDENT P5PIM_YEAR;
P5PIM_YEAR_PROFILE:
NOCONCATENATE LOAD
    Count(*) AS _P5PIM_YEARS,
    Sum(_P5PIM_YEAR_BAD) AS _P5PIM_YEAR_BAD
RESIDENT P5PIM_YEAR_FLAGS;
LET vP5PIMYearGroups=Peek('_P5PIM_YEARS',0,'P5PIM_YEAR_PROFILE');
LET vP5PIMYearBad=Peek('_P5PIM_YEAR_BAD',0,'P5PIM_YEAR_PROFILE');
DROP TABLE P5PIM_YEAR_PROFILE;
DROP TABLE P5PIM_YEAR_FLAGS;
DROP TABLE P5PIM_YEAR;
TRACE [V5-POP-FACT] ANNUAL GROUPS=$(vP5PIMYearGroups) BAD=$(vP5PIMYearBad) POP2017=4025558 POP2018=3996496 POP2019=4018127;
IF ScriptErrorCount > $(vP5PopImplStartErrors) OR $(vP5PIMYearGroups)<>3 OR $(vP5PIMYearBad)<>0 THEN
    TRACE [V5-POP-FACT] VERDICT=BLOCKED_ANNUAL_RECONCILIATION;
    EXIT SCRIPT;
ENDIF
DROP TABLE P5PIM_RESOLVED;
DROP TABLE P5PIM_SOURCE;
TRACE [V5-POP-FACT] VERDICT=PASS_IN_MEMORY_CANDIDATE_ONLY_NOT_QVD_APPROVED;
TRACE [V5-POP-FACT] FACT_POPULACAO_QVD_GENERATED=False LINK_ANALISE_QVD_GENERATED=False PRODUCTION_APPROVED=False;
