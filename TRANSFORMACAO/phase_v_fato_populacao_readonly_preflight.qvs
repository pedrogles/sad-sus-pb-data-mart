// Fase V — POPULATION (IBGE) ONLY: read-only QlikView 12 preflight.
// NO FATO_POPULACAO projection, NO STORE, NO LINK_KEY and NO main TRANSF execution.
// Only existing QVDs: SRC_IBGE_POPULACAO, REF_MUNICIPIO_PB_DERIVADA,
// DIM_MUNICIPIO and DIM_TEMPO. All links/roles remain candidates.
LET vP5PStartErrors=ScriptErrorCount;
IF '$(vP5PopMode)' <> 'PREFLIGHT' THEN
    TRACE [V5-POP-PREFLIGHT] VERDICT=BLOCKED_UNAUTHORIZED_MODE;
    EXIT SCRIPT;
ENDIF
TRACE [V5-POP-PREFLIGHT] START MODE=PREFLIGHT READ_ONLY=True;

// Extract only real columns in the IBGE staging contract (Phase III).
P5P_SRC:
NOCONCATENATE LOAD
    Trim(Text(COD_IBGE_7)) AS _P5P_IBGE7,
    Trim(Text(ANO_REFERENCIA)) AS _P5P_YEAR,
    Trim(Text(UF)) AS _P5P_UF,
    Trim(Text(COD_UF_IBGE_2)) AS _P5P_UF2,
    Trim(Text(COD_MUNIC_IBGE_5)) AS _P5P_MUN5,
    POPULACAO_ESTIMADA AS _P5P_POP,
    Trim(Text(_META_SOURCE_FILE)) AS _P5P_FILE,
    Trim(Text(_META_SOURCE_FAMILY)) AS _P5P_FAMILY,
    Trim(Text(_META_SOURCE_YEAR)) AS _P5P_META_YEAR
FROM [..\EXTRACAO\QVD\SRC_IBGE_POPULACAO.qvd] (qvd);
IF ScriptErrorCount > $(vP5PStartErrors) OR NoOfRows('P5P_SRC')<>669 THEN
    TRACE [V5-POP-PREFLIGHT] VERDICT=BLOCKED_STAGING_LOAD;
    EXIT SCRIPT;
ENDIF

// Validated, project-derived PB reference already materialized in Phase III-C5.2.
// Code DATASUS6 must come from this QVD, never manufactured from IBGE7.
P5P_BRIDGE:
NOCONCATENATE LOAD
    Trim(Text(COD_IBGE_7)) AS _P5P_B7,
    Trim(Text(COD_DATASUS_6)) AS _P5P_B6,
    Trim(Text(UF)) AS _P5P_BUF,
    Trim(Text(NATUREZA_REFERENCIA)) AS _P5P_NATURE
FROM [..\EXTRACAO\QVD\REF_MUNICIPIO_PB_DERIVADA.qvd] (qvd);
P5P_DIM_MUN:
NOCONCATENATE LOAD
    Trim(Text(COD_IBGE_7)) AS _P5P_D7,
    Trim(Text(COD_DATASUS_6)) AS _P5P_D6,
    [%SK_MUNICIPIO] AS _P5P_DSK,
    Trim(Text(MUNICIPIO_COBERTURA)) AS _P5P_DCOV
FROM [QVD\DIM_MUNICIPIO.qvd] (qvd)
WHERE Trim(Text(MUNICIPIO_COBERTURA))='PB_COM_REFERENCIA_IBGE';
P5P_DIM_YEAR:
NOCONCATENATE LOAD DISTINCT
    Trim(Text(TEMPO_ANO)) AS _P5P_Y,
    [%SK_TEMPO_ANO] AS _P5P_YSK
FROM [QVD\DIM_TEMPO.qvd] (qvd)
WHERE Match(Trim(Text(TEMPO_ANO)),'2017','2018','2019')>0;
IF ScriptErrorCount > $(vP5PStartErrors) OR NoOfRows('P5P_BRIDGE')<>223 OR NoOfRows('P5P_DIM_MUN')<>223 OR NoOfRows('P5P_DIM_YEAR')<>3 THEN
    TRACE [V5-POP-PREFLIGHT] VERDICT=BLOCKED_REFERENCE_OR_DIM_LOAD;
    EXIT SCRIPT;
ENDIF

P5P_BRIDGE_PROFILE:
NOCONCATENATE LOAD
    Count(*) AS _P5P_BR_ROWS,
    Count(DISTINCT _P5P_B7) AS _P5P_BR_U7,
    Count(DISTINCT _P5P_B6) AS _P5P_BR_U6,
    Sum(If(IsNull(_P5P_B7) OR IsNull(_P5P_B6) OR
        Len(_P5P_B7)<>7 OR Len(KeepChar(_P5P_B7,'0123456789'))<>7 OR
        Len(_P5P_B6)<>6 OR Len(KeepChar(_P5P_B6,'0123456789'))<>6 OR
        Left(_P5P_B7,6)<>_P5P_B6 OR
        Left(_P5P_B7,2)<>'25' OR _P5P_BUF<>'PB' OR
        _P5P_NATURE<>'DERIVADA_PROJETO_DADOS_OFICIAIS_IBGE',1,0)) AS _P5P_BR_BAD
RESIDENT P5P_BRIDGE;
LET vP5PBridgeRows=Peek('_P5P_BR_ROWS',0,'P5P_BRIDGE_PROFILE');
LET vP5PBridgeU7=Peek('_P5P_BR_U7',0,'P5P_BRIDGE_PROFILE');
LET vP5PBridgeU6=Peek('_P5P_BR_U6',0,'P5P_BRIDGE_PROFILE');
LET vP5PBridgeBad=Peek('_P5P_BR_BAD',0,'P5P_BRIDGE_PROFILE');
DROP TABLE P5P_BRIDGE_PROFILE;

P5P_DIM_PROFILE:
NOCONCATENATE LOAD
    Count(*) AS _P5P_D_ROWS,
    Count(DISTINCT _P5P_D7) AS _P5P_D_U7,
    Count(DISTINCT _P5P_D6) AS _P5P_D_U6,
    Count(DISTINCT _P5P_DSK) AS _P5P_D_USK,
    Sum(If(IsNull(_P5P_D7) OR IsNull(_P5P_D6) OR IsNull(_P5P_DSK) OR
        Len(_P5P_D7)<>7 OR Len(_P5P_D6)<>6 OR
        _P5P_DCOV<>'PB_COM_REFERENCIA_IBGE' OR
        _P5P_DSK<>Hash128('MUN',_P5P_D6),1,0)) AS _P5P_D_BAD
RESIDENT P5P_DIM_MUN;
LET vP5PDimRows=Peek('_P5P_D_ROWS',0,'P5P_DIM_PROFILE');
LET vP5PDimU7=Peek('_P5P_D_U7',0,'P5P_DIM_PROFILE');
LET vP5PDimU6=Peek('_P5P_D_U6',0,'P5P_DIM_PROFILE');
LET vP5PDimUSK=Peek('_P5P_D_USK',0,'P5P_DIM_PROFILE');
LET vP5PDimBad=Peek('_P5P_D_BAD',0,'P5P_DIM_PROFILE');
DROP TABLE P5P_DIM_PROFILE;

P5P_YEAR_PROFILE:
NOCONCATENATE LOAD
    Count(*) AS _P5P_T_ROWS,
    Count(DISTINCT _P5P_Y) AS _P5P_T_UYEAR,
    Count(DISTINCT _P5P_YSK) AS _P5P_T_USK,
    Sum(If(IsNull(_P5P_Y) OR IsNull(_P5P_YSK) OR
        Match(_P5P_Y,'2017','2018','2019')=0 OR
        _P5P_YSK<>Hash128('ANO',Num#(_P5P_Y)),1,0)) AS _P5P_T_BAD
RESIDENT P5P_DIM_YEAR;
LET vP5PYearRows=Peek('_P5P_T_ROWS',0,'P5P_YEAR_PROFILE');
LET vP5PYearUYear=Peek('_P5P_T_UYEAR',0,'P5P_YEAR_PROFILE');
LET vP5PYearUSK=Peek('_P5P_T_USK',0,'P5P_YEAR_PROFILE');
LET vP5PYearBad=Peek('_P5P_T_BAD',0,'P5P_YEAR_PROFILE');
DROP TABLE P5P_YEAR_PROFILE;
TRACE [V5-POP-PREFLIGHT] REFERENCES BRIDGE=$(vP5PBridgeRows) BRIDGE_U7=$(vP5PBridgeU7) BRIDGE_U6=$(vP5PBridgeU6) BRIDGE_BAD=$(vP5PBridgeBad) DIM_MUN=$(vP5PDimRows) DIM_U7=$(vP5PDimU7) DIM_U6=$(vP5PDimU6) DIM_USK=$(vP5PDimUSK) DIM_BAD=$(vP5PDimBad) YEAR=$(vP5PYearRows) YEAR_U=$(vP5PYearUYear) YEAR_SK=$(vP5PYearUSK) YEAR_BAD=$(vP5PYearBad);
IF ScriptErrorCount > $(vP5PStartErrors) OR $(vP5PBridgeRows)<>223 OR $(vP5PBridgeU7)<>223 OR $(vP5PBridgeU6)<>223 OR $(vP5PBridgeBad)<>0 OR $(vP5PDimRows)<>223 OR $(vP5PDimU7)<>223 OR $(vP5PDimU6)<>223 OR $(vP5PDimUSK)<>223 OR $(vP5PDimBad)<>0 OR $(vP5PYearRows)<>3 OR $(vP5PYearUYear)<>3 OR $(vP5PYearUSK)<>3 OR $(vP5PYearBad)<>0 THEN
    TRACE [V5-POP-PREFLIGHT] VERDICT=BLOCKED_REFERENCE_PROFILES;
    EXIT SCRIPT;
ENDIF

P5P_BRIDGE_MAP:
MAPPING LOAD 'I|' & _P5P_B7, _P5P_B6 RESIDENT P5P_BRIDGE;
P5P_DIM_BY_6:
MAPPING LOAD 'D|' & _P5P_D6, _P5P_DSK RESIDENT P5P_DIM_MUN;
P5P_DIM_BY_7:
MAPPING LOAD 'I|' & _P5P_D7, _P5P_DSK RESIDENT P5P_DIM_MUN;
P5P_YEAR_MAP:
MAPPING LOAD 'Y|' & _P5P_Y, _P5P_YSK RESIDENT P5P_DIM_YEAR;

// Compute only test flags. No physical fact or experimental %LINK_KEY.
P5P_FLAGS:
NOCONCATENATE LOAD
    ApplyMap('P5P_BRIDGE_MAP','I|' & _P5P_IBGE7,'#NO_BRIDGE#') AS _P5P_RESOLVED6,
    If(ApplyMap('P5P_BRIDGE_MAP','I|' & _P5P_IBGE7,'#NO_BRIDGE#')='#NO_BRIDGE#',1,0) AS _P5P_MISS_BRIDGE,
    If(ApplyMap('P5P_DIM_BY_6','D|' & ApplyMap('P5P_BRIDGE_MAP','I|' & _P5P_IBGE7,'#NO_BRIDGE#'),'#NO_DIM6#')='#NO_DIM6#',1,0) AS _P5P_MISS_DIM6,
    If(ApplyMap('P5P_DIM_BY_7','I|' & _P5P_IBGE7,'#NO_DIM7#')='#NO_DIM7#',1,0) AS _P5P_MISS_DIM7,
    If(ApplyMap('P5P_YEAR_MAP','Y|' & _P5P_YEAR,'#NO_YEAR#')='#NO_YEAR#',1,0) AS _P5P_MISS_YEAR,
    If(ApplyMap('P5P_DIM_BY_6','D|' & ApplyMap('P5P_BRIDGE_MAP','I|' & _P5P_IBGE7,'#NO_BRIDGE#'),'#NO_DIM6#')<>
        ApplyMap('P5P_DIM_BY_7','I|' & _P5P_IBGE7,'#NO_DIM7#') OR
        ApplyMap('P5P_DIM_BY_7','I|' & _P5P_IBGE7,'#NO_DIM7#')<>
        Hash128('MUN',ApplyMap('P5P_BRIDGE_MAP','I|' & _P5P_IBGE7,'#NO_BRIDGE#')),1,0) AS _P5P_BAD_ROLE_SK,
    If(IsNull(_P5P_IBGE7) OR IsNull(_P5P_YEAR) OR
        Len(_P5P_IBGE7)<>7 OR Len(KeepChar(_P5P_IBGE7,'0123456789'))<>7 OR
        Left(_P5P_IBGE7,2)<>'25' OR
        Match(_P5P_YEAR,'2017','2018','2019')=0 OR
        _P5P_UF<>'PB' OR _P5P_UF2<>'25' OR
        Len(_P5P_MUN5)<>5 OR
        _P5P_IBGE7<>_P5P_UF2 & _P5P_MUN5 OR
        IsNull(_P5P_FILE) OR Len(_P5P_FILE)=0 OR
        _P5P_FAMILY<>'IBGE_POPULACAO' OR _P5P_META_YEAR<>_P5P_YEAR,1,0) AS _P5P_BAD_SOURCE,
    If(NOT IsNum(_P5P_POP) OR _P5P_POP<=0 OR
        _P5P_POP<>Round(_P5P_POP,1),1,0) AS _P5P_BAD_POP
RESIDENT P5P_SRC;
IF ScriptErrorCount > $(vP5PStartErrors) OR NoOfRows('P5P_FLAGS')<>669 THEN
    TRACE [V5-POP-PREFLIGHT] VERDICT=BLOCKED_ROLE_FLAGS;
    EXIT SCRIPT;
ENDIF

P5P_SOURCE_PROFILE:
NOCONCATENATE LOAD
    Count(*) AS _P5P_SRC_ROWS,
    Count(DISTINCT _P5P_IBGE7 & '|' & _P5P_YEAR) AS _P5P_GRAIN,
    Count(DISTINCT _P5P_IBGE7) AS _P5P_U7,
    Count(DISTINCT _P5P_YEAR) AS _P5P_YEARS,
    Count(DISTINCT _P5P_FILE) AS _P5P_FILES
RESIDENT P5P_SRC;
P5P_FLAGS_PROFILE:
NOCONCATENATE LOAD
    Sum(_P5P_MISS_BRIDGE) AS _P5P_BRIDGE_MISS,
    Sum(_P5P_MISS_DIM6) AS _P5P_DIM6_MISS,
    Sum(_P5P_MISS_DIM7) AS _P5P_DIM7_MISS,
    Sum(_P5P_MISS_YEAR) AS _P5P_YEAR_MISS,
    Sum(_P5P_BAD_ROLE_SK) AS _P5P_ROLE_BAD,
    Sum(_P5P_BAD_SOURCE) AS _P5P_SOURCE_BAD,
    Sum(_P5P_BAD_POP) AS _P5P_POP_BAD
RESIDENT P5P_FLAGS;
LET vP5PRows=Peek('_P5P_SRC_ROWS',0,'P5P_SOURCE_PROFILE');
LET vP5PGrain=Peek('_P5P_GRAIN',0,'P5P_SOURCE_PROFILE');
LET vP5PU7=Peek('_P5P_U7',0,'P5P_SOURCE_PROFILE');
LET vP5PYears=Peek('_P5P_YEARS',0,'P5P_SOURCE_PROFILE');
LET vP5PFiles=Peek('_P5P_FILES',0,'P5P_SOURCE_PROFILE');
LET vP5PBridgeMiss=Peek('_P5P_BRIDGE_MISS',0,'P5P_FLAGS_PROFILE');
LET vP5PDim6Miss=Peek('_P5P_DIM6_MISS',0,'P5P_FLAGS_PROFILE');
LET vP5PDim7Miss=Peek('_P5P_DIM7_MISS',0,'P5P_FLAGS_PROFILE');
LET vP5PYearMiss=Peek('_P5P_YEAR_MISS',0,'P5P_FLAGS_PROFILE');
LET vP5PRoleBad=Peek('_P5P_ROLE_BAD',0,'P5P_FLAGS_PROFILE');
LET vP5PSourceBad=Peek('_P5P_SOURCE_BAD',0,'P5P_FLAGS_PROFILE');
LET vP5PPopBad=Peek('_P5P_POP_BAD',0,'P5P_FLAGS_PROFILE');
DROP TABLE P5P_FLAGS_PROFILE;
DROP TABLE P5P_SOURCE_PROFILE;
TRACE [V5-POP-PREFLIGHT] SOURCE ROWS=$(vP5PRows) GRAIN=$(vP5PGrain) IBGE7=$(vP5PU7) YEARS=$(vP5PYears) FILES=$(vP5PFiles) BAD_DOMAIN=$(vP5PSourceBad) BAD_MEASURE=$(vP5PPopBad);
TRACE [V5-POP-PREFLIGHT] ROLES BRIDGE_MISS=$(vP5PBridgeMiss) DIM6_MISS=$(vP5PDim6Miss) DIM7_MISS=$(vP5PDim7Miss) YEAR_MISS=$(vP5PYearMiss) SK_BAD=$(vP5PRoleBad);
IF ScriptErrorCount > $(vP5PStartErrors) OR $(vP5PRows)<>669 OR $(vP5PGrain)<>669 OR $(vP5PU7)<>223 OR $(vP5PYears)<>3 OR $(vP5PFiles)<>3 OR $(vP5PBridgeMiss)<>0 OR $(vP5PDim6Miss)<>0 OR $(vP5PDim7Miss)<>0 OR $(vP5PYearMiss)<>0 OR $(vP5PRoleBad)<>0 OR $(vP5PSourceBad)<>0 OR $(vP5PPopBad)<>0 THEN
    TRACE [V5-POP-PREFLIGHT] VERDICT=BLOCKED_SOURCE_OR_ROLES;
    EXIT SCRIPT;
ENDIF

P5P_ANNUAL:
NOCONCATENATE LOAD
    _P5P_YEAR AS _P5P_YEAR_GROUP,
    Count(*) AS _P5P_ROWS_YEAR,
    Count(DISTINCT _P5P_IBGE7) AS _P5P_UNIQUE_YEAR,
    Count(DISTINCT _P5P_FILE) AS _P5P_FILES_YEAR,
    Sum(_P5P_POP) AS _P5P_POP_YEAR
RESIDENT P5P_SRC GROUP BY _P5P_YEAR;
P5P_ANNUAL_CHECK:
NOCONCATENATE LOAD
    If(_P5P_ROWS_YEAR<>223 OR _P5P_UNIQUE_YEAR<>223 OR
        _P5P_FILES_YEAR<>1 OR
        Not Match(_P5P_YEAR_GROUP,'2017','2018','2019') OR
        (_P5P_YEAR_GROUP='2017' AND _P5P_POP_YEAR<>4025558) OR
        (_P5P_YEAR_GROUP='2018' AND _P5P_POP_YEAR<>3996496) OR
        (_P5P_YEAR_GROUP='2019' AND _P5P_POP_YEAR<>4018127),1,0) AS _P5P_YEAR_BAD
RESIDENT P5P_ANNUAL;
P5P_ANNUAL_PROFILE:
NOCONCATENATE LOAD Count(*) AS _P5P_YEAR_GROUPS,
    Sum(_P5P_YEAR_BAD) AS _P5P_YEAR_ERRORS
RESIDENT P5P_ANNUAL_CHECK;
LET vP5PYearGroups=Peek('_P5P_YEAR_GROUPS',0,'P5P_ANNUAL_PROFILE');
LET vP5PYearErrors=Peek('_P5P_YEAR_ERRORS',0,'P5P_ANNUAL_PROFILE');
DROP TABLE P5P_ANNUAL_PROFILE;
DROP TABLE P5P_ANNUAL_CHECK;
DROP TABLE P5P_ANNUAL;
TRACE [V5-POP-PREFLIGHT] ANNUAL GROUPS=$(vP5PYearGroups) BAD=$(vP5PYearErrors) POP2017=4025558 POP2018=3996496 POP2019=4018127;
IF ScriptErrorCount > $(vP5PStartErrors) OR $(vP5PYearGroups)<>3 OR $(vP5PYearErrors)<>0 THEN
    TRACE [V5-POP-PREFLIGHT] VERDICT=BLOCKED_ANNUAL_RECONCILIATION;
    EXIT SCRIPT;
ENDIF
DROP TABLE P5P_FLAGS;
DROP TABLE P5P_SRC;
DROP TABLE P5P_BRIDGE;
DROP TABLE P5P_DIM_MUN;
DROP TABLE P5P_DIM_YEAR;
TRACE [V5-POP-PREFLIGHT] VERDICT=PASS_SOURCE_ROLES_ONLY_NOT_FACT_APPROVAL;
TRACE [V5-POP-PREFLIGHT] FACT_POPULACAO_QVD_GENERATED=False LINK_TABLE_NOT_TESTED=True PRODUCTION_APPROVED=False;
