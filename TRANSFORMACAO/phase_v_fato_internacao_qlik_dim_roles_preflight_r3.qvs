// FASE V — R3 isolated QlikView 12 full 11-role SK coverage for FATO_INTERNACAO.
// No factual production writes. Nine MAPPING tables (QVD dimensions) and 566672 RD row flags.
// Associative aliases, Link Table and multi-fact %LINK_KEY are NOT built by this script.
// Time SK use R2-tested Date# + Date + Text conversion matching Fase IV date duality.
// MOT formula intentionally identical to R1; R1 one orphan vs R2 zero is UNRESOLVED.
SET ErrorMode=0;
LET vP5DimErrorsBefore = ScriptErrorCount;
TRACE [V5-RD-DIM3] START ONLY_READ_STAGING_AND_DIM_QVDS;

// Day calendar repeats month/year SK: DISTINCT yields the key domain only.
P5MAP_TIME_DATA:
MAPPING LOAD DISTINCT
    [%SK_TEMPO_DATA] AS _P5_MAP_SK,
    1 AS _P5_MAP_OK
FROM [QVD\DIM_TEMPO.qvd] (qvd);

P5MAP_TIME_MONTH:
MAPPING LOAD DISTINCT
    [%SK_TEMPO_COMPETENCIA] AS _P5_MAP_SK,
    1 AS _P5_MAP_OK
FROM [QVD\DIM_TEMPO.qvd] (qvd);

P5MAP_TIME_YEAR:
MAPPING LOAD DISTINCT
    [%SK_TEMPO_ANO] AS _P5_MAP_SK,
    1 AS _P5_MAP_OK
FROM [QVD\DIM_TEMPO.qvd] (qvd);

P5MAP_MUNICIPIO:
MAPPING LOAD DISTINCT
    [%SK_MUNICIPIO] AS _P5_MAP_SK,
    1 AS _P5_MAP_OK
FROM [QVD\DIM_MUNICIPIO.qvd] (qvd);

P5MAP_ESTAB:
MAPPING LOAD DISTINCT
    [%SK_ESTABELECIMENTO] AS _P5_MAP_SK,
    1 AS _P5_MAP_OK
FROM [QVD\DIM_ESTABELECIMENTO.qvd] (qvd);

P5MAP_PROC:
MAPPING LOAD DISTINCT
    [%SK_PROCEDIMENTO] AS _P5_MAP_SK,
    1 AS _P5_MAP_OK
FROM [QVD\DIM_PROCEDIMENTO.qvd] (qvd);

P5MAP_CID:
MAPPING LOAD DISTINCT
    [%SK_DIAGNOSTICO] AS _P5_MAP_SK,
    1 AS _P5_MAP_OK
FROM [QVD\DIM_DIAGNOSTICO.qvd] (qvd);

P5MAP_CAR:
MAPPING LOAD DISTINCT
    [%SK_CARATER_ATENDIMENTO] AS _P5_MAP_SK,
    1 AS _P5_MAP_OK
FROM [QVD\DIM_CARATER_ATENDIMENTO.qvd] (qvd);

P5MAP_MOT:
MAPPING LOAD DISTINCT
    [%SK_MOTIVO_SAIDA] AS _P5_MAP_SK,
    1 AS _P5_MAP_OK
FROM [QVD\DIM_MOTIVO_SAIDA_PERMANENCIA.qvd] (qvd);

IF ScriptErrorCount > $(vP5DimErrorsBefore) THEN
    TRACE [V5-RD-DIM3] VERDICT=BLOCKED_DIMENSION_MAP_QVD_LOAD;
    EXIT SCRIPT;
ENDIF

// Snapshot SIH/RD once, projecting flags only. Missing lookup has explicit default 0.
P5_RD_DIM_FLAGS:
NOCONCATENATE LOAD
    Text(ANO_CMPT) AS _P5_YEAR,
    Text(_META_SOURCE_COMPETENCE) AS _P5_COMP,
    If(Left(Trim(Text(MUNIC_RES)),2)<>'25',1,0) AS _P5_EXTERNAL,
    If(ApplyMap('P5MAP_TIME_MONTH', Hash128('MES',Text(Date(Date#(Trim(Text(_META_SOURCE_COMPETENCE)),'YYYYMM'),'YYYYMM'))), 0)=1,0,1) AS _P5_MISS_COMP,
    If(ApplyMap('P5MAP_TIME_YEAR', Hash128('ANO', Num#(Trim(Text(ANO_CMPT)), '####', '.', ',')), 0)=1,0,1) AS _P5_MISS_ANO,
    If(ApplyMap('P5MAP_TIME_DATA', Hash128('DATA',Text(Date(Date#(Trim(Text(DT_INTER)),'YYYYMMDD'),'YYYYMMDD'))), 0)=1,0,1) AS _P5_MISS_INTER,
    If(ApplyMap('P5MAP_TIME_DATA', Hash128('DATA',Text(Date(Date#(Trim(Text(DT_SAIDA)),'YYYYMMDD'),'YYYYMMDD'))), 0)=1,0,1) AS _P5_MISS_SAIDA,
    If(ApplyMap('P5MAP_MUNICIPIO', Hash128('MUN',Trim(Text(MUNIC_RES))), 0)=1,0,1) AS _P5_MISS_RES,
    If(ApplyMap('P5MAP_MUNICIPIO', Hash128('MUN',Trim(Text(MUNIC_MOV))), 0)=1,0,1) AS _P5_MISS_SERV,
    If(ApplyMap('P5MAP_ESTAB', Hash128('ESTAB',Trim(Text(CNES)),Trim(Text(_META_SOURCE_COMPETENCE))), 0)=1,0,1) AS _P5_MISS_ESTAB,
    If(ApplyMap('P5MAP_PROC', Hash128('PROC',Text(PROC_REA),Text(_META_SOURCE_COMPETENCE)), 0)=1,0,1) AS _P5_MISS_PROC,
    If(ApplyMap('P5MAP_CID', Hash128('CID10',Text(RTrim(Text(DIAG_PRINC)))), 0)=1,0,1) AS _P5_MISS_DIAG,
    If(ApplyMap('P5MAP_CAR', Hash128('CAR',Text(Right('00' & KeepChar(Text(CAR_INT),'0123456789'),2))), 0)=1,0,1) AS _P5_MISS_CAR,
    If(ApplyMap('P5MAP_MOT', Hash128('MOT',Text(Right('00' & KeepChar(Text(COBRANCA),'0123456789'),2))), 0)=1,0,1) AS _P5_MISS_MOT
FROM [..\EXTRACAO\QVD\SRC_SIH_RD.qvd] (qvd);

IF ScriptErrorCount > $(vP5DimErrorsBefore) THEN
    TRACE [V5-RD-DIM3] VERDICT=BLOCKED_RD_SK_PROJECTION;
    EXIT SCRIPT;
ENDIF
IF NoOfRows('P5_RD_DIM_FLAGS') <> 566672 THEN
    TRACE [V5-RD-DIM3] VERDICT=BLOCKED_RD_ROW_COUNT;
    EXIT SCRIPT;
ENDIF

P5_RD_DIM_PROFILE:
NOCONCATENATE LOAD
    Count(*) AS _P5_ROWS,
    Count(DISTINCT _P5_COMP) AS _P5_MONTHS,
    Sum(_P5_EXTERNAL) AS _P5_EXTERNAL_ROWS,
    Sum(_P5_MISS_COMP) AS _P5_MISS_COUNT_COMP,
    Sum(_P5_MISS_ANO) AS _P5_MISS_COUNT_ANO,
    Sum(_P5_MISS_INTER) AS _P5_MISS_COUNT_INTER,
    Sum(_P5_MISS_SAIDA) AS _P5_MISS_COUNT_SAIDA,
    Sum(_P5_MISS_RES) AS _P5_MISS_COUNT_RES,
    Sum(_P5_MISS_SERV) AS _P5_MISS_COUNT_SERV,
    Sum(_P5_MISS_ESTAB) AS _P5_MISS_COUNT_ESTAB,
    Sum(_P5_MISS_PROC) AS _P5_MISS_COUNT_PROC,
    Sum(_P5_MISS_DIAG) AS _P5_MISS_COUNT_DIAG,
    Sum(_P5_MISS_CAR) AS _P5_MISS_COUNT_CAR,
    Sum(_P5_MISS_MOT) AS _P5_MISS_COUNT_MOT
RESIDENT P5_RD_DIM_FLAGS;

IF ScriptErrorCount > $(vP5DimErrorsBefore) THEN
    TRACE [V5-RD-DIM3] VERDICT=BLOCKED_ROLE_PROFILE;
    EXIT SCRIPT;
ENDIF

LET vP5Rows = Peek('_P5_ROWS',0,'P5_RD_DIM_PROFILE');
LET vP5Months = Peek('_P5_MONTHS',0,'P5_RD_DIM_PROFILE');
LET vP5Ext = Peek('_P5_EXTERNAL_ROWS',0,'P5_RD_DIM_PROFILE');
LET vP5MissCOMP = Peek('_P5_MISS_COUNT_COMP',0,'P5_RD_DIM_PROFILE');
LET vP5MissANO = Peek('_P5_MISS_COUNT_ANO',0,'P5_RD_DIM_PROFILE');
LET vP5MissINTER = Peek('_P5_MISS_COUNT_INTER',0,'P5_RD_DIM_PROFILE');
LET vP5MissSAIDA = Peek('_P5_MISS_COUNT_SAIDA',0,'P5_RD_DIM_PROFILE');
LET vP5MissRES = Peek('_P5_MISS_COUNT_RES',0,'P5_RD_DIM_PROFILE');
LET vP5MissSERV = Peek('_P5_MISS_COUNT_SERV',0,'P5_RD_DIM_PROFILE');
LET vP5MissESTAB = Peek('_P5_MISS_COUNT_ESTAB',0,'P5_RD_DIM_PROFILE');
LET vP5MissPROC = Peek('_P5_MISS_COUNT_PROC',0,'P5_RD_DIM_PROFILE');
LET vP5MissDIAG = Peek('_P5_MISS_COUNT_DIAG',0,'P5_RD_DIM_PROFILE');
LET vP5MissCAR = Peek('_P5_MISS_COUNT_CAR',0,'P5_RD_DIM_PROFILE');
LET vP5MissMOT = Peek('_P5_MISS_COUNT_MOT',0,'P5_RD_DIM_PROFILE');

TRACE [V5-RD-DIM3] TOTAL ROWS=$(vP5Rows) MONTHS=$(vP5Months) EXTERNAL=$(vP5Ext) MISS_COMP=$(vP5MissCOMP) MISS_ANO=$(vP5MissANO) MISS_INTER=$(vP5MissINTER) MISS_SAIDA=$(vP5MissSAIDA) MISS_RES=$(vP5MissRES) MISS_SERV=$(vP5MissSERV) MISS_ESTAB=$(vP5MissESTAB) MISS_PROC=$(vP5MissPROC) MISS_DIAG=$(vP5MissDIAG) MISS_CAR=$(vP5MissCAR) MISS_MOT=$(vP5MissMOT);

IF $(vP5Rows) <> 566672 OR $(vP5Months) <> 36 OR $(vP5Ext) <> 5202 OR $(vP5MissCOMP) <> 0 OR $(vP5MissANO) <> 0 OR $(vP5MissINTER) <> 0 OR $(vP5MissSAIDA) <> 0 OR $(vP5MissRES) <> 0 OR $(vP5MissSERV) <> 0 OR $(vP5MissESTAB) <> 0 OR $(vP5MissPROC) <> 0 OR $(vP5MissDIAG) <> 0 OR $(vP5MissCAR) <> 0 OR $(vP5MissMOT) <> 0 THEN
    TRACE [V5-RD-DIM3] VERDICT=BLOCKED_DIMENSION_ROLE_SK_UNMATCHED;
    EXIT SCRIPT;
ENDIF

DROP TABLE P5_RD_DIM_PROFILE;
DROP TABLE P5_RD_DIM_FLAGS;
TRACE [V5-RD-DIM3] VERDICT=PASS_QV_STAGING_11_DIMENSION_ROLES_NO_ORPHANS;
TRACE [V5-RD-DIM3] FACT_QVD_GENERATED=False LINK_ANALISE_GENERATED=False OUTPUT_DATA_FILES_WRITTEN=0;
TRACE [V5-RD-DIM3] ROLEPLAY_ASSOCIATIVE_MODEL=NOT_TESTED LINK_KEY_GATE=NOT_EXECUTED;
