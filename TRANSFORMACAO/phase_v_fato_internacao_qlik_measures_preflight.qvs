// FASE V — READ-ONLY FATO_INTERNACAO measure reconciliation, isolated QVW.
// Fonte: EXTRACAO/QVD/SRC_SIH_RD.qvd, sem STORE, sem JOIN e sem novos QVDs.
// Baseline: tools/preflight_fato_internacao_medidas.py, 36 CSVs RD 2017-2019.
// O script NÃO deve ser incluido em TRANSFORMACAO/transf_main.qvs.

SET ErrorMode=0;
LET vV5MeasErrorStart = ScriptErrorCount;
TRACE [V5-RD-MEAS] START QVD_STAGING_READ_ONLY;

V5_RD_MEASURE_INPUT:
NOCONCATENATE LOAD
    Text(ANO_CMPT) AS _V5_YEAR,
    Text(IDENT) AS _V5_IDENT,
    Text(_META_SOURCE_COMPETENCE) AS _V5_COMPETENCE,
    Num(DIAS_PERM) AS _V5_DAYS,
    Num(VAL_TOT) AS _V5_VALUE,
    Num(MORTE) AS _V5_DEATH
FROM [..\EXTRACAO\QVD\SRC_SIH_RD.qvd] (qvd);

IF ScriptErrorCount > $(vV5MeasErrorStart) THEN
    TRACE [V5-RD-MEAS] VERDICT=BLOCKED_STAGING_QVD_READ_ERROR;
    EXIT SCRIPT;
ENDIF

IF NoOfRows('V5_RD_MEASURE_INPUT') <> 566672 THEN
    TRACE [V5-RD-MEAS] VERDICT=BLOCKED_RD_ROW_COUNT;
    EXIT SCRIPT;
ENDIF

V5_RD_MEASURE_YEAR:
NOCONCATENATE LOAD
    _V5_YEAR AS _V5_AGG_YEAR,
    Count(*) AS _V5_AGG_ROWS,
    Sum(If(_V5_IDENT='1',1,0)) AS _V5_AGG_NEW,
    Sum(If(_V5_IDENT='5',1,0)) AS _V5_AGG_CONT,
    Sum(If(_V5_DEATH=1,1,0)) AS _V5_AGG_DEATHS,
    Sum(_V5_DAYS) AS _V5_AGG_DAYS,
    Sum(Round(_V5_VALUE*100,1)) AS _V5_AGG_CENTS,
    Count(DISTINCT _V5_COMPETENCE) AS _V5_AGG_MONTHS,
    Sum(If(
        Match(_V5_IDENT,'1','5')=0
        OR NOT IsNum(_V5_DAYS)
        OR _V5_DAYS<0
        OR _V5_DAYS<>Round(_V5_DAYS,1)
        OR NOT IsNum(_V5_VALUE)
        OR _V5_VALUE<0
        OR Fabs(_V5_VALUE*100-Round(_V5_VALUE*100,1))>0.001
        OR NOT IsNum(_V5_DEATH)
        OR Match(Text(_V5_DEATH),'0','1')=0,
        1,0
    )) AS _V5_AGG_INVALID
RESIDENT V5_RD_MEASURE_INPUT
GROUP BY _V5_YEAR;

IF ScriptErrorCount > $(vV5MeasErrorStart) THEN
    TRACE [V5-RD-MEAS] VERDICT=BLOCKED_YEAR_AGGREGATION_ERROR;
    EXIT SCRIPT;
ENDIF

V5_RD_MEASURE_CHECK:
NOCONCATENATE LOAD
    _V5_AGG_YEAR AS _V5_OUT_YEAR,
    _V5_AGG_ROWS AS _V5_OUT_ROWS,
    _V5_AGG_NEW AS _V5_OUT_NEW,
    _V5_AGG_CONT AS _V5_OUT_CONT,
    _V5_AGG_DEATHS AS _V5_OUT_DEATHS,
    _V5_AGG_DAYS AS _V5_OUT_DAYS,
    _V5_AGG_CENTS AS _V5_OUT_CENTS,
    _V5_AGG_MONTHS AS _V5_OUT_MONTHS,
    _V5_AGG_INVALID AS _V5_OUT_INVALID,
    If(
       (_V5_AGG_YEAR='2017'
        AND _V5_AGG_ROWS=187726 AND _V5_AGG_NEW=183532
        AND _V5_AGG_CONT=4194 AND _V5_AGG_DEATHS=8626
        AND _V5_AGG_DAYS=1039396 AND _V5_AGG_CENTS=20888212074
        AND _V5_AGG_MONTHS=12 AND _V5_AGG_INVALID=0)
       OR
       (_V5_AGG_YEAR='2018'
        AND _V5_AGG_ROWS=187293 AND _V5_AGG_NEW=183311
        AND _V5_AGG_CONT=3982 AND _V5_AGG_DEATHS=8649
        AND _V5_AGG_DAYS=1038921 AND _V5_AGG_CENTS=21826753676
        AND _V5_AGG_MONTHS=12 AND _V5_AGG_INVALID=0)
       OR
       (_V5_AGG_YEAR='2019'
        AND _V5_AGG_ROWS=191653 AND _V5_AGG_NEW=188246
        AND _V5_AGG_CONT=3407 AND _V5_AGG_DEATHS=9336
        AND _V5_AGG_DAYS=1055261 AND _V5_AGG_CENTS=23223499155
        AND _V5_AGG_MONTHS=12 AND _V5_AGG_INVALID=0),
       0,1
    ) AS _V5_OUT_BAD
RESIDENT V5_RD_MEASURE_YEAR;

IF ScriptErrorCount > $(vV5MeasErrorStart) THEN
    TRACE [V5-RD-MEAS] VERDICT=BLOCKED_YEAR_VALIDATION_ERROR;
    EXIT SCRIPT;
ENDIF

IF NoOfRows('V5_RD_MEASURE_CHECK') <> 3 THEN
    TRACE [V5-RD-MEAS] VERDICT=BLOCKED_YEAR_COVERAGE;
    EXIT SCRIPT;
ENDIF

FOR vV5MeasIndex = 0 TO 2
    LET vV5MeasYear = Peek('_V5_OUT_YEAR',$(vV5MeasIndex),'V5_RD_MEASURE_CHECK');
    LET vV5MeasRows = Peek('_V5_OUT_ROWS',$(vV5MeasIndex),'V5_RD_MEASURE_CHECK');
    LET vV5MeasNew = Peek('_V5_OUT_NEW',$(vV5MeasIndex),'V5_RD_MEASURE_CHECK');
    LET vV5MeasCont = Peek('_V5_OUT_CONT',$(vV5MeasIndex),'V5_RD_MEASURE_CHECK');
    LET vV5MeasDeaths = Peek('_V5_OUT_DEATHS',$(vV5MeasIndex),'V5_RD_MEASURE_CHECK');
    LET vV5MeasDays = Peek('_V5_OUT_DAYS',$(vV5MeasIndex),'V5_RD_MEASURE_CHECK');
    LET vV5MeasCents = Peek('_V5_OUT_CENTS',$(vV5MeasIndex),'V5_RD_MEASURE_CHECK');
    LET vV5MeasBad = Peek('_V5_OUT_BAD',$(vV5MeasIndex),'V5_RD_MEASURE_CHECK');
    TRACE [V5-RD-MEAS] YEAR=$(vV5MeasYear) ROWS=$(vV5MeasRows) NEW=$(vV5MeasNew) CONT=$(vV5MeasCont) DEATHS=$(vV5MeasDeaths) DAYS=$(vV5MeasDays) VALUE_CENTS=$(vV5MeasCents) BAD=$(vV5MeasBad);
NEXT vV5MeasIndex

V5_RD_MEASURE_TOTAL:
NOCONCATENATE LOAD
    Sum(_V5_OUT_ROWS) AS _V5_SUM_ROWS,
    Sum(_V5_OUT_NEW) AS _V5_SUM_NEW,
    Sum(_V5_OUT_CONT) AS _V5_SUM_CONT,
    Sum(_V5_OUT_DEATHS) AS _V5_SUM_DEATHS,
    Sum(_V5_OUT_DAYS) AS _V5_SUM_DAYS,
    Sum(_V5_OUT_CENTS) AS _V5_SUM_CENTS,
    Sum(_V5_OUT_MONTHS) AS _V5_SUM_MONTHS,
    Sum(_V5_OUT_INVALID) AS _V5_SUM_INVALID,
    Sum(_V5_OUT_BAD) AS _V5_SUM_BAD
RESIDENT V5_RD_MEASURE_CHECK;

IF ScriptErrorCount > $(vV5MeasErrorStart) THEN
    TRACE [V5-RD-MEAS] VERDICT=BLOCKED_TOTAL_AGGREGATION_ERROR;
    EXIT SCRIPT;
ENDIF

LET vV5TotalRows = Peek('_V5_SUM_ROWS',0,'V5_RD_MEASURE_TOTAL');
LET vV5TotalNew = Peek('_V5_SUM_NEW',0,'V5_RD_MEASURE_TOTAL');
LET vV5TotalCont = Peek('_V5_SUM_CONT',0,'V5_RD_MEASURE_TOTAL');
LET vV5TotalDeaths = Peek('_V5_SUM_DEATHS',0,'V5_RD_MEASURE_TOTAL');
LET vV5TotalDays = Peek('_V5_SUM_DAYS',0,'V5_RD_MEASURE_TOTAL');
LET vV5TotalCents = Peek('_V5_SUM_CENTS',0,'V5_RD_MEASURE_TOTAL');
LET vV5TotalMonths = Peek('_V5_SUM_MONTHS',0,'V5_RD_MEASURE_TOTAL');
LET vV5TotalInvalid = Peek('_V5_SUM_INVALID',0,'V5_RD_MEASURE_TOTAL');
LET vV5TotalBad = Peek('_V5_SUM_BAD',0,'V5_RD_MEASURE_TOTAL');

TRACE [V5-RD-MEAS] TOTAL ROWS=$(vV5TotalRows) NEW=$(vV5TotalNew) CONT=$(vV5TotalCont) DEATHS=$(vV5TotalDeaths) DAYS=$(vV5TotalDays) VALUE_CENTS=$(vV5TotalCents) MONTHS=$(vV5TotalMonths) INVALID=$(vV5TotalInvalid) BAD=$(vV5TotalBad);

IF $(vV5TotalRows) <> 566672 OR $(vV5TotalNew) <> 555089 OR $(vV5TotalCont) <> 11583 OR $(vV5TotalDeaths) <> 26611 OR $(vV5TotalDays) <> 3133578 OR $(vV5TotalCents) <> 65938464905 OR $(vV5TotalMonths) <> 36 OR $(vV5TotalInvalid) <> 0 OR $(vV5TotalBad) <> 0 THEN
    TRACE [V5-RD-MEAS] VERDICT=BLOCKED_QVD_STAGING_MEASURES_MISMATCH;
    EXIT SCRIPT;
ENDIF

DROP TABLE V5_RD_MEASURE_TOTAL;
DROP TABLE V5_RD_MEASURE_CHECK;
DROP TABLE V5_RD_MEASURE_YEAR;
DROP TABLE V5_RD_MEASURE_INPUT;

TRACE [V5-RD-MEAS] VERDICT=PASS_QVD_STAGING_FIVE_MEASURES_RECONCILED;
TRACE [V5-RD-MEAS] FACT_QVD_GENERATED=False OUTPUT_DATA_FILES_WRITTEN=0;
