// SAD SUS PB — CNES ST/LT empirical key / TP_UNID discovery.
// Only candidate row-level co-occurrence. NOT proof of a hospital type historical domain.
// Script loaded ONLY through tools/inspecionar_cnes_st_lt_corpo_qlik.ps1.
// No JOIN / STORE / binary export / data-changing script operations.

LET vCNESPreErrors=ScriptErrorCount;

CNES_ST_ROWS:
LOAD
    Text(CNES) AS ST_CNES,
    Text(COMPETEN) AS ST_COMPETEN,
    Text(TP_UNID) AS ST_TP_UNID,
    If(IsNull(TP_UNID) OR Len(Trim(Text(TP_UNID)))=0,'(EMPTY_OR_NULL)',Text(TP_UNID)) AS ST_TP_LABEL,
    Text(CODUFMUN) AS ST_CODUFMUN,
    Text(CNES) & '|' & Text(COMPETEN) AS ST_PAIR
FROM [__ST_QVD_ABSOLUTE__] (qvd);

CNES_LT_ROWS:
LOAD
    Text(CNES) AS LT_CNES,
    Text(COMPETEN) AS LT_COMPETEN,
    Text(CODUFMUN) AS LT_CODUFMUN,
    Text(CNES) & '|' & Text(COMPETEN) AS LT_PAIR
FROM [__LT_QVD_ABSOLUTE__] (qvd);

LET vCNESST=NoOfRows('CNES_ST_ROWS');
LET vCNESLT=NoOfRows('CNES_LT_ROWS');
IF $(vCNESST)<>220390 OR $(vCNESLT)<>35518 THEN
    TRACE [CNES-KEY] VERDICT=BLOCKED_BASELINE_ROW_COUNT;
    EXIT SCRIPT;
ENDIF

CNES_ST_PAIR_GROUP:
NOCONCATENATE LOAD
    ST_PAIR AS ST_GROUP_PAIR,
    Count(ST_CNES) AS ST_GROUP_ROWS,
    Count(DISTINCT ST_TP_UNID) AS ST_GROUP_TP_VARIANTS
RESIDENT CNES_ST_ROWS
GROUP BY ST_PAIR;

CNES_LT_PAIR_GROUP:
NOCONCATENATE LOAD
    LT_PAIR AS LT_GROUP_PAIR,
    Count(LT_CNES) AS LT_GROUP_ROWS
RESIDENT CNES_LT_ROWS
GROUP BY LT_PAIR;

CNES_ST_TP_DISTRIBUTION:
NOCONCATENATE LOAD
    ST_TP_LABEL AS ST_CODE_LABEL,
    Count(ST_CNES) AS ST_CODE_ROWS
RESIDENT CNES_ST_ROWS
GROUP BY ST_TP_LABEL;

CNES_ST_MONTHS:
NOCONCATENATE LOAD
    ST_COMPETEN AS ST_MONTH,
    Count(ST_CNES) AS ST_MONTH_ROWS,
    Count(DISTINCT ST_CNES) AS ST_MONTH_DISTINCT_CNES
RESIDENT CNES_ST_ROWS
GROUP BY ST_COMPETEN;

CNES_LT_MONTHS:
NOCONCATENATE LOAD
    LT_COMPETEN AS LT_MONTH,
    Count(LT_CNES) AS LT_MONTH_ROWS,
    Count(DISTINCT LT_CNES) AS LT_MONTH_DISTINCT_CNES
RESIDENT CNES_LT_ROWS
GROUP BY LT_COMPETEN;

CNES_ST_PAIR_MAP:
MAPPING LOAD
    ST_GROUP_PAIR,
    1
RESIDENT CNES_ST_PAIR_GROUP;

CNES_LT_PAIR_MAP:
MAPPING LOAD
    LT_GROUP_PAIR,
    1
RESIDENT CNES_LT_PAIR_GROUP;

CNES_LT_PAIR_MATCH:
NOCONCATENATE LOAD
    LT_GROUP_PAIR AS LT_MATCH_PAIR,
    ApplyMap('CNES_ST_PAIR_MAP',LT_GROUP_PAIR,0) AS LT_GROUP_ST_EXISTS
RESIDENT CNES_LT_PAIR_GROUP;

CNES_ST_PAIR_MATCH:
NOCONCATENATE LOAD
    ST_GROUP_PAIR AS ST_MATCH_PAIR,
    ApplyMap('CNES_LT_PAIR_MAP',ST_GROUP_PAIR,0) AS ST_GROUP_LT_EXISTS
RESIDENT CNES_ST_PAIR_GROUP;

LET vSTGroups=NoOfRows('CNES_ST_PAIR_GROUP');
LET vLTGroups=NoOfRows('CNES_LT_PAIR_GROUP');
LET vSTMonths=NoOfRows('CNES_ST_MONTHS');
LET vLTMonths=NoOfRows('CNES_LT_MONTHS');
LET vTPDomain=NoOfRows('CNES_ST_TP_DISTRIBUTION');

IF ScriptErrorCount>$(vCNESPreErrors) OR $(vSTMonths)<>36 OR $(vLTMonths)<>36
   OR $(vSTGroups)<1 OR $(vLTGroups)<1 OR $(vTPDomain)<1 THEN
    TRACE [CNES-KEY] VERDICT=BLOCKED_STAGING_OR_AGGREGATE_CARDINALITY;
    EXIT SCRIPT;
ENDIF

TRACE [CNES-KEY] ST_ROWS=$(vCNESST) LT_ROWS=$(vCNESLT) ST_PAIR_KEYS=$(vSTGroups) LT_PAIR_KEYS=$(vLTGroups);
TRACE [CNES-KEY] ST_MONTHS=$(vSTMonths) LT_MONTHS=$(vLTMonths) ST_TP_DOMAIN_COUNT=$(vTPDomain);

FOR vCNESi=0 TO $(vTPDomain)-1
    LET vCNESLabel=Peek('ST_CODE_LABEL',$(vCNESi),'CNES_ST_TP_DISTRIBUTION');
    LET vCNESCodeRows=Peek('ST_CODE_ROWS',$(vCNESi),'CNES_ST_TP_DISTRIBUTION');
    TRACE [CNES-KEY] TP_UNID_RAW_LABEL=$(vCNESLabel) ST_ROWS=$(vCNESCodeRows);
NEXT

FOR vCNESi=0 TO $(vSTMonths)-1
    LET vCNESMonth=Peek('ST_MONTH',$(vCNESi),'CNES_ST_MONTHS');
    LET vCNESMonthRows=Peek('ST_MONTH_ROWS',$(vCNESi),'CNES_ST_MONTHS');
    LET vCNESMonthCnes=Peek('ST_MONTH_DISTINCT_CNES',$(vCNESi),'CNES_ST_MONTHS');
    TRACE [CNES-KEY] ST_COMPETEN=$(vCNESMonth) ROWS=$(vCNESMonthRows) DISTINCT_CNES=$(vCNESMonthCnes);
NEXT

FOR vCNESi=0 TO $(vLTMonths)-1
    LET vCNESMonth=Peek('LT_MONTH',$(vCNESi),'CNES_LT_MONTHS');
    LET vCNESMonthRows=Peek('LT_MONTH_ROWS',$(vCNESi),'CNES_LT_MONTHS');
    LET vCNESMonthCnes=Peek('LT_MONTH_DISTINCT_CNES',$(vCNESi),'CNES_LT_MONTHS');
    TRACE [CNES-KEY] LT_COMPETEN=$(vCNESMonth) ROWS=$(vCNESMonthRows) DISTINCT_CNES=$(vCNESMonthCnes);
NEXT

TRACE [CNES-KEY] VERDICT=PASS_IN_MEMORY_EMPIRICAL_KEY_AND_TP_DISTRIBUTION_NOT_HOSPITAL_CLASSIFICATION;
TRACE [CNES-KEY] HOSPITAL_SCOPE=NOT_VERIFIED T29_HISTORICAL=NOT_APPROVED;
