// SAD VI-P4: evidence-only CNES/LT municipal x month observability matrix.
// All QVD inputs are read-only. Exactly 3 permitted STORE operations export
// audit-only UTF-8 delimited TEXT to unique %TEMP% evidence paths.
// NEVER store QVD, modify QVW sources, fill absent LT cells with 0,
// infer hospital-only scope, or promote 12 observed months to coverage approval.
SET ErrorMode=0;
LET vP4ErrStart=ScriptErrorCount;
TRACE [P4] START=READONLY_OBSERVABILITY_AND_RECONCILIATION;

// Physical capacity candidate is used as a direct row-level reconciliation target.
P4_FACT_KEYS:
NOCONCATENATE LOAD
 SK_REGISTRO_CAPACIDADE_LEITO AS F_ID,
 QTD_LEITOS_SUS AS F_SUS,
 QTD_LEITOS_EXISTENTES AS F_EXIST,
 QTD_LEITOS_NAO_SUS AS F_NSUS
FROM [__FACT_QVD__] (qvd);
P4_MAP_ID: MAPPING LOAD F_ID, 1 RESIDENT P4_FACT_KEYS;
P4_MAP_SUS: MAPPING LOAD F_ID, F_SUS RESIDENT P4_FACT_KEYS;
P4_MAP_EXIST: MAPPING LOAD F_ID, F_EXIST RESIDENT P4_FACT_KEYS;
P4_MAP_NSUS: MAPPING LOAD F_ID, F_NSUS RESIDENT P4_FACT_KEYS;

P4_POP_SOURCE:
NOCONCATENATE LOAD
 Trim(Text(FATO_POP_DATASUS6_REFERENCIA_PB)) AS POP_CODE,
 Trim(Text(FATO_POP_ANO_ORIGEM)) AS POP_YEAR
FROM [__POP_QVD__] (qvd);
P4_POP_SUM:
NOCONCATENATE LOAD Count(*) AS POP_ROWS,
 Count(DISTINCT POP_CODE) AS POP_MUN,
 Count(DISTINCT POP_CODE & '|' & POP_YEAR) AS POP_PAIRS
RESIDENT P4_POP_SOURCE;
LET vP4PopRows=Peek('POP_ROWS',0,'P4_POP_SUM');
LET vP4PopMuns=Peek('POP_MUN',0,'P4_POP_SUM');
LET vP4PopPairs=Peek('POP_PAIRS',0,'P4_POP_SUM');
DROP TABLE P4_POP_SUM;
IF ScriptErrorCount>$(vP4ErrStart) OR $(vP4PopRows)<>669 OR $(vP4PopMuns)<>223 OR $(vP4PopPairs)<>669 THEN
 TRACE [P4] VERDICT=BLOCKED_POP_UNIVERSE;
 EXIT SCRIPT;
ENDIF
P4_POP_MAP: MAPPING LOAD DISTINCT POP_CODE,1 RESIDENT P4_POP_SOURCE;
P4_MUN:
NOCONCATENATE LOAD DISTINCT POP_CODE AS MUNICIPIO RESIDENT P4_POP_SOURCE;
DROP TABLE P4_POP_SOURCE;

P4_LT_RAW:
NOCONCATENATE LOAD
 Trim(Text(CODUFMUN)) AS MUNICIPIO_LT,
 Trim(Text(COMPETEN)) AS COMPETENCIA_LT,
 Trim(Text(_META_SOURCE_COMPETENCE)) AS SOURCE_COMP_LT,
 Hash128('LT',Trim(Text(CNES)),Text(COMPETEN),Text(CODLEITO)) AS LT_ROW_ID,
 QT_SUS AS LT_QT_SUS,
 QT_EXIST AS LT_QT_EXIST,
 QT_NSUS AS LT_QT_NSUS,
 ApplyMap('P4_MAP_ID',Hash128('LT',Trim(Text(CNES)),Text(COMPETEN),Text(CODLEITO)),0) AS FACT_MATCH,
 ApplyMap('P4_MAP_SUS',Hash128('LT',Trim(Text(CNES)),Text(COMPETEN),Text(CODLEITO)),-1) AS FACT_QT_SUS,
 ApplyMap('P4_MAP_EXIST',Hash128('LT',Trim(Text(CNES)),Text(COMPETEN),Text(CODLEITO)),-1) AS FACT_QT_EXIST,
 ApplyMap('P4_MAP_NSUS',Hash128('LT',Trim(Text(CNES)),Text(COMPETEN),Text(CODLEITO)),-1) AS FACT_QT_NSUS,
 ApplyMap('P4_POP_MAP',Trim(Text(CODUFMUN)),0) AS IS_PB_POP_MUN
FROM [__LT_STAGE_QVD__] (qvd);
P4_LT_VERIFY:
NOCONCATENATE LOAD
 Count(*) AS ST_ROWS,
 Count(DISTINCT LT_ROW_ID) AS ST_UNIQUE,
 Count(DISTINCT COMPETENCIA_LT) AS ST_MONTHS,
 Sum(LT_QT_SUS) AS ST_SUS,
 Sum(LT_QT_EXIST) AS ST_EXIST,
 Sum(LT_QT_NSUS) AS ST_NSUS,
 Sum(If(IS_PB_POP_MUN<>1 OR FACT_MATCH<>1 OR SOURCE_COMP_LT<>COMPETENCIA_LT
  OR NOT IsNum(LT_QT_SUS) OR NOT IsNum(LT_QT_EXIST) OR NOT IsNum(LT_QT_NSUS)
  OR LT_QT_SUS<0 OR LT_QT_EXIST<0 OR LT_QT_NSUS<0
  OR LT_QT_SUS>LT_QT_EXIST OR LT_QT_EXIST<>LT_QT_SUS+LT_QT_NSUS
  OR LT_QT_SUS<>FACT_QT_SUS OR LT_QT_EXIST<>FACT_QT_EXIST
  OR LT_QT_NSUS<>FACT_QT_NSUS,1,0)) AS ST_BAD
RESIDENT P4_LT_RAW;
LET vP4Rows=Peek('ST_ROWS',0,'P4_LT_VERIFY');
LET vP4Unique=Peek('ST_UNIQUE',0,'P4_LT_VERIFY');
LET vP4Months=Peek('ST_MONTHS',0,'P4_LT_VERIFY');
LET vP4Sus=Peek('ST_SUS',0,'P4_LT_VERIFY');
LET vP4Exist=Peek('ST_EXIST',0,'P4_LT_VERIFY');
LET vP4Nsus=Peek('ST_NSUS',0,'P4_LT_VERIFY');
LET vP4Bad=Peek('ST_BAD',0,'P4_LT_VERIFY');
DROP TABLE P4_LT_VERIFY;
TRACE [P4] LT_SOURCE_ROWS=$(vP4Rows) UNIQUE=$(vP4Unique) MONTHS=$(vP4Months) SUS_SNAPSHOT_SUM=$(vP4Sus) EXIST_SNAPSHOT_SUM=$(vP4Exist) NSUS_SNAPSHOT_SUM=$(vP4Nsus) BAD=$(vP4Bad);
IF ScriptErrorCount>$(vP4ErrStart) OR $(vP4Rows)<>35518 OR $(vP4Unique)<>35518 OR $(vP4Months)<>36 OR $(vP4Sus)<>270076 OR $(vP4Exist)<>337147 OR $(vP4Nsus)<>67071 OR $(vP4Bad)<>0 THEN
 TRACE [P4] VERDICT=BLOCKED_LT_STAGING_TO_FACT_INTEGRITY;
 EXIT SCRIPT;
ENDIF
DROP TABLE P4_FACT_KEYS;

P4_LT_MONTHLY:
NOCONCATENATE LOAD
 MUNICIPIO_LT AS MUNICIPIO,
 COMPETENCIA_LT AS COMPETENCIA,
 Count(*) AS LINHAS_LT,
 Sum(LT_QT_SUS) AS QT_SUS_OBSERVADO,
 Sum(LT_QT_EXIST) AS QT_EXIST_OBSERVADO
RESIDENT P4_LT_RAW
GROUP BY MUNICIPIO_LT,COMPETENCIA_LT;
DROP TABLE P4_LT_RAW;

P4_MONTH_LIST:
NOCONCATENATE LOAD
 Text(Date(AddMonths(MakeDate(2017,1,1),RecNo()-1),'YYYYMM')) AS COMPETENCIA
AUTOGENERATE 36;
P4_GRID:
NOCONCATENATE LOAD MUNICIPIO RESIDENT P4_MUN;
JOIN (P4_GRID)
LOAD COMPETENCIA RESIDENT P4_MONTH_LIST;
LET vP4GridRows=NoOfRows('P4_GRID');
TRACE [P4] EXPECTED_GRID_ROWS=$(vP4GridRows);
IF ScriptErrorCount>$(vP4ErrStart) OR $(vP4GridRows)<>8028 THEN
 TRACE [P4] VERDICT=BLOCKED_POP_MUNICIPAL_MONTH_GRID;
 EXIT SCRIPT;
ENDIF
DROP TABLE P4_MUN;
DROP TABLE P4_MONTH_LIST;
LEFT JOIN (P4_GRID)
LOAD MUNICIPIO,COMPETENCIA,LINHAS_LT,QT_SUS_OBSERVADO,QT_EXIST_OBSERVADO
RESIDENT P4_LT_MONTHLY;
DROP TABLE P4_LT_MONTHLY;

P4_MATRIX:
NOCONCATENATE LOAD
 Text(MUNICIPIO) AS MUNICIPIO,
 Text(COMPETENCIA) AS COMPETENCIA,
 If(IsNull(LINHAS_LT),Null(),LINHAS_LT) AS LINHAS_LT,
 If(IsNull(QT_SUS_OBSERVADO),Null(),QT_SUS_OBSERVADO) AS QT_SUS_OBSERVADO,
 If(IsNull(QT_EXIST_OBSERVADO),Null(),QT_EXIST_OBSERVADO) AS QT_EXIST_OBSERVADO,
 If(IsNull(LINHAS_LT),'ABSENT_NOT_ZERO_PROVEN',
  If(QT_SUS_OBSERVADO=0,'OBSERVED_ZERO_QT_SUS_SCOPE_UNVERIFIED',
   'OBSERVED_POSITIVE_QT_SUS_SCOPE_UNVERIFIED')) AS ESTADO_OBSERVADO,
 'NOT_PROVEN' AS ZERO_REAL_COMPROVADO,
 'NOT_VERIFIED' AS COBERTURA_HOSPITALAR
RESIDENT P4_GRID;
DROP TABLE P4_GRID;

P4_STATUS:
NOCONCATENATE LOAD
 Count(*) AS TOTAL,
 Count(DISTINCT MUNICIPIO) AS MUNICIPIOS,
 Count(DISTINCT COMPETENCIA) AS COMPETENCIAS,
 Sum(If(ESTADO_OBSERVADO='ABSENT_NOT_ZERO_PROVEN',1,0)) AS AUSENTES,
 Sum(If(ESTADO_OBSERVADO='OBSERVED_ZERO_QT_SUS_SCOPE_UNVERIFIED',1,0)) AS ZEROS_OBSERVADOS,
 Sum(If(ESTADO_OBSERVADO='OBSERVED_POSITIVE_QT_SUS_SCOPE_UNVERIFIED',1,0)) AS POSITIVOS_OBSERVADOS,
 Sum(If(Not IsNull(LINHAS_LT),LINHAS_LT,0)) AS SOMA_LINHAS,
 Sum(If(Not IsNull(QT_SUS_OBSERVADO),QT_SUS_OBSERVADO,0)) AS SOMA_SUS,
 Sum(If(Not IsNull(QT_EXIST_OBSERVADO),QT_EXIST_OBSERVADO,0)) AS SOMA_EXIST
RESIDENT P4_MATRIX;
LET vP4Total=Peek('TOTAL',0,'P4_STATUS');
LET vP4Mun=Peek('MUNICIPIOS',0,'P4_STATUS');
LET vP4Comp=Peek('COMPETENCIAS',0,'P4_STATUS');
LET vP4Abs=Peek('AUSENTES',0,'P4_STATUS');
LET vP4Zeros=Peek('ZEROS_OBSERVADOS',0,'P4_STATUS');
LET vP4Pos=Peek('POSITIVOS_OBSERVADOS',0,'P4_STATUS');
LET vP4RowSum=Peek('SOMA_LINHAS',0,'P4_STATUS');
LET vP4SusSum=Peek('SOMA_SUS',0,'P4_STATUS');
LET vP4ExSum=Peek('SOMA_EXIST',0,'P4_STATUS');
DROP TABLE P4_STATUS;
TRACE [P4] GRID_ROWS=$(vP4Total) MUNICIPIOS=$(vP4Mun) MONTHS=$(vP4Comp) ABSENT=$(vP4Abs) OBSERVED_ZERO_SUS=$(vP4Zeros) OBSERVED_POSITIVE_SUS=$(vP4Pos) SOURCE_LT_ROWS=$(vP4RowSum) SUS_SNAPSHOT_SUM=$(vP4SusSum) EXIST_SNAPSHOT_SUM=$(vP4ExSum);
IF ScriptErrorCount>$(vP4ErrStart) OR $(vP4Total)<>8028 OR $(vP4Mun)<>223 OR $(vP4Comp)<>36 OR $(vP4Abs)+$(vP4Zeros)+$(vP4Pos)<>8028 OR $(vP4RowSum)<>35518 OR $(vP4SusSum)<>270076 OR $(vP4ExSum)<>337147 THEN
 TRACE [P4] VERDICT=BLOCKED_GRID_RECONCILIATION;
 EXIT SCRIPT;
ENDIF

P4_YEARS:
NOCONCATENATE LOAD
 MUNICIPIO,
 Left(COMPETENCIA,4) AS ANO,
 Sum(If(ESTADO_OBSERVADO='ABSENT_NOT_ZERO_PROVEN',0,1)) AS MESES_COM_LINHAS,
 Sum(If(ESTADO_OBSERVADO='ABSENT_NOT_ZERO_PROVEN',1,0)) AS MESES_SEM_LINHAS,
 Sum(If(ESTADO_OBSERVADO='OBSERVED_ZERO_QT_SUS_SCOPE_UNVERIFIED',1,0)) AS MESES_QT_SUS_ZERO_OBSERVADO,
 Count(*) AS MESES_UNIVERSO
RESIDENT P4_MATRIX
GROUP BY MUNICIPIO,Left(COMPETENCIA,4);
P4_YEAR_SUM:
NOCONCATENATE LOAD
 Count(*) AS YROWS,
 Sum(If(MESES_UNIVERSO<>12 OR MESES_COM_LINHAS+MESES_SEM_LINHAS<>12,1,0)) AS YBAD
RESIDENT P4_YEARS;
LET vP4YearRows=Peek('YROWS',0,'P4_YEAR_SUM');
LET vP4YearBad=Peek('YBAD',0,'P4_YEAR_SUM');
DROP TABLE P4_YEAR_SUM;
TRACE [P4] MUNICIPAL_YEAR_ROWS=$(vP4YearRows) BAD=$(vP4YearBad);
IF ScriptErrorCount>$(vP4ErrStart) OR $(vP4YearRows)<>669 OR $(vP4YearBad)<>0 THEN
 TRACE [P4] VERDICT=BLOCKED_YEAR_MATRIX;
 EXIT SCRIPT;
ENDIF
P4_MONTH_PROFILE:
NOCONCATENATE LOAD
 COMPETENCIA,
 Count(*) AS MUNICIPIOS_NO_UNIVERSO,
 Sum(If(ESTADO_OBSERVADO='ABSENT_NOT_ZERO_PROVEN',1,0)) AS MUNICIPIOS_SEM_LINHAS,
 Sum(If(ESTADO_OBSERVADO='OBSERVED_ZERO_QT_SUS_SCOPE_UNVERIFIED',1,0)) AS MUNICIPIOS_COM_ZERO_OBSERVADO,
 Sum(If(ESTADO_OBSERVADO='OBSERVED_POSITIVE_QT_SUS_SCOPE_UNVERIFIED',1,0)) AS MUNICIPIOS_COM_POSITIVO,
 Sum(If(Not IsNull(LINHAS_LT),LINHAS_LT,0)) AS LINHAS_LT_TOTAL,
 Sum(If(Not IsNull(QT_SUS_OBSERVADO),QT_SUS_OBSERVADO,0)) AS SUS_TOTAL_SNAPSHOT
RESIDENT P4_MATRIX GROUP BY COMPETENCIA;
IF ScriptErrorCount>$(vP4ErrStart) OR NoOfRows('P4_MONTH_PROFILE')<>36 THEN
 TRACE [P4] VERDICT=BLOCKED_MONTH_PROFILE;
 EXIT SCRIPT;
ENDIF

// Deliberately controlled TXT-only exports in UNIQUE %TEMP% evidence folder.
// Absolutely NO QVD export; only this isolated QVW and audit text files.
STORE * FROM P4_MATRIX INTO [__MATRIX_TXT__] (txt, delimiter is '|');
STORE * FROM P4_YEARS INTO [__YEARS_TXT__] (txt, delimiter is '|');
STORE * FROM P4_MONTH_PROFILE INTO [__MONTHS_TXT__] (txt, delimiter is '|');
IF ScriptErrorCount>$(vP4ErrStart) THEN
 TRACE [P4] VERDICT=BLOCKED_AUDIT_TXT_EXPORT;
 EXIT SCRIPT;
ENDIF
TRACE [P4] VERDICT=PASS_MUNICIPAL_MONTH_OBSERVABILITY_ONLY;
TRACE [P4] CNES_HOSPITAL_SCOPE_COVERAGE=NOT_VERIFIED ZERO_PROOF=NOT_PROVEN LINK_KEY_CONTRACT=NOT_APPROVED PRODUCTION_APPROVED=False;
