// Fase V — guard-only STORE suffix for the validated population fact in RAM.
// Never include in transf_main.qvs; exclusively a separately authorized one-shot.
// All 20 earlier QVDs are inputs/read-only; this QVS stores only the new fact.
TRACE [V5-POP-STORE] START_ONE_SHOT_ONLY;
IF '$(vP5PopCreateAuthorization)' <> 'AUTHORIZED_ONE_SHOT_CREATE_POPULACAO_20261016' THEN
    TRACE [V5-POP-STORE] VERDICT=BLOCKED_MISSING_CREATE_AUTHORIZATION;
    EXIT SCRIPT;
ENDIF
IF ScriptErrorCount > $(vP5PopImplStartErrors) OR NoOfRows('FATO_POPULACAO')<>669 OR NoOfFields('FATO_POPULACAO')<>7 OR $(vP5PIMOutRows)<>669 OR $(vP5PIMOutGrain)<>669 OR $(vP5PIMOutSKPairs)<>669 OR $(vP5PIMOutMun)<>223 OR $(vP5PIMOutYears)<>3 OR $(vP5PIMOutFiles)<>3 OR $(vP5PIMOutNull)<>0 OR $(vP5PIMOutBadSK)<>0 OR $(vP5PIMYearGroups)<>3 OR $(vP5PIMYearBad)<>0 THEN
    TRACE [V5-POP-STORE] VERDICT=BLOCKED_IN_MEMORY_GATE;
    EXIT SCRIPT;
ENDIF
IF NOT IsNull(FileSize('QVD\FATO_POPULACAO.qvd')) THEN
    TRACE [V5-POP-STORE] VERDICT=BLOCKED_TARGET_EXISTS_NO_OVERWRITE;
    EXIT SCRIPT;
ENDIF
STORE FATO_POPULACAO INTO [QVD\FATO_POPULACAO.qvd] (qvd);
IF ScriptErrorCount > $(vP5PopImplStartErrors) THEN
    TRACE [V5-POP-STORE] VERDICT=BLOCKED_STORE_INSPECT_FILE_AND_LOG;
    EXIT SCRIPT;
ENDIF
TRACE [V5-POP-STORE] ROWS=669 GRAIN=669 SK_PAIRS=669 MUNICIPIOS=223 YEARS=3 FILES=3 NULL=0 BAD_SK=0 FIELDS=7;
TRACE [V5-POP-STORE] VERDICT=WRITTEN_PENDING_INDEPENDENT_QVD_AUDIT;
TRACE [V5-POP-STORE] LINK_ANALISE_QVD_GENERATED=False PRODUCTION_APPROVED=False;
