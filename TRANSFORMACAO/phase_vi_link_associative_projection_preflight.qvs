// P6 — ISOLATED ASSOCIATIVE PROJECTION (INJECT INTO EXISTING P6 R2 AFTER BASE GATES).
// NO STORE; only disposable QVW tables; not actual FATO QVD, Link Table QVD, or panel.
// Contract source: Boundary 6 §§5–6/22.5–22.6, Boundary 7 §22.
// Link key independently recomputed from ORIGINAL five SKs to test both paths.
TRACE [P6-ASSOC] START_IN_MEMORY_LINK_PROJECTION;

// Distinct 5-coordinate combinations. Original SK text/Null() retained in fields.
P6_LINK_SIMULADA:
NOCONCATENATE LOAD DISTINCT
    Hash128('SAD-LINK-V1',
        'C=' & If(IsNull(_P6_COMP),'N','V' & Len(Text(_P6_COMP)) & ':' & Text(_P6_COMP)),
        'Y=' & If(IsNull(_P6_YEAR),'N','V' & Len(Text(_P6_YEAR)) & ':' & Text(_P6_YEAR)),
        'R=' & If(IsNull(_P6_RES),'N','V' & Len(Text(_P6_RES)) & ':' & Text(_P6_RES)),
        'S=' & If(IsNull(_P6_SERV),'N','V' & Len(Text(_P6_SERV)) & ':' & Text(_P6_SERV)),
        'E=' & If(IsNull(_P6_EST),'N','V' & Len(Text(_P6_EST)) & ':' & Text(_P6_EST))
    ) AS [%LINK_KEY],
    _P6_COMP AS [%SK_TEMPO_COMPETENCIA],
    _P6_YEAR AS [%SK_TEMPO_ANO],
    _P6_RES AS [%SK_MUNICIPIO_RESIDENCIA],
    _P6_SERV AS [%SK_MUNICIPIO_SERVICO],
    _P6_EST AS [%SK_ESTABELECIMENTO]
RESIDENT P6_COORDS;

IF ScriptErrorCount > $(vP6StartErr) OR NoOfRows('P6_LINK_SIMULADA')<>85705 THEN
    TRACE [P6-ASSOC] VERDICT=BLOCKED_LINK_DISTINCT_ROWS;
    EXIT SCRIPT;
ENDIF

P6_ASSOC_BASE_HASH_MAP:
MAPPING LOAD DISTINCT Text(_P6_HASH), 1 RESIDENT P6_LINK_TEST;
P6_ASSOC_LINK_KEY_MAP:
MAPPING LOAD DISTINCT Text([%LINK_KEY]), 1 RESIDENT P6_LINK_SIMULADA;

// Link dimensions are physical role aliases, with unique descriptive column names.
// DIM_TEMPO has daily grain; use DISTINCT to avoid multiplying monthly/yearly SKs.
P6_DIM_COMP_SIMULADA:
NOCONCATENATE LOAD DISTINCT
    [%SK_TEMPO_COMPETENCIA],
    Text(TEMPO_COMPETENCIA) AS P6_COMP_COMPETENCIA
FROM [QVD\DIM_TEMPO.qvd] (qvd)
WHERE NOT IsNull([%SK_TEMPO_COMPETENCIA]);

P6_DIM_ANO_SIMULADA:
NOCONCATENATE LOAD DISTINCT
    [%SK_TEMPO_ANO],
    TEMPO_ANO AS P6_ANO_ANO
FROM [QVD\DIM_TEMPO.qvd] (qvd)
WHERE NOT IsNull([%SK_TEMPO_ANO]);

// The same municipality dimension appears twice under explicit different roles.
P6_DIM_RES_SIMULADA:
NOCONCATENATE LOAD DISTINCT
    [%SK_MUNICIPIO] AS [%SK_MUNICIPIO_RESIDENCIA],
    Text(COD_DATASUS_6) AS P6_RES_DATASUS_6,
    NOME_MUNICIPIO AS P6_RES_NOME_MUNICIPIO,
    UF AS P6_RES_UF
FROM [QVD\DIM_MUNICIPIO.qvd] (qvd);

P6_DIM_SERV_SIMULADA:
NOCONCATENATE LOAD DISTINCT
    [%SK_MUNICIPIO] AS [%SK_MUNICIPIO_SERVICO],
    Text(COD_DATASUS_6) AS P6_SERV_DATASUS_6,
    NOME_MUNICIPIO AS P6_SERV_NOME_MUNICIPIO,
    UF AS P6_SERV_UF
FROM [QVD\DIM_MUNICIPIO.qvd] (qvd);

// Establishment metadata (monthly version); no CNES/COMPETENCIA extra association.
P6_DIM_EST_SIMULADA:
NOCONCATENATE LOAD DISTINCT
    [%SK_ESTABELECIMENTO],
    Text(CNES) AS P6_EST_CNES,
    Text(COMPETENCIA) AS P6_EST_COMPETENCIA
FROM [QVD\DIM_ESTABELECIMENTO.qvd] (qvd);

// Fact projections carry ONLY %LINK_KEY and a disposable row ordinal.
// These ARE NOT the real factual schemas and contain NO business measures.
P6_FATO_RD_SIMULADA:
NOCONCATENATE LOAD
    Text(_P6_HASH) AS [%LINK_KEY],
    RowNo() AS P6_RD_ROW_DEBUG
RESIDENT P6_LINK_TEST
WHERE _P6_LINK_PROC='RD';

P6_FATO_LT_SIMULADA:
NOCONCATENATE LOAD
    Text(_P6_HASH) AS [%LINK_KEY],
    RowNo() AS P6_LT_ROW_DEBUG
RESIDENT P6_LINK_TEST
WHERE _P6_LINK_PROC='LT';

P6_FATO_POP_SIMULADA:
NOCONCATENATE LOAD
    Text(_P6_HASH) AS [%LINK_KEY],
    RowNo() AS P6_POP_ROW_DEBUG
RESIDENT P6_LINK_TEST
WHERE _P6_LINK_PROC='POP';

// Separate temporary profile tables; none shares names with the associative model.
P6_ASSOC_LINK_PROFILE:
NOCONCATENATE LOAD
    Count(*) AS _P6_AP_LINK_ROWS,
    Count(DISTINCT [%LINK_KEY]) AS _P6_AP_LINK_KEYS,
    Sum(If(ApplyMap('P6_ASSOC_BASE_HASH_MAP',Text([%LINK_KEY]),0)<>1,1,0)) AS _P6_AP_LINK_MISSING_BASE,
    Sum(If(IsNull([%LINK_KEY]) OR IsNull([%SK_TEMPO_ANO]) OR IsNull([%SK_MUNICIPIO_SERVICO]),1,0)) AS _P6_AP_LINK_REQUIRED_NULL
RESIDENT P6_LINK_SIMULADA;
LET vP6APLinkRows=Peek('_P6_AP_LINK_ROWS',0,'P6_ASSOC_LINK_PROFILE');
LET vP6APLinkKeys=Peek('_P6_AP_LINK_KEYS',0,'P6_ASSOC_LINK_PROFILE');
LET vP6APLinkMissing=Peek('_P6_AP_LINK_MISSING_BASE',0,'P6_ASSOC_LINK_PROFILE');
LET vP6APLinkNull=Peek('_P6_AP_LINK_REQUIRED_NULL',0,'P6_ASSOC_LINK_PROFILE');
DROP TABLE P6_ASSOC_LINK_PROFILE;

P6_ASSOC_RD_PROFILE:
NOCONCATENATE LOAD Count(*) AS _P6_AP_RD_ROWS,
    Sum(If(ApplyMap('P6_ASSOC_LINK_KEY_MAP',Text([%LINK_KEY]),0)<>1,1,0)) AS _P6_AP_RD_ORPHANS,
    Sum(If(IsNull([%LINK_KEY]),1,0)) AS _P6_AP_RD_NULL
RESIDENT P6_FATO_RD_SIMULADA;
LET vP6APRdRows=Peek('_P6_AP_RD_ROWS',0,'P6_ASSOC_RD_PROFILE');
LET vP6APRdOrphans=Peek('_P6_AP_RD_ORPHANS',0,'P6_ASSOC_RD_PROFILE');
LET vP6APRdNull=Peek('_P6_AP_RD_NULL',0,'P6_ASSOC_RD_PROFILE');
DROP TABLE P6_ASSOC_RD_PROFILE;

P6_ASSOC_LT_PROFILE:
NOCONCATENATE LOAD Count(*) AS _P6_AP_LT_ROWS,
    Sum(If(ApplyMap('P6_ASSOC_LINK_KEY_MAP',Text([%LINK_KEY]),0)<>1,1,0)) AS _P6_AP_LT_ORPHANS,
    Sum(If(IsNull([%LINK_KEY]),1,0)) AS _P6_AP_LT_NULL
RESIDENT P6_FATO_LT_SIMULADA;
LET vP6APLtRows=Peek('_P6_AP_LT_ROWS',0,'P6_ASSOC_LT_PROFILE');
LET vP6APLtOrphans=Peek('_P6_AP_LT_ORPHANS',0,'P6_ASSOC_LT_PROFILE');
LET vP6APLtNull=Peek('_P6_AP_LT_NULL',0,'P6_ASSOC_LT_PROFILE');
DROP TABLE P6_ASSOC_LT_PROFILE;

P6_ASSOC_POP_PROFILE:
NOCONCATENATE LOAD Count(*) AS _P6_AP_POP_ROWS,
    Sum(If(ApplyMap('P6_ASSOC_LINK_KEY_MAP',Text([%LINK_KEY]),0)<>1,1,0)) AS _P6_AP_POP_ORPHANS,
    Sum(If(IsNull([%LINK_KEY]),1,0)) AS _P6_AP_POP_NULL
RESIDENT P6_FATO_POP_SIMULADA;
LET vP6APPopRows=Peek('_P6_AP_POP_ROWS',0,'P6_ASSOC_POP_PROFILE');
LET vP6APPopOrphans=Peek('_P6_AP_POP_ORPHANS',0,'P6_ASSOC_POP_PROFILE');
LET vP6APPopNull=Peek('_P6_AP_POP_NULL',0,'P6_ASSOC_POP_PROFILE');
DROP TABLE P6_ASSOC_POP_PROFILE;

TRACE [P6-ASSOC] LINK_ROWS=$(vP6APLinkRows) LINK_DISTINCT=$(vP6APLinkKeys) LINK_ORPHAN_BASE=$(vP6APLinkMissing) REQUIRED_NULL=$(vP6APLinkNull);
TRACE [P6-ASSOC] FACT_ROWS RD=$(vP6APRdRows) LT=$(vP6APLtRows) POP=$(vP6APPopRows);
TRACE [P6-ASSOC] FACT_ORPHANS RD=$(vP6APRdOrphans) LT=$(vP6APLtOrphans) POP=$(vP6APPopOrphans);
TRACE [P6-ASSOC] FACT_NULL RD=$(vP6APRdNull) LT=$(vP6APLtNull) POP=$(vP6APPopNull);

IF ScriptErrorCount>$(vP6StartErr) OR $(vP6APLinkRows)<>85705 OR $(vP6APLinkKeys)<>85705 OR $(vP6APLinkMissing)<>0 OR $(vP6APLinkNull)<>0 OR $(vP6APRdRows)<>566672 OR $(vP6APLtRows)<>35518 OR $(vP6APPopRows)<>669 OR $(vP6APRdOrphans)<>0 OR $(vP6APLtOrphans)<>0 OR $(vP6APPopOrphans)<>0 OR $(vP6APRdNull)<>0 OR $(vP6APLtNull)<>0 OR $(vP6APPopNull)<>0 THEN
    TRACE [P6-ASSOC] VERDICT=BLOCKED_ASSOCIATIVE_COVERAGE_OR_SOURCE_GRAIN;
    EXIT SCRIPT;
ENDIF

TRACE [P6-ASSOC] PROJECTION_READY=TRUE;
// P6_ASSOC_FINAL_GATE_BEGIN
// Runs after the canonical R2 cleanup of its five diagnostic tables.
// Expected end-user model: one Link Table + 3 fact projections + 5 role dimensions.
LET vP6APTables=NoOfTables();
LET vP6APSyn=0;
FOR vP6APT=0 TO NoOfTables()-1
    LET vP6APLabel=TableName($(vP6APT));
    IF WildMatch('$(vP6APLabel)','$Syn*')>0 THEN
        LET vP6APSyn=$(vP6APSyn)+1;
    ENDIF
NEXT vP6APT
LET vP6APMonths=NoOfRows('P6_DIM_COMP_SIMULADA');
LET vP6APYears=NoOfRows('P6_DIM_ANO_SIMULADA');
LET vP6APRes=NoOfRows('P6_DIM_RES_SIMULADA');
LET vP6APServ=NoOfRows('P6_DIM_SERV_SIMULADA');
LET vP6APEst=NoOfRows('P6_DIM_EST_SIMULADA');

TRACE [P6-ASSOC] FINAL_MODEL TABLES=$(vP6APTables) SYNTHETIC=$(vP6APSyn) COMP_ALIAS=$(vP6APMonths) ANO_ALIAS=$(vP6APYears) RES_ALIAS=$(vP6APRes) SERV_ALIAS=$(vP6APServ) EST_ALIAS=$(vP6APEst);

// 9 intended tables and exact fields in fact and bridge projections.
// This does not replace the visual Table Viewer / circular warning inspection.
IF ScriptErrorCount>$(vP6StartErr) OR $(vP6APTables)<>9 OR $(vP6APSyn)<>0 OR NoOfFields('P6_LINK_SIMULADA')<>6 OR NoOfFields('P6_FATO_RD_SIMULADA')<>2 OR NoOfFields('P6_FATO_LT_SIMULADA')<>2 OR NoOfFields('P6_FATO_POP_SIMULADA')<>2 OR NoOfFields('P6_DIM_COMP_SIMULADA')<>2 OR NoOfFields('P6_DIM_ANO_SIMULADA')<>2 OR NoOfFields('P6_DIM_RES_SIMULADA')<>4 OR NoOfFields('P6_DIM_SERV_SIMULADA')<>4 OR NoOfFields('P6_DIM_EST_SIMULADA')<>3 THEN
    TRACE [P6-ASSOC] VERDICT=BLOCKED_ASSOCIATIVE_SCHEMA_OR_SYN;
    EXIT SCRIPT;
ENDIF

// Do not assert full production associative PASS without role selection and measures.
TRACE [P6-ASSOC] VERDICT=PASS_IN_MEMORY_85705_LINK_AND_3_FACT_COVERAGE_NOT_FINAL;
TRACE [P6-ASSOC] TABLE_VIEWER_ROLE_SELECTION=NOT_TESTED CIRCULAR_LINKS_VISUAL_REVIEW=REQUIRED;
TRACE [P6-ASSOC] FACT_QVDS_GENERATED=False LINK_ANALISE_QVD_GENERATED=False;
TRACE [P6-ASSOC] LINK_KEY_CONTRACT=NOT_APPROVED;
