// E5: experimental population measure for an existing 9-table P6 associative QVW.
// Runner prepends BINARY [<validated existing QVW>] and resolves two QVD references.
// READ ONLY: does not use STORE, write QVDs or change the academic model.
// LEFT JOIN targets ONLY P6_FATO_POP_SIMULADA (in-memory, one-to-one expected).
// MUST be executed using tools/validar_denominador_populacional_e5_qlik.ps1.

LET vE5InitialErrors=ScriptErrorCount;
IF NoOfTables()<>9 OR NoOfRows('P6_LINK_SIMULADA')<>85705 OR NoOfRows('P6_FATO_RD_SIMULADA')<>566672 OR NoOfRows('P6_FATO_LT_SIMULADA')<>35518 OR NoOfRows('P6_FATO_POP_SIMULADA')<>669 THEN
    TRACE [P6-E5] VERDICT=BLOCKED_SOURCE_QVW_SCHEMA;
    EXIT SCRIPT;
ENDIF
TRACE [P6-E5] SOURCE_QVW_9_TABLES_PASS;

P6_E5_MAP_ANO:
MAPPING LOAD DISTINCT
    [%SK_TEMPO_ANO],
    Text(P6_ANO_ANO)
RESIDENT P6_DIM_ANO_SIMULADA;

P6_E5_MAP_IBGE7:
MAPPING LOAD DISTINCT
    [%SK_MUNICIPIO],
    Text(COD_IBGE_7)
FROM [QVD\DIM_MUNICIPIO.qvd] (qvd)
WHERE NOT IsNull(COD_IBGE_7);

P6_E5_MAP_POP:
MAPPING LOAD
    Text(COD_IBGE_7) & '|' & Text(ANO_REFERENCIA),
    POPULACAO_ESTIMADA
FROM [..\EXTRACAO\QVD\SRC_IBGE_POPULACAO.qvd] (qvd);

// Only annual POP coordinates have both monthly time and establishment Null().
// Preserve the original link keys and NULL semantics.
P6_E5_POP_LOOKUP:
NOCONCATENATE LOAD
    [%LINK_KEY],
    ApplyMap('P6_E5_MAP_ANO', [%SK_TEMPO_ANO], 'INVALIDO') AS P6_POP_ANO_E5,
    ApplyMap('P6_E5_MAP_IBGE7', [%SK_MUNICIPIO_SERVICO], 'INVALIDO') AS P6_POP_IBGE7_E5,
    ApplyMap('P6_E5_MAP_POP',
        ApplyMap('P6_E5_MAP_IBGE7', [%SK_MUNICIPIO_SERVICO], 'INVALIDO') & '|' &
        ApplyMap('P6_E5_MAP_ANO', [%SK_TEMPO_ANO], 'INVALIDO'),
        Null()) AS P6_POP_HABITANTES_E5
RESIDENT P6_LINK_SIMULADA
WHERE IsNull([%SK_TEMPO_COMPETENCIA])
  AND IsNull([%SK_ESTABELECIMENTO])
  AND NOT IsNull([%SK_MUNICIPIO_RESIDENCIA])
  AND NOT IsNull([%SK_MUNICIPIO_SERVICO]);

IF ScriptErrorCount>$(vE5InitialErrors) OR NoOfRows('P6_E5_POP_LOOKUP')<>669 THEN
    TRACE [P6-E5] VERDICT=BLOCKED_POP_LOOKUP_NOT_669;
    EXIT SCRIPT;
ENDIF

// Exactly one in-memory left join into the technical POP projection; no factual QVD.
LEFT JOIN (P6_FATO_POP_SIMULADA)
LOAD
    [%LINK_KEY],
    P6_POP_ANO_E5,
    P6_POP_IBGE7_E5,
    P6_POP_HABITANTES_E5
RESIDENT P6_E5_POP_LOOKUP;

DROP TABLE P6_E5_POP_LOOKUP;

P6_E5_GATE:
NOCONCATENATE LOAD
    Count(*) AS _E5_ROWS,
    Count(DISTINCT [%LINK_KEY]) AS _E5_KEYS,
    Sum(If(IsNull(P6_POP_HABITANTES_E5) OR P6_POP_HABITANTES_E5<=0,1,0)) AS _E5_INVALID,
    Sum(If(P6_POP_ANO_E5='2017',P6_POP_HABITANTES_E5,0)) AS _E5_TOTAL_2017,
    Sum(If(P6_POP_ANO_E5='2018',P6_POP_HABITANTES_E5,0)) AS _E5_TOTAL_2018,
    Sum(If(P6_POP_ANO_E5='2019',P6_POP_HABITANTES_E5,0)) AS _E5_TOTAL_2019,
    Sum(If(P6_POP_IBGE7_E5='2507507' AND P6_POP_ANO_E5='2017',P6_POP_HABITANTES_E5,0)) AS _E5_JP_2017,
    Sum(If(P6_POP_IBGE7_E5='2507507' AND P6_POP_ANO_E5='2018',P6_POP_HABITANTES_E5,0)) AS _E5_JP_2018,
    Sum(If(P6_POP_IBGE7_E5='2507507' AND P6_POP_ANO_E5='2019',P6_POP_HABITANTES_E5,0)) AS _E5_JP_2019
RESIDENT P6_FATO_POP_SIMULADA;

LET vE5Rows=Peek('_E5_ROWS',0,'P6_E5_GATE');
LET vE5Keys=Peek('_E5_KEYS',0,'P6_E5_GATE');
LET vE5Invalid=Peek('_E5_INVALID',0,'P6_E5_GATE');
LET vE5Total2017=Peek('_E5_TOTAL_2017',0,'P6_E5_GATE');
LET vE5Total2018=Peek('_E5_TOTAL_2018',0,'P6_E5_GATE');
LET vE5Total2019=Peek('_E5_TOTAL_2019',0,'P6_E5_GATE');
LET vE5JP2017=Peek('_E5_JP_2017',0,'P6_E5_GATE');
LET vE5JP2018=Peek('_E5_JP_2018',0,'P6_E5_GATE');
LET vE5JP2019=Peek('_E5_JP_2019',0,'P6_E5_GATE');
DROP TABLE P6_E5_GATE;

TRACE [P6-E5] ROWS=$(vE5Rows) KEYS=$(vE5Keys) INVALID=$(vE5Invalid);
TRACE [P6-E5] PB_2017=$(vE5Total2017) PB_2018=$(vE5Total2018) PB_2019=$(vE5Total2019);
TRACE [P6-E5] JP_2017=$(vE5JP2017) JP_2018=$(vE5JP2018) JP_2019=$(vE5JP2019);
IF ScriptErrorCount>$(vE5InitialErrors) OR $(vE5Rows)<>669 OR $(vE5Keys)<>669 OR $(vE5Invalid)<>0 OR $(vE5Total2017)<>4025558 OR $(vE5Total2018)<>3996496 OR $(vE5Total2019)<>4018127 OR $(vE5JP2017)<>811598 OR $(vE5JP2018)<>800323 OR $(vE5JP2019)<>809015 THEN
    TRACE [P6-E5] VERDICT=BLOCKED_STAGING_OR_MAPPING_OR_JOIN;
    EXIT SCRIPT;
ENDIF

LET vE5Tables=NoOfTables();
LET vE5Syn=0;
FOR vE5i=0 TO NoOfTables()-1
    LET vE5TName=TableName($(vE5i));
    IF WildMatch('$(vE5TName)','$Syn*')>0 THEN
        LET vE5Syn=$(vE5Syn)+1;
    ENDIF
NEXT vE5i
TRACE [P6-E5] TABLES=$(vE5Tables) SYNTHETIC=$(vE5Syn);
IF ScriptErrorCount>$(vE5InitialErrors) OR $(vE5Tables)<>9 OR $(vE5Syn)<>0 THEN
    TRACE [P6-E5] VERDICT=BLOCKED_TOPOLOGY;
    EXIT SCRIPT;
ENDIF
TRACE [P6-E5] VERDICT=PASS_IN_MEMORY_POP_VALUES_PRESELECTION_NOT_APPROVED;
TRACE [P6-E5] MONTHLY_DENOMINATOR_SELECTION=NOT_TESTED;
TRACE [P6-E5] LINK_KEY_CONTRACT=NOT_APPROVED FACT_QVDS_GENERATED=False;
