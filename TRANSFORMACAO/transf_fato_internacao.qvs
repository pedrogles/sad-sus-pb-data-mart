// FASE V — FATO_INTERNACAO | Snapshot SIH/RD PB 2017–2019.
// Requires vP5FatoInternacaoMode=PREFLIGHT or CREATE from transf_main.qvs.
// No source/dimension QVD rewrites here. CREATE refuses existing fact QVD.
// This is NOT approval of LINK_ANALISE, indicators, filters or PAINEL.
LET vFIStartErrors=ScriptErrorCount;
TRACE [V5-FACT] START MODE=$(vP5FatoInternacaoMode);
IF '$(vP5FatoInternacaoMode)' <> 'PREFLIGHT' AND '$(vP5FatoInternacaoMode)' <> 'CREATE' THEN
    TRACE [V5-FACT] VERDICT=BLOCKED_INVALID_MODE;
    EXIT SCRIPT;
ENDIF
IF '$(vP5FatoInternacaoMode)' = 'CREATE' AND NOT IsNull(FileSize('QVD\FATO_INTERNACAO.qvd')) THEN
    TRACE [V5-FACT] VERDICT=BLOCKED_EXISTING_FACT_QVD;
    EXIT SCRIPT;
ENDIF

// Same QVD key-domain mappings and 11 roles as the R3 preflight.
P5FI_MAP_COMP: MAPPING LOAD DISTINCT [%SK_TEMPO_COMPETENCIA], 1 FROM [QVD\DIM_TEMPO.qvd] (qvd);
P5FI_MAP_ANO: MAPPING LOAD DISTINCT [%SK_TEMPO_ANO], 1 FROM [QVD\DIM_TEMPO.qvd] (qvd);
P5FI_MAP_SAIDA: MAPPING LOAD DISTINCT [%SK_TEMPO_DATA], 1 FROM [QVD\DIM_TEMPO.qvd] (qvd);
P5FI_MAP_SERV: MAPPING LOAD DISTINCT [%SK_MUNICIPIO], 1 FROM [QVD\DIM_MUNICIPIO.qvd] (qvd);
P5FI_MAP_EST: MAPPING LOAD DISTINCT [%SK_ESTABELECIMENTO], 1 FROM [QVD\DIM_ESTABELECIMENTO.qvd] (qvd);
P5FI_MAP_PROC: MAPPING LOAD DISTINCT [%SK_PROCEDIMENTO], 1 FROM [QVD\DIM_PROCEDIMENTO.qvd] (qvd);
P5FI_MAP_DIAG: MAPPING LOAD DISTINCT [%SK_DIAGNOSTICO], 1 FROM [QVD\DIM_DIAGNOSTICO.qvd] (qvd);
P5FI_MAP_CAR: MAPPING LOAD DISTINCT [%SK_CARATER_ATENDIMENTO], 1 FROM [QVD\DIM_CARATER_ATENDIMENTO.qvd] (qvd);
P5FI_MAP_MOT: MAPPING LOAD DISTINCT [%SK_MOTIVO_SAIDA], 1 FROM [QVD\DIM_MOTIVO_SAIDA_PERMANENCIA.qvd] (qvd);
IF ScriptErrorCount > $(vFIStartErrors) THEN
    TRACE [V5-FACT] VERDICT=BLOCKED_DIMENSION_INPUT;
    EXIT SCRIPT;
ENDIF

// Keys are copied from the approved SK preflight, dimension-role R3,
// and cross-fact SAD-LINK-V1 coordinate preflight. Do not change Text/Num#
// or argument order without a fresh explicit contract decision.
P5FI_SOURCE:
NOCONCATENATE LOAD
    Hash128('RD',
        Text(_META_SOURCE_FILE), Text(ANO_CMPT), Text(MES_CMPT),
        Text(N_AIH), Text(IDENT), Text(MUNIC_RES), Text(MUNIC_MOV),
        Text(CNES), Text(PROC_SOLIC), Text(PROC_REA), Text(DIAG_PRINC),
        Text(CAR_INT), Text(COBRANCA), Text(DT_INTER), Text(DT_SAIDA),
        Text(DIAS_PERM), Text(VAL_TOT), Text(MORTE)) AS _FI_REG_SK,
    Hash128('MES',Text(Date(Date#(Trim(Text(_META_SOURCE_COMPETENCE)),'YYYYMM'),'YYYYMM'))) AS _FI_C,
    Hash128('ANO',Num#(Trim(Text(ANO_CMPT)),'####','.',',')) AS _FI_Y,
    Hash128('MUN',Trim(Text(MUNIC_RES))) AS _FI_R,
    Hash128('MUN',Trim(Text(MUNIC_MOV))) AS _FI_S,
    Hash128('ESTAB',Trim(Text(CNES)),Trim(Text(_META_SOURCE_COMPETENCE))) AS _FI_E,
    Hash128('DATA',Text(Date(Date#(Trim(Text(DT_INTER)),'YYYYMMDD'),'YYYYMMDD'))) AS _FI_DT_INTER,
    Hash128('DATA',Text(Date(Date#(Trim(Text(DT_SAIDA)),'YYYYMMDD'),'YYYYMMDD'))) AS _FI_DT_SAIDA,
    Hash128('PROC',Text(PROC_REA),Text(_META_SOURCE_COMPETENCE)) AS _FI_PROC,
    Hash128('CID10',Text(RTrim(Text(DIAG_PRINC)))) AS _FI_CID,
    Hash128('CAR',Text(Right('00' & KeepChar(Text(CAR_INT),'0123456789'),2))) AS _FI_CAR,
    Hash128('MOT',Text(Right('00' & KeepChar(Text(COBRANCA),'0123456789'),2))) AS _FI_MOT,
    Text(N_AIH) AS _FI_N_AIH,
    Text(IDENT) AS _FI_IDENT,
    Text(ANO_CMPT) AS _FI_YEAR,
    Text(_META_SOURCE_COMPETENCE) AS _FI_COMPETENCE,
    Text(_META_SOURCE_FILE) AS _FI_SOURCE_FILE,
    1 AS _FI_REG,
    If(Text(IDENT)='1',1,0) AS _FI_NEW,
    Num(DIAS_PERM) AS _FI_DAYS,
    Num#(Trim(Text(VAL_TOT)),'#','.',',') AS _FI_VALUE,
    Num(MORTE) AS _FI_DEATH
FROM [..\EXTRACAO\QVD\SRC_SIH_RD.qvd] (qvd);
IF ScriptErrorCount > $(vFIStartErrors) OR NoOfRows('P5FI_SOURCE')<>566672 THEN
    TRACE [V5-FACT] VERDICT=BLOCKED_STAGING_ROWS;
    EXIT SCRIPT;
ENDIF

P5FI_ROLE_FLAGS:
NOCONCATENATE LOAD
    If(ApplyMap('P5FI_MAP_COMP',_FI_C,0)=1,0,1) AS _FI_MISS_COMP,
    If(ApplyMap('P5FI_MAP_ANO',_FI_Y,0)=1,0,1) AS _FI_MISS_ANO,
    If(ApplyMap('P5FI_MAP_SAIDA',_FI_DT_INTER,0)=1,0,1) AS _FI_MISS_INTER,
    If(ApplyMap('P5FI_MAP_SAIDA',_FI_DT_SAIDA,0)=1,0,1) AS _FI_MISS_SAIDA,
    If(ApplyMap('P5FI_MAP_SERV',_FI_R,0)=1,0,1) AS _FI_MISS_RES,
    If(ApplyMap('P5FI_MAP_SERV',_FI_S,0)=1,0,1) AS _FI_MISS_SERV,
    If(ApplyMap('P5FI_MAP_EST',_FI_E,0)=1,0,1) AS _FI_MISS_EST,
    If(ApplyMap('P5FI_MAP_PROC',_FI_PROC,0)=1,0,1) AS _FI_MISS_PROC,
    If(ApplyMap('P5FI_MAP_DIAG',_FI_CID,0)=1,0,1) AS _FI_MISS_DIAG,
    If(ApplyMap('P5FI_MAP_CAR',_FI_CAR,0)=1,0,1) AS _FI_MISS_CAR,
    If(ApplyMap('P5FI_MAP_MOT',_FI_MOT,0)=1,0,1) AS _FI_MISS_MOT
RESIDENT P5FI_SOURCE;
P5FI_ROLE_SUMMARY:
NOCONCATENATE LOAD
    Sum(_FI_MISS_COMP) AS _FI_M_COMP,
    Sum(_FI_MISS_ANO) AS _FI_M_ANO,
    Sum(_FI_MISS_INTER) AS _FI_M_INTER,
    Sum(_FI_MISS_SAIDA) AS _FI_M_SAIDA,
    Sum(_FI_MISS_RES) AS _FI_M_RES,
    Sum(_FI_MISS_SERV) AS _FI_M_SERV,
    Sum(_FI_MISS_EST) AS _FI_M_EST,
    Sum(_FI_MISS_PROC) AS _FI_M_PROC,
    Sum(_FI_MISS_DIAG) AS _FI_M_DIAG,
    Sum(_FI_MISS_CAR) AS _FI_M_CAR,
    Sum(_FI_MISS_MOT) AS _FI_M_MOT
RESIDENT P5FI_ROLE_FLAGS;
LET vFIMCOMP=Peek('_FI_M_COMP',0,'P5FI_ROLE_SUMMARY');
LET vFIMANO=Peek('_FI_M_ANO',0,'P5FI_ROLE_SUMMARY');
LET vFIMINTER=Peek('_FI_M_INTER',0,'P5FI_ROLE_SUMMARY');
LET vFIMSAIDA=Peek('_FI_M_SAIDA',0,'P5FI_ROLE_SUMMARY');
LET vFIMRES=Peek('_FI_M_RES',0,'P5FI_ROLE_SUMMARY');
LET vFIMSERV=Peek('_FI_M_SERV',0,'P5FI_ROLE_SUMMARY');
LET vFIMEST=Peek('_FI_M_EST',0,'P5FI_ROLE_SUMMARY');
LET vFIMPROC=Peek('_FI_M_PROC',0,'P5FI_ROLE_SUMMARY');
LET vFIMDIAG=Peek('_FI_M_DIAG',0,'P5FI_ROLE_SUMMARY');
LET vFIMCAR=Peek('_FI_M_CAR',0,'P5FI_ROLE_SUMMARY');
LET vFIMMOT=Peek('_FI_M_MOT',0,'P5FI_ROLE_SUMMARY');
TRACE [V5-FACT] ROLES COMP=$(vFIMCOMP) ANO=$(vFIMANO) INTER=$(vFIMINTER) SAIDA=$(vFIMSAIDA) RES=$(vFIMRES) SERV=$(vFIMSERV) EST=$(vFIMEST) PROC=$(vFIMPROC) DIAG=$(vFIMDIAG) CAR=$(vFIMCAR) MOT=$(vFIMMOT);
IF ScriptErrorCount > $(vFIStartErrors) OR $(vFIMCOMP)<>0 OR $(vFIMANO)<>0 OR $(vFIMINTER)<>0 OR $(vFIMSAIDA)<>0 OR $(vFIMRES)<>0 OR $(vFIMSERV)<>0 OR $(vFIMEST)<>0 OR $(vFIMPROC)<>0 OR $(vFIMDIAG)<>0 OR $(vFIMCAR)<>0 OR $(vFIMMOT)<>0 THEN
    TRACE [V5-FACT] VERDICT=BLOCKED_11_DIMENSION_ROLES;
    EXIT SCRIPT;
ENDIF
DROP TABLE P5FI_ROLE_FLAGS;
DROP TABLE P5FI_ROLE_SUMMARY;

// Independent aggregate of source measures and SK. Exact annual totals are
// also checked, to avoid a correct overall sum concealing a shifted year.
P5FI_SOURCE_TOTAL:
NOCONCATENATE LOAD
    Count(*) AS _FI_ROWS,
    Count(DISTINCT _FI_REG_SK) AS _FI_UNIQUE,
    Count(DISTINCT _FI_COMPETENCE) AS _FI_MONTHS,
    Count(DISTINCT _FI_SOURCE_FILE) AS _FI_FILES,
    Sum(If(IsNull(_FI_REG_SK) OR IsNull(_FI_C) OR IsNull(_FI_Y)
        OR IsNull(_FI_R) OR IsNull(_FI_S) OR IsNull(_FI_E),1,0)) AS _FI_NULL_KEYS,
    Sum(_FI_REG) AS _FI_REG_TOTAL,
    Sum(_FI_NEW) AS _FI_NEW_TOTAL,
    Sum(If(_FI_IDENT='5',1,0)) AS _FI_CONT_TOTAL,
    Sum(_FI_DAYS) AS _FI_DAYS_TOTAL,
    Sum(_FI_DEATH) AS _FI_DEATH_TOTAL,
    Sum(Round(_FI_VALUE*100,1)) AS _FI_CENTS_TOTAL,
    Sum(If(Match(_FI_IDENT,'1','5')=0 OR NOT IsNum(_FI_DAYS)
        OR _FI_DAYS<0 OR _FI_DAYS<>Round(_FI_DAYS,1)
        OR NOT IsNum(_FI_VALUE) OR _FI_VALUE<0
        OR Fabs(_FI_VALUE*100-Round(_FI_VALUE*100,1))>0.001
        OR NOT IsNum(_FI_DEATH) OR Match(Text(_FI_DEATH),'0','1')=0,
        1,0)) AS _FI_INVALID
RESIDENT P5FI_SOURCE;
LET vFIRows=Peek('_FI_ROWS',0,'P5FI_SOURCE_TOTAL');
LET vFIUnique=Peek('_FI_UNIQUE',0,'P5FI_SOURCE_TOTAL');
LET vFIMonths=Peek('_FI_MONTHS',0,'P5FI_SOURCE_TOTAL');
LET vFIFiles=Peek('_FI_FILES',0,'P5FI_SOURCE_TOTAL');
LET vFINull=Peek('_FI_NULL_KEYS',0,'P5FI_SOURCE_TOTAL');
LET vFIReg=Peek('_FI_REG_TOTAL',0,'P5FI_SOURCE_TOTAL');
LET vFINew=Peek('_FI_NEW_TOTAL',0,'P5FI_SOURCE_TOTAL');
LET vFICont=Peek('_FI_CONT_TOTAL',0,'P5FI_SOURCE_TOTAL');
LET vFIDays=Peek('_FI_DAYS_TOTAL',0,'P5FI_SOURCE_TOTAL');
LET vFIDeaths=Peek('_FI_DEATH_TOTAL',0,'P5FI_SOURCE_TOTAL');
LET vFICents=Peek('_FI_CENTS_TOTAL',0,'P5FI_SOURCE_TOTAL');
LET vFIInvalid=Peek('_FI_INVALID',0,'P5FI_SOURCE_TOTAL');
DROP TABLE P5FI_SOURCE_TOTAL;
TRACE [V5-FACT] SOURCE ROWS=$(vFIRows) UNIQUE=$(vFIUnique) MONTHS=$(vFIMonths) FILES=$(vFIFiles) NULL=$(vFINull) REG=$(vFIReg) NEW=$(vFINew) CONT=$(vFICont) DAYS=$(vFIDays) DEATHS=$(vFIDeaths) CENTS=$(vFICents) INVALID=$(vFIInvalid);
IF ScriptErrorCount > $(vFIStartErrors) OR $(vFIRows)<>566672 OR $(vFIUnique)<>566672 OR $(vFIMonths)<>36 OR $(vFIFiles)<>36 OR $(vFINull)<>0 OR $(vFIReg)<>566672 OR $(vFINew)<>555089 OR $(vFICont)<>11583 OR $(vFIDays)<>3133578 OR $(vFIDeaths)<>26611 OR $(vFICents)<>65938464905 OR $(vFIInvalid)<>0 THEN
    TRACE [V5-FACT] VERDICT=BLOCKED_SOURCE_RECONCILIATION;
    EXIT SCRIPT;
ENDIF

P5FI_YEAR:
NOCONCATENATE LOAD
    _FI_YEAR AS _FY,
    Count(*) AS _FR,
    Sum(_FI_NEW) AS _FN,
    Sum(If(_FI_IDENT='5',1,0)) AS _FC,
    Sum(_FI_DEATH) AS _FO,
    Sum(_FI_DAYS) AS _FD,
    Sum(Round(_FI_VALUE*100,1)) AS _FV,
    Count(DISTINCT _FI_COMPETENCE) AS _FM
RESIDENT P5FI_SOURCE GROUP BY _FI_YEAR;
P5FI_YEAR_CHECK:
NOCONCATENATE LOAD
    If(
        (_FY='2017' AND _FR=187726 AND _FN=183532 AND _FC=4194 AND _FO=8626 AND _FD=1039396 AND _FV=20888212074 AND _FM=12)
        OR (_FY='2018' AND _FR=187293 AND _FN=183311 AND _FC=3982 AND _FO=8649 AND _FD=1038921 AND _FV=21826753676 AND _FM=12)
        OR (_FY='2019' AND _FR=191653 AND _FN=188246 AND _FC=3407 AND _FO=9336 AND _FD=1055261 AND _FV=23223499155 AND _FM=12),0,1) AS _FB
RESIDENT P5FI_YEAR;
P5FI_YEAR_PROFILE:
NOCONCATENATE LOAD Count(*) AS _FY_COUNT, Sum(_FB) AS _FY_BAD RESIDENT P5FI_YEAR_CHECK;
LET vFIYearCount=Peek('_FY_COUNT',0,'P5FI_YEAR_PROFILE');
LET vFIYearBad=Peek('_FY_BAD',0,'P5FI_YEAR_PROFILE');
DROP TABLE P5FI_YEAR;
DROP TABLE P5FI_YEAR_CHECK;
DROP TABLE P5FI_YEAR_PROFILE;
TRACE [V5-FACT] YEARS=$(vFIYearCount) YEAR_BAD=$(vFIYearBad);
IF ScriptErrorCount > $(vFIStartErrors) OR $(vFIYearCount)<>3 OR $(vFIYearBad)<>0 THEN
    TRACE [V5-FACT] VERDICT=BLOCKED_ANNUAL_MEASURES;
    EXIT SCRIPT;
ENDIF

// Shared dimensions belong ONLY in SAD-LINK-V1 hash. Six exclusive role SKs
// remain on the factual row. No link table and no extra shared fields.
FATO_INTERNACAO:
NOCONCATENATE LOAD
    _FI_REG_SK AS SK_REGISTRO_INTERNACAO,
    Hash128('SAD-LINK-V1',
        'C=' & If(IsNull(_FI_C),'N','V' & Len(Text(_FI_C)) & ':' & Text(_FI_C)),
        'Y=' & If(IsNull(_FI_Y),'N','V' & Len(Text(_FI_Y)) & ':' & Text(_FI_Y)),
        'R=' & If(IsNull(_FI_R),'N','V' & Len(Text(_FI_R)) & ':' & Text(_FI_R)),
        'S=' & If(IsNull(_FI_S),'N','V' & Len(Text(_FI_S)) & ':' & Text(_FI_S)),
        'E=' & If(IsNull(_FI_E),'N','V' & Len(Text(_FI_E)) & ':' & Text(_FI_E))
    ) AS [%LINK_KEY],
    _FI_DT_INTER AS [%SK_TEMPO_INTERNACAO],
    _FI_DT_SAIDA AS [%SK_TEMPO_SAIDA],
    _FI_PROC AS [%SK_PROCEDIMENTO],
    _FI_CID AS [%SK_DIAGNOSTICO],
    _FI_CAR AS [%SK_CARATER_ATENDIMENTO],
    _FI_MOT AS [%SK_MOTIVO_SAIDA],
    _FI_N_AIH AS N_AIH,
    _FI_IDENT AS IDENT,
    _FI_REG AS QTD_REGISTRO_AIH,
    _FI_NEW AS QTD_INTERNACAO,
    _FI_DAYS AS DIAS_PERMANENCIA,
    _FI_VALUE AS VALOR_TOTAL,
    _FI_DEATH AS INDICADOR_OBITO,
    _FI_SOURCE_FILE AS FATO_RD_ARQUIVO_ORIGEM,
    _FI_COMPETENCE AS FATO_RD_COMPETENCIA_ORIGEM
RESIDENT P5FI_SOURCE;
IF ScriptErrorCount > $(vFIStartErrors) OR NoOfRows('FATO_INTERNACAO')<>566672 THEN
    TRACE [V5-FACT] VERDICT=BLOCKED_FACT_LOAD;
    EXIT SCRIPT;
ENDIF
P5FI_OUTPUT:
NOCONCATENATE LOAD
    Count(DISTINCT SK_REGISTRO_INTERNACAO) AS _FOUT_UNIQUE,
    Sum(If(IsNull(SK_REGISTRO_INTERNACAO) OR IsNull([%LINK_KEY]),1,0)) AS _FOUT_NULL,
    Count(DISTINCT [%LINK_KEY]) AS _FOUT_LINKS,
    Sum(QTD_REGISTRO_AIH) AS _FOUT_ROWS,
    Sum(QTD_INTERNACAO) AS _FOUT_NEW,
    Sum(DIAS_PERMANENCIA) AS _FOUT_DAYS,
    Sum(INDICADOR_OBITO) AS _FOUT_DEATHS,
    Sum(Round(VALOR_TOTAL*100,1)) AS _FOUT_CENTS
RESIDENT FATO_INTERNACAO;
LET vFOUnique=Peek('_FOUT_UNIQUE',0,'P5FI_OUTPUT');
LET vFONull=Peek('_FOUT_NULL',0,'P5FI_OUTPUT');
LET vFOLinks=Peek('_FOUT_LINKS',0,'P5FI_OUTPUT');
LET vFORows=Peek('_FOUT_ROWS',0,'P5FI_OUTPUT');
LET vFONew=Peek('_FOUT_NEW',0,'P5FI_OUTPUT');
LET vFODays=Peek('_FOUT_DAYS',0,'P5FI_OUTPUT');
LET vFODeaths=Peek('_FOUT_DEATHS',0,'P5FI_OUTPUT');
LET vFOCents=Peek('_FOUT_CENTS',0,'P5FI_OUTPUT');
DROP TABLE P5FI_OUTPUT;
TRACE [V5-FACT] OUTPUT UNIQUE=$(vFOUnique) NULL=$(vFONull) LINKS=$(vFOLinks) ROWS=$(vFORows) NEW=$(vFONew) DAYS=$(vFODays) DEATHS=$(vFODeaths) CENTS=$(vFOCents);
IF ScriptErrorCount > $(vFIStartErrors) OR $(vFOUnique)<>566672 OR $(vFONull)<>0 OR $(vFOLinks)<=0 OR $(vFORows)<>566672 OR $(vFONew)<>555089 OR $(vFODays)<>3133578 OR $(vFODeaths)<>26611 OR $(vFOCents)<>65938464905 THEN
    TRACE [V5-FACT] VERDICT=BLOCKED_OUTPUT_RECONCILIATION;
    EXIT SCRIPT;
ENDIF
DROP TABLE P5FI_SOURCE;

IF '$(vP5FatoInternacaoMode)' = 'PREFLIGHT' THEN
    TRACE [V5-FACT] VERDICT=PASS_IN_MEMORY_CANDIDATE_ONLY_NOT_PHYSICAL_APPROVAL;
    TRACE [V5-FACT] FACT_QVD_GENERATED=False;
    EXIT SCRIPT;
ENDIF
IF NOT IsNull(FileSize('QVD\FATO_INTERNACAO.qvd')) THEN
    TRACE [V5-FACT] VERDICT=BLOCKED_TARGET_EXISTS_BEFORE_STORE;
    EXIT SCRIPT;
ENDIF
STORE FATO_INTERNACAO INTO [QVD\FATO_INTERNACAO.qvd] (qvd);
IF ScriptErrorCount > $(vFIStartErrors) THEN
    TRACE [V5-FACT] VERDICT=BLOCKED_STORE_CHECK_TARGET_AND_LOG;
    EXIT SCRIPT;
ENDIF
TRACE [V5-FACT] VERDICT=WRITTEN_PENDING_INDEPENDENT_QVD_AUDIT;
TRACE [V5-FACT] LINK_ANALISE_QVD_GENERATED=False PAINEL_NOT_STARTED=True;
