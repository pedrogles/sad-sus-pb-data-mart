// FASE VI — appended ONLY after versioned vi_p1_readonly.qvs has finished.
// Writes only to a unique staging QVD. The runner validates it, then publishes by
// same-directory non-overwriting File.Move. Never STORE directly to LINK_ANALISE.qvd.
// Execution requires separate approval, Windows/QlikView 12 and audited PowerShell.
LET vVILStart=ScriptErrorCount;
TRACE [VI-LINK] START_CREATE_TAIL;
IF NOT IsNull(FileSize('__LINK_DEST__')) THEN
 TRACE [VI-LINK] VERDICT=BLOCKED_DESTINATION_EXISTS; EXIT SCRIPT;
ENDIF
IF NoOfRows('P1_LINK_SIMULADA')<>85705 OR NoOfFields('P1_LINK_SIMULADA')<>6 THEN
 TRACE [VI-LINK] VERDICT=BLOCKED_P1_PRECHECK_SHAPE; EXIT SCRIPT;
ENDIF
VI_LINK_PROFILE:
NOCONCATENATE LOAD
 Count(*) AS TOTAL, Count(DISTINCT [%LINK_KEY]) AS DISTINCT_KEYS,
 Sum(If(IsNull([%LINK_KEY]) OR IsNull([%SK_TEMPO_ANO])
  OR IsNull([%SK_MUNICIPIO_SERVICO]),1,0)) AS BAD_COMMON,
 Sum(If(NOT IsNull([%SK_TEMPO_COMPETENCIA])
  AND NOT IsNull([%SK_MUNICIPIO_RESIDENCIA])
  AND NOT IsNull([%SK_ESTABELECIMENTO]),1,0)) AS RD,
 Sum(If(NOT IsNull([%SK_TEMPO_COMPETENCIA])
  AND IsNull([%SK_MUNICIPIO_RESIDENCIA])
  AND NOT IsNull([%SK_ESTABELECIMENTO]),1,0)) AS LT,
 Sum(If(IsNull([%SK_TEMPO_COMPETENCIA])
  AND NOT IsNull([%SK_MUNICIPIO_RESIDENCIA])
  AND IsNull([%SK_ESTABELECIMENTO]),1,0)) AS POP,
 Sum(If(IsNull([%SK_TEMPO_COMPETENCIA])
  AND NOT IsNull([%SK_MUNICIPIO_RESIDENCIA])
  AND IsNull([%SK_ESTABELECIMENTO])
  AND [%SK_MUNICIPIO_RESIDENCIA]<>[%SK_MUNICIPIO_SERVICO],1,0)) AS POP_ROLE_BAD
RESIDENT P1_LINK_SIMULADA;
LET vVITotal=Peek('TOTAL',0,'VI_LINK_PROFILE');
LET vVIKeys=Peek('DISTINCT_KEYS',0,'VI_LINK_PROFILE');
LET vVIBad=Peek('BAD_COMMON',0,'VI_LINK_PROFILE');
LET vVIRD=Peek('RD',0,'VI_LINK_PROFILE');
LET vVILT=Peek('LT',0,'VI_LINK_PROFILE');
LET vVIPOP=Peek('POP',0,'VI_LINK_PROFILE');
LET vVIPopBad=Peek('POP_ROLE_BAD',0,'VI_LINK_PROFILE');
DROP TABLE VI_LINK_PROFILE;
TRACE [VI-LINK] PRESTORE ROWS=$(vVITotal) KEYS=$(vVIKeys) RD=$(vVIRD) LT=$(vVILT) POP=$(vVIPOP) BAD=$(vVIBad) POP_ROLE_BAD=$(vVIPopBad);
IF ScriptErrorCount>$(vVILStart) OR $(vVITotal)<>85705 OR $(vVIKeys)<>85705
 OR $(vVIRD)<>77550 OR $(vVILT)<>7486 OR $(vVIPOP)<>669
 OR $(vVIBad)<>0 OR $(vVIPopBad)<>0 THEN
 TRACE [VI-LINK] VERDICT=BLOCKED_CONTRACT_BEFORE_STORE; EXIT SCRIPT;
ENDIF
IF NOT IsNull(FileSize('__LINK_DEST__')) THEN
 TRACE [VI-LINK] VERDICT=BLOCKED_DESTINATION_RACE; EXIT SCRIPT;
ENDIF
STORE P1_LINK_SIMULADA INTO [__LINK_DEST__] (qvd);
IF ScriptErrorCount>$(vVILStart) OR IsNull(FileSize('__LINK_DEST__')) THEN
 TRACE [VI-LINK] VERDICT=BLOCKED_STORE_PRESERVE_PARTIAL; EXIT SCRIPT;
ENDIF
TRACE [VI-LINK] VERDICT=PASS_STORE_ONLY_READBACK_REQUIRED;
TRACE [VI-LINK] LINK_KEY_CONTRACT=NOT_APPROVED PRODUCTION_APPROVED=False;
