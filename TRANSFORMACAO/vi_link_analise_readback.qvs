// FASE VI — read only the newly created Link Table and original 3 facts.
// Independent QVW; no data writes or final associative panel.
SET ErrorMode=0;
LET vVIRBStart=ScriptErrorCount;
VI_LINK_RB:
NOCONCATENATE LOAD * FROM [__LINK_DEST__] (qvd);
IF ScriptErrorCount>$(vVIRBStart) OR NoOfRows('VI_LINK_RB')<>85705 OR NoOfFields('VI_LINK_RB')<>6 THEN
 TRACE [VI-LINK-RB] VERDICT=BLOCKED_PHYSICAL_QVD_HEADER; EXIT SCRIPT;
ENDIF
VI_LINK_EXPECTED:
NOCONCATENATE LOAD * INLINE [
FIELD
%LINK_KEY
%SK_TEMPO_COMPETENCIA
%SK_TEMPO_ANO
%SK_MUNICIPIO_RESIDENCIA
%SK_MUNICIPIO_SERVICO
%SK_ESTABELECIMENTO
];
FOR vVIRBI=0 TO 5
 LET vVIRBPos=$(vVIRBI)+1;
 LET vVIRBActual=FieldName($(vVIRBPos),'VI_LINK_RB');
 LET vVIRBExpected=Peek('FIELD',$(vVIRBI),'VI_LINK_EXPECTED');
 IF '$(vVIRBActual)'<>'$(vVIRBExpected)' THEN
  TRACE [VI-LINK-RB] VERDICT=BLOCKED_SCHEMA_FIELD; EXIT SCRIPT;
 ENDIF
NEXT
DROP TABLE VI_LINK_EXPECTED;
VI_LINK_RB_STATS:
NOCONCATENATE LOAD
 Count(*) AS ROWS, Count(DISTINCT [%LINK_KEY]) AS KEYS,
 Sum(If(IsNull([%LINK_KEY]) OR IsNull([%SK_TEMPO_ANO])
  OR IsNull([%SK_MUNICIPIO_SERVICO]),1,0)) AS BAD,
 Sum(If(NOT IsNull([%SK_TEMPO_COMPETENCIA])
  AND NOT IsNull([%SK_MUNICIPIO_RESIDENCIA])
  AND NOT IsNull([%SK_ESTABELECIMENTO]),1,0)) AS RD,
 Sum(If(NOT IsNull([%SK_TEMPO_COMPETENCIA])
  AND IsNull([%SK_MUNICIPIO_RESIDENCIA])
  AND NOT IsNull([%SK_ESTABELECIMENTO]),1,0)) AS LT,
 Sum(If(IsNull([%SK_TEMPO_COMPETENCIA])
  AND NOT IsNull([%SK_MUNICIPIO_RESIDENCIA])
  AND IsNull([%SK_ESTABELECIMENTO]),1,0)) AS POP,
 Sum(If(IsNull([%SK_TEMPO_COMPETENCIA])
  AND NOT IsNull([%SK_MUNICIPIO_RESIDENCIA])
  AND IsNull([%SK_ESTABELECIMENTO])
  AND [%SK_MUNICIPIO_RESIDENCIA]<>[%SK_MUNICIPIO_SERVICO],1,0)) AS BAD_ROLE,
 Sum(If([%LINK_KEY]<>Hash128('SAD-LINK-V1',
 'C=' & If(IsNull([%SK_TEMPO_COMPETENCIA]),'N','V' & Len(Text([%SK_TEMPO_COMPETENCIA])) & ':' & Text([%SK_TEMPO_COMPETENCIA])),
 'Y=' & If(IsNull([%SK_TEMPO_ANO]),'N','V' & Len(Text([%SK_TEMPO_ANO])) & ':' & Text([%SK_TEMPO_ANO])),
 'R=' & If(IsNull([%SK_MUNICIPIO_RESIDENCIA]),'N','V' & Len(Text([%SK_MUNICIPIO_RESIDENCIA])) & ':' & Text([%SK_MUNICIPIO_RESIDENCIA])),
 'S=' & If(IsNull([%SK_MUNICIPIO_SERVICO]),'N','V' & Len(Text([%SK_MUNICIPIO_SERVICO])) & ':' & Text([%SK_MUNICIPIO_SERVICO])),
 'E=' & If(IsNull([%SK_ESTABELECIMENTO]),'N','V' & Len(Text([%SK_ESTABELECIMENTO])) & ':' & Text([%SK_ESTABELECIMENTO]))) ,1,0)) AS BAD_HASH
RESIDENT VI_LINK_RB;
LET vVRRows=Peek('ROWS',0,'VI_LINK_RB_STATS');
LET vVRKeys=Peek('KEYS',0,'VI_LINK_RB_STATS');
LET vVRBad=Peek('BAD',0,'VI_LINK_RB_STATS');
LET vVRRD=Peek('RD',0,'VI_LINK_RB_STATS');
LET vVRLT=Peek('LT',0,'VI_LINK_RB_STATS');
LET vVRPOP=Peek('POP',0,'VI_LINK_RB_STATS');
LET vVRRole=Peek('BAD_ROLE',0,'VI_LINK_RB_STATS');
LET vVRHash=Peek('BAD_HASH',0,'VI_LINK_RB_STATS');
DROP TABLE VI_LINK_RB_STATS;
TRACE [VI-LINK-RB] PHYSICAL ROWS=$(vVRRows) KEYS=$(vVRKeys) RD=$(vVRRD) LT=$(vVRLT) POP=$(vVRPOP) BAD=$(vVRBad) ROLE_BAD=$(vVRRole) HASH_BAD=$(vVRHash);
IF ScriptErrorCount>$(vVIRBStart) OR $(vVRRows)<>85705 OR $(vVRKeys)<>85705
 OR $(vVRRD)<>77550 OR $(vVRLT)<>7486 OR $(vVRPOP)<>669
 OR $(vVRBad)<>0 OR $(vVRRole)<>0 OR $(vVRHash)<>0 THEN
 TRACE [VI-LINK-RB] VERDICT=BLOCKED_LINK_READBACK_COUNTS; EXIT SCRIPT;
ENDIF
VI_LINK_LOOKUP: MAPPING LOAD [%LINK_KEY],1 RESIDENT VI_LINK_RB;
VI_FI_COVERAGE:
NOCONCATENATE LOAD Count(*) AS ROWS,
 Sum(If(IsNull([%LINK_KEY]) OR ApplyMap('VI_LINK_LOOKUP',[%LINK_KEY],0)<>1,1,0)) AS MISSING
FROM [__FI_QVD__] (qvd);
LET vVIFiRows=Peek('ROWS',0,'VI_FI_COVERAGE');
LET vVIFiMiss=Peek('MISSING',0,'VI_FI_COVERAGE');
DROP TABLE VI_FI_COVERAGE;
VI_LT_COVERAGE:
NOCONCATENATE LOAD Count(*) AS ROWS,
 Sum(If(IsNull([%LINK_KEY]) OR ApplyMap('VI_LINK_LOOKUP',[%LINK_KEY],0)<>1,1,0)) AS MISSING
FROM [__LT_FACT_QVD__] (qvd);
LET vVILtRows=Peek('ROWS',0,'VI_LT_COVERAGE');
LET vVILtMiss=Peek('MISSING',0,'VI_LT_COVERAGE');
DROP TABLE VI_LT_COVERAGE;
VI_POP_HASH:
NOCONCATENATE LOAD Hash128('SAD-LINK-V1','C=N',
 'Y=' & If(IsNull([%SK_TEMPO_ANO]),'N','V' & Len(Text([%SK_TEMPO_ANO])) & ':' & Text([%SK_TEMPO_ANO])),
 'R=' & If(IsNull([%SK_MUNICIPIO]),'N','V' & Len(Text([%SK_MUNICIPIO])) & ':' & Text([%SK_MUNICIPIO])),
 'S=' & If(IsNull([%SK_MUNICIPIO]),'N','V' & Len(Text([%SK_MUNICIPIO])) & ':' & Text([%SK_MUNICIPIO])),
 'E=N') AS POP_LINK
FROM [__POP_QVD__] (qvd);
VI_POP_COVERAGE:
NOCONCATENATE LOAD Count(*) AS ROWS,
 Sum(If(IsNull(POP_LINK) OR ApplyMap('VI_LINK_LOOKUP',POP_LINK,0)<>1,1,0)) AS MISSING
RESIDENT VI_POP_HASH;
LET vVIPopRows=Peek('ROWS',0,'VI_POP_COVERAGE');
LET vVIPopMiss=Peek('MISSING',0,'VI_POP_COVERAGE');
DROP TABLE VI_POP_COVERAGE;
DROP TABLE VI_POP_HASH;
TRACE [VI-LINK-RB] FACT_COVERAGE FI=$(vVIFiRows)/$(vVIFiMiss) LT=$(vVILtRows)/$(vVILtMiss) POP=$(vVIPopRows)/$(vVIPopMiss);
IF ScriptErrorCount>$(vVIRBStart) OR $(vVIFiRows)<>566672 OR $(vVIFiMiss)<>0
 OR $(vVILtRows)<>35518 OR $(vVILtMiss)<>0
 OR $(vVIPopRows)<>669 OR $(vVIPopMiss)<>0 THEN
 TRACE [VI-LINK-RB] VERDICT=BLOCKED_FACT_KEY_COVERAGE; EXIT SCRIPT;
ENDIF
TRACE [VI-LINK-RB] VERDICT=PASS_PHYSICAL_QVD_READBACK_CANDIDATE_ONLY;
TRACE [VI-LINK-RB] PANEL_NOT_TESTED=True LINK_KEY_CONTRACT=NOT_APPROVED PRODUCTION_APPROVED=False;
