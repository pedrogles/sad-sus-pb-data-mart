// FASE V — controlled QVD STORE suffix, executed only by isolated one-shot runner.
// Precondition: exactly the previously validated in-memory FATO_CAPACIDADE_LEITO
// built by transf_fato_capacidade_leito.qvs (SHA-256 pinned by runner).
// This file is NOT included in transf_main.qvs and is NOT a general reload path.
// All previous QVDs are read-only. Only target fact may be newly created.
TRACE [V5-CAP-STORE] START_ONE_SHOT_ONLY;
IF '$(vP5CapacidadeCreateAuthorization)' <> 'AUTHORIZED_ONE_SHOT_CREATE_CAPACIDADE_20261015' THEN
    TRACE [V5-CAP-STORE] VERDICT=BLOCKED_MISSING_ONE_SHOT_AUTHORIZATION;
    EXIT SCRIPT;
ENDIF
IF ScriptErrorCount > $(vFLCStartErrors) OR NoOfRows('FATO_CAPACIDADE_LEITO')<>35518 OR NoOfFields('FATO_CAPACIDADE_LEITO')<>11 OR $(vFLCOrows)<>35518 OR $(vFLCOunique)<>35518 OR $(vFLCOlinks)<>7486 OR $(vFLCOnull)<>0 OR $(vFLCOinvalid)<>0 OR $(vFLCOexist)<>337147 OR $(vFLCOsus)<>270076 OR $(vFLCOnsus)<>67071 THEN
    TRACE [V5-CAP-STORE] VERDICT=BLOCKED_IN_MEMORY_FACT_GATE;
    EXIT SCRIPT;
ENDIF
IF NOT IsNull(FileSize('QVD\FATO_CAPACIDADE_LEITO.qvd')) THEN
    TRACE [V5-CAP-STORE] VERDICT=BLOCKED_TARGET_EXISTS_NO_OVERWRITE;
    EXIT SCRIPT;
ENDIF
STORE FATO_CAPACIDADE_LEITO INTO [QVD\FATO_CAPACIDADE_LEITO.qvd] (qvd);
IF ScriptErrorCount > $(vFLCStartErrors) THEN
    TRACE [V5-CAP-STORE] VERDICT=BLOCKED_STORE_INSPECT_TARGET_AND_LOG;
    EXIT SCRIPT;
ENDIF
TRACE [V5-CAP-STORE] ROWS=35518 UNIQUE=35518 LINKS=7486 EXIST=337147 SUS=270076 NSUS=67071 FIELDS=11;
TRACE [V5-CAP-STORE] VERDICT=WRITTEN_PENDING_INDEPENDENT_QVD_AUDIT;
TRACE [V5-CAP-STORE] LINK_ANALISE_QVD_GENERATED=False PRODUCTION_APPROVED=False;
