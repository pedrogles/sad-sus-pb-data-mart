// FASE III — Extração / staging
// Script versionável carregado por EXTRACAO/EXT.qvw.
//
// Este checkpoint implementa somente o staging das fontes de saúde já
// completamente validadas: SIH/RD, CNES/LT e CNES/ST.
// IBGE e referências auxiliares permanecem pendentes de inspeção/materialização
// física antes do fechamento da Fase III.
//
// Não construir fatos, dimensões ou LINK_ANALISE neste script.

SET ErrorMode=0;

LET vExtractionErrorsBefore = ScriptErrorCount;

TRACE [EXTRACAO] Phase III-A health staging start;

// -----------------------------------------------------------------------------
// SIH/RD
// -----------------------------------------------------------------------------

LET vRDFiles = 0;

FOR EACH vFile IN FileList('..\BASE\CONVERTIDA\RD\RDPB*.csv')

    LET vRDFiles = $(vRDFiles) + 1;

    IF $(vRDFiles) = 1 THEN

        SRC_SIH_RD:
        LOAD
            Text(ANO_CMPT) AS ANO_CMPT,
            Text(MES_CMPT) AS MES_CMPT,
            Text(N_AIH) AS N_AIH,
            Text(IDENT) AS IDENT,
            Text(MUNIC_RES) AS MUNIC_RES,
            Text(MUNIC_MOV) AS MUNIC_MOV,
            Text(CNES) AS CNES,
            Text(PROC_SOLIC) AS PROC_SOLIC,
            Text(PROC_REA) AS PROC_REA,
            Text(DIAG_PRINC) AS DIAG_PRINC,
            Text(CAR_INT) AS CAR_INT,
            Text(COBRANCA) AS COBRANCA,
            Text(DT_INTER) AS DT_INTER,
            Text(DT_SAIDA) AS DT_SAIDA,
            DIAS_PERM,
            VAL_TOT,
            MORTE,
            FileName() AS _META_SOURCE_FILE,
            'RD' AS _META_SOURCE_FAMILY,
            '20' & Mid(FileBaseName(), 5, 4) AS _META_SOURCE_COMPETENCE,
            FilePath() AS _META_SOURCE_PATH
        FROM [$(vFile)]
        (txt, utf8, embedded labels, delimiter is ';', msq);

    ELSE

        Concatenate (SRC_SIH_RD)
        LOAD
            Text(ANO_CMPT) AS ANO_CMPT,
            Text(MES_CMPT) AS MES_CMPT,
            Text(N_AIH) AS N_AIH,
            Text(IDENT) AS IDENT,
            Text(MUNIC_RES) AS MUNIC_RES,
            Text(MUNIC_MOV) AS MUNIC_MOV,
            Text(CNES) AS CNES,
            Text(PROC_SOLIC) AS PROC_SOLIC,
            Text(PROC_REA) AS PROC_REA,
            Text(DIAG_PRINC) AS DIAG_PRINC,
            Text(CAR_INT) AS CAR_INT,
            Text(COBRANCA) AS COBRANCA,
            Text(DT_INTER) AS DT_INTER,
            Text(DT_SAIDA) AS DT_SAIDA,
            DIAS_PERM,
            VAL_TOT,
            MORTE,
            FileName() AS _META_SOURCE_FILE,
            'RD' AS _META_SOURCE_FAMILY,
            '20' & Mid(FileBaseName(), 5, 4) AS _META_SOURCE_COMPETENCE,
            FilePath() AS _META_SOURCE_PATH
        FROM [$(vFile)]
        (txt, utf8, embedded labels, delimiter is ';', msq);

    ENDIF

NEXT vFile

IF ScriptErrorCount > $(vExtractionErrorsBefore) THEN
    TRACE [EXTRACAO][RD] LOAD failed. Errors=$(ScriptErrorList);
    EXIT SCRIPT;
ENDIF

IF $(vRDFiles) <> 36 THEN
    TRACE [EXTRACAO][RD] file count mismatch. Expected=36 Actual=$(vRDFiles);
    EXIT SCRIPT;
ENDIF

LET vRDRows = NoOfRows('SRC_SIH_RD');

IF $(vRDRows) <> 566672 THEN
    TRACE [EXTRACAO][RD] row count mismatch. Expected=566672 Actual=$(vRDRows);
    EXIT SCRIPT;
ENDIF

TMP_RD_CHECK:
LOAD
    Count(DISTINCT _META_SOURCE_COMPETENCE) AS distinct_competence_count,
    Sum(
        If(
            Right('0000' & Trim(ANO_CMPT), 4)
                & Right('00' & Trim(MES_CMPT), 2)
                <> _META_SOURCE_COMPETENCE,
            1,
            0
        )
    ) AS competence_mismatch
RESIDENT SRC_SIH_RD;

LET vRDDistinctCompetences = Peek('distinct_competence_count', 0, 'TMP_RD_CHECK');
LET vRDCompetenceMismatch = Peek('competence_mismatch', 0, 'TMP_RD_CHECK');

DROP TABLE TMP_RD_CHECK;

IF $(vRDDistinctCompetences) <> 36 THEN
    TRACE [EXTRACAO][RD] competence coverage mismatch. Expected=36 Actual=$(vRDDistinctCompetences);
    EXIT SCRIPT;
ENDIF

IF $(vRDCompetenceMismatch) <> 0 THEN
    TRACE [EXTRACAO][RD] source competence mismatch. Count=$(vRDCompetenceMismatch);
    EXIT SCRIPT;
ENDIF

STORE SRC_SIH_RD INTO [QVD\SRC_SIH_RD.qvd] (qvd);

IF ScriptErrorCount > $(vExtractionErrorsBefore) THEN
    TRACE [EXTRACAO][RD] QVD STORE failed. Errors=$(ScriptErrorList);
    EXIT SCRIPT;
ENDIF

TRACE [EXTRACAO][RD] PASS files=$(vRDFiles) rows=$(vRDRows) competences=$(vRDDistinctCompetences);

DROP TABLE SRC_SIH_RD;

// -----------------------------------------------------------------------------
// CNES/LT
// -----------------------------------------------------------------------------

LET vLTFiles = 0;

FOR EACH vFile IN FileList('..\BASE\CONVERTIDA\LT\LTPB*.csv')

    LET vLTFiles = $(vLTFiles) + 1;

    IF $(vLTFiles) = 1 THEN

        SRC_CNES_LT:
        LOAD
            Text(CNES) AS CNES,
            Text(CODUFMUN) AS CODUFMUN,
            Text(TP_LEITO) AS TP_LEITO,
            Text(CODLEITO) AS CODLEITO,
            QT_EXIST,
            QT_SUS,
            QT_NSUS,
            Text(COMPETEN) AS COMPETEN,
            FileName() AS _META_SOURCE_FILE,
            'LT' AS _META_SOURCE_FAMILY,
            '20' & Mid(FileBaseName(), 5, 4) AS _META_SOURCE_COMPETENCE,
            FilePath() AS _META_SOURCE_PATH
        FROM [$(vFile)]
        (txt, utf8, embedded labels, delimiter is ';', msq);

    ELSE

        Concatenate (SRC_CNES_LT)
        LOAD
            Text(CNES) AS CNES,
            Text(CODUFMUN) AS CODUFMUN,
            Text(TP_LEITO) AS TP_LEITO,
            Text(CODLEITO) AS CODLEITO,
            QT_EXIST,
            QT_SUS,
            QT_NSUS,
            Text(COMPETEN) AS COMPETEN,
            FileName() AS _META_SOURCE_FILE,
            'LT' AS _META_SOURCE_FAMILY,
            '20' & Mid(FileBaseName(), 5, 4) AS _META_SOURCE_COMPETENCE,
            FilePath() AS _META_SOURCE_PATH
        FROM [$(vFile)]
        (txt, utf8, embedded labels, delimiter is ';', msq);

    ENDIF

NEXT vFile

IF ScriptErrorCount > $(vExtractionErrorsBefore) THEN
    TRACE [EXTRACAO][LT] LOAD failed. Errors=$(ScriptErrorList);
    EXIT SCRIPT;
ENDIF

IF $(vLTFiles) <> 36 THEN
    TRACE [EXTRACAO][LT] file count mismatch. Expected=36 Actual=$(vLTFiles);
    EXIT SCRIPT;
ENDIF

LET vLTRows = NoOfRows('SRC_CNES_LT');

IF $(vLTRows) <> 35518 THEN
    TRACE [EXTRACAO][LT] row count mismatch. Expected=35518 Actual=$(vLTRows);
    EXIT SCRIPT;
ENDIF

TMP_LT_CHECK:
LOAD
    Count(DISTINCT _META_SOURCE_COMPETENCE) AS distinct_competence_count,
    Sum(
        If(
            Right('000000' & Trim(COMPETEN), 6)
                <> _META_SOURCE_COMPETENCE,
            1,
            0
        )
    ) AS competence_mismatch
RESIDENT SRC_CNES_LT;

LET vLTDistinctCompetences = Peek('distinct_competence_count', 0, 'TMP_LT_CHECK');
LET vLTCompetenceMismatch = Peek('competence_mismatch', 0, 'TMP_LT_CHECK');

DROP TABLE TMP_LT_CHECK;

IF $(vLTDistinctCompetences) <> 36 THEN
    TRACE [EXTRACAO][LT] competence coverage mismatch. Expected=36 Actual=$(vLTDistinctCompetences);
    EXIT SCRIPT;
ENDIF

IF $(vLTCompetenceMismatch) <> 0 THEN
    TRACE [EXTRACAO][LT] source competence mismatch. Count=$(vLTCompetenceMismatch);
    EXIT SCRIPT;
ENDIF

STORE SRC_CNES_LT INTO [QVD\SRC_CNES_LT.qvd] (qvd);

IF ScriptErrorCount > $(vExtractionErrorsBefore) THEN
    TRACE [EXTRACAO][LT] QVD STORE failed. Errors=$(ScriptErrorList);
    EXIT SCRIPT;
ENDIF

TRACE [EXTRACAO][LT] PASS files=$(vLTFiles) rows=$(vLTRows) competences=$(vLTDistinctCompetences);

DROP TABLE SRC_CNES_LT;

// -----------------------------------------------------------------------------
// CNES/ST
// -----------------------------------------------------------------------------

LET vSTFiles = 0;

FOR EACH vFile IN FileList('..\BASE\CONVERTIDA\ST\STPB*.csv')

    LET vSTFiles = $(vSTFiles) + 1;

    IF $(vSTFiles) = 1 THEN

        SRC_CNES_ST:
        LOAD
            Text(CNES) AS CNES,
            Text(CODUFMUN) AS CODUFMUN,
            Text(COD_CEP) AS COD_CEP,
            Text(CNPJ_MAN) AS CNPJ_MAN,
            Text(VINC_SUS) AS VINC_SUS,
            Text(TPGESTAO) AS TPGESTAO,
            Text(TP_UNID) AS TP_UNID,
            Text(NATUREZA) AS NATUREZA,
            Text(NAT_JUR) AS NAT_JUR,
            Text(COMPETEN) AS COMPETEN,
            FileName() AS _META_SOURCE_FILE,
            'ST' AS _META_SOURCE_FAMILY,
            '20' & Mid(FileBaseName(), 5, 4) AS _META_SOURCE_COMPETENCE,
            FilePath() AS _META_SOURCE_PATH
        FROM [$(vFile)]
        (txt, utf8, embedded labels, delimiter is ';', msq);

    ELSE

        Concatenate (SRC_CNES_ST)
        LOAD
            Text(CNES) AS CNES,
            Text(CODUFMUN) AS CODUFMUN,
            Text(COD_CEP) AS COD_CEP,
            Text(CNPJ_MAN) AS CNPJ_MAN,
            Text(VINC_SUS) AS VINC_SUS,
            Text(TPGESTAO) AS TPGESTAO,
            Text(TP_UNID) AS TP_UNID,
            Text(NATUREZA) AS NATUREZA,
            Text(NAT_JUR) AS NAT_JUR,
            Text(COMPETEN) AS COMPETEN,
            FileName() AS _META_SOURCE_FILE,
            'ST' AS _META_SOURCE_FAMILY,
            '20' & Mid(FileBaseName(), 5, 4) AS _META_SOURCE_COMPETENCE,
            FilePath() AS _META_SOURCE_PATH
        FROM [$(vFile)]
        (txt, utf8, embedded labels, delimiter is ';', msq);

    ENDIF

NEXT vFile

IF ScriptErrorCount > $(vExtractionErrorsBefore) THEN
    TRACE [EXTRACAO][ST] LOAD failed. Errors=$(ScriptErrorList);
    EXIT SCRIPT;
ENDIF

IF $(vSTFiles) <> 36 THEN
    TRACE [EXTRACAO][ST] file count mismatch. Expected=36 Actual=$(vSTFiles);
    EXIT SCRIPT;
ENDIF

LET vSTRows = NoOfRows('SRC_CNES_ST');

IF $(vSTRows) <> 220390 THEN
    TRACE [EXTRACAO][ST] row count mismatch. Expected=220390 Actual=$(vSTRows);
    EXIT SCRIPT;
ENDIF

TMP_ST_CHECK:
LOAD
    Count(DISTINCT _META_SOURCE_COMPETENCE) AS distinct_competence_count,
    Sum(
        If(
            Right('000000' & Trim(COMPETEN), 6)
                <> _META_SOURCE_COMPETENCE,
            1,
            0
        )
    ) AS competence_mismatch
RESIDENT SRC_CNES_ST;

LET vSTDistinctCompetences = Peek('distinct_competence_count', 0, 'TMP_ST_CHECK');
LET vSTCompetenceMismatch = Peek('competence_mismatch', 0, 'TMP_ST_CHECK');

DROP TABLE TMP_ST_CHECK;

IF $(vSTDistinctCompetences) <> 36 THEN
    TRACE [EXTRACAO][ST] competence coverage mismatch. Expected=36 Actual=$(vSTDistinctCompetences);
    EXIT SCRIPT;
ENDIF

IF $(vSTCompetenceMismatch) <> 0 THEN
    TRACE [EXTRACAO][ST] source competence mismatch. Count=$(vSTCompetenceMismatch);
    EXIT SCRIPT;
ENDIF

STORE SRC_CNES_ST INTO [QVD\SRC_CNES_ST.qvd] (qvd);

IF ScriptErrorCount > $(vExtractionErrorsBefore) THEN
    TRACE [EXTRACAO][ST] QVD STORE failed. Errors=$(ScriptErrorList);
    EXIT SCRIPT;
ENDIF

TRACE [EXTRACAO][ST] PASS files=$(vSTFiles) rows=$(vSTRows) competences=$(vSTDistinctCompetences);

DROP TABLE SRC_CNES_ST;

// -----------------------------------------------------------------------------
// Partial checkpoint only.
// Full extraction success remains blocked until IBGE and auxiliary references
// are implemented and reconciled.
// -----------------------------------------------------------------------------

EXTRACAO_SAUDE_CHECKPOINT:
LOAD
    Timestamp(Now(1)) AS generated_at,
    'EXTRACAO_SAUDE' AS stage,
    'PASS_PARTIAL' AS status,
    $(vRDFiles) AS rd_files,
    $(vRDRows) AS rd_rows,
    $(vLTFiles) AS lt_files,
    $(vLTRows) AS lt_rows,
    $(vSTFiles) AS st_files,
    $(vSTRows) AS st_rows
AUTOGENERATE 1;

STORE EXTRACAO_SAUDE_CHECKPOINT INTO [QVD\_CHECKPOINT_EXTRACAO_SAUDE.csv]
(txt, utf8, delimiter is ';', embedded labels);

IF ScriptErrorCount > $(vExtractionErrorsBefore) THEN
    TRACE [EXTRACAO] health checkpoint STORE failed. Errors=$(ScriptErrorList);
    EXIT SCRIPT;
ENDIF

DROP TABLE EXTRACAO_SAUDE_CHECKPOINT;

TRACE [EXTRACAO] PHASE_III_A_HEALTH_STAGING_PASS RD=$(vRDRows) LT=$(vLTRows) ST=$(vSTRows);

// -----------------------------------------------------------------------------
// IBGE — estimativas populacionais municipais 2017–2019
// -----------------------------------------------------------------------------

TRACE [EXTRACAO] Phase III-B IBGE staging start;

// QlikView 12 interpretou o literal UTF-8 "Municípios$" do include .qvs como
// mojibake no primeiro reload local. Para evitar dependência da codificação do
// arquivo de script, os caracteres acentuados usados por BIFF/schema são
// construídos em runtime.
LET vIBGESheet = 'Munic' & Chr(237) & 'pios
// - planilha: Municípios
// - linha 1: título
// - linha 2: cabeçalho
// - colunas úteis: UF, COD. UF, COD. MUNIC, NOME DO MUNICÍPIO, POPULAÇÃO ESTIMADA
//
// O header é lido dinamicamente por posição somente para descobrir os nomes
// efetivos dos cinco primeiros campos. Em seguida, esses nomes são validados
// antes da carga de staging.

FOR EACH vIBGEYear IN '2017', '2018', '2019'

    IF '$(vIBGEYear)' = '2017' THEN
        LET vIBGEFile = '..\BASE\IBGE\estimativa_dou_2017.xls';
        LET vIBGEExpectedPopulation = 4025558;
    ELSEIF '$(vIBGEYear)' = '2018' THEN
        LET vIBGEFile = '..\BASE\IBGE\estimativa_dou_2018_20181019.xls';
        LET vIBGEExpectedPopulation = 3996496;
    ELSE
        LET vIBGEFile = '..\BASE\IBGE\estimativa_dou_2019.xls';
        LET vIBGEExpectedPopulation = 4018127;
    ENDIF

    IBGE_RAW:
    LOAD
        *,
        FileName() AS _META_SOURCE_FILE_RAW,
        FilePath() AS _META_SOURCE_PATH_RAW
    FROM [$(vIBGEFile)]
    (biff, embedded labels, table is [$(vIBGESheet)], header is 1 lines);

    IF ScriptErrorCount > $(vExtractionErrorsBefore) THEN
        TRACE [EXTRACAO][IBGE][$(vIBGEYear)] XLS LOAD failed. Errors=$(ScriptErrorList);
        EXIT SCRIPT;
    ENDIF

    LET vIBGEFieldUF = FieldName(1, 'IBGE_RAW');
    LET vIBGEFieldCodUF = FieldName(2, 'IBGE_RAW');
    LET vIBGEFieldCodMun = FieldName(3, 'IBGE_RAW');
    LET vIBGEFieldNome = FieldName(4, 'IBGE_RAW');
    LET vIBGEFieldPop = FieldName(5, 'IBGE_RAW');

    IF Trim('$(vIBGEFieldUF)') <> 'UF' THEN
        TRACE [EXTRACAO][IBGE][$(vIBGEYear)] unexpected field 1. Actual=$(vIBGEFieldUF);
        EXIT SCRIPT;
    ENDIF

    IF Trim('$(vIBGEFieldCodUF)') <> 'COD. UF' THEN
        TRACE [EXTRACAO][IBGE][$(vIBGEYear)] unexpected field 2. Actual=$(vIBGEFieldCodUF);
        EXIT SCRIPT;
    ENDIF

    IF Trim('$(vIBGEFieldCodMun)') <> 'COD. MUNIC' THEN
        TRACE [EXTRACAO][IBGE][$(vIBGEYear)] unexpected field 3. Actual=$(vIBGEFieldCodMun);
        EXIT SCRIPT;
    ENDIF

    IF Trim('$(vIBGEFieldNome)') <> '$(vIBGEExpectedFieldNome)' THEN
        TRACE [EXTRACAO][IBGE][$(vIBGEYear)] unexpected field 4. Actual=$(vIBGEFieldNome);
        EXIT SCRIPT;
    ENDIF

    IF Trim('$(vIBGEFieldPop)') <> '$(vIBGEExpectedFieldPop)' THEN
        TRACE [EXTRACAO][IBGE][$(vIBGEYear)] unexpected field 5. Actual=$(vIBGEFieldPop);
        EXIT SCRIPT;
    ENDIF

    IF '$(vIBGEYear)' = '2017' THEN

        SRC_IBGE_POPULACAO:
        LOAD
            '$(vIBGEYear)' AS ANO_REFERENCIA,
            Trim([$(vIBGEFieldUF)]) AS UF,
            Right('00' & KeepChar(Text([$(vIBGEFieldCodUF)]), '0123456789'), 2) AS COD_UF_IBGE_2,
            Right('00000' & KeepChar(Text([$(vIBGEFieldCodMun)]), '0123456789'), 5) AS COD_MUNIC_IBGE_5,
            Right('00' & KeepChar(Text([$(vIBGEFieldCodUF)]), '0123456789'), 2)
                & Right('00000' & KeepChar(Text([$(vIBGEFieldCodMun)]), '0123456789'), 5) AS COD_IBGE_7,
            Trim([$(vIBGEFieldNome)]) AS NOME_MUNICIPIO,
            Num#(
                KeepChar(Text([$(vIBGEFieldPop)]), '0123456789'),
                '###############'
            ) AS POPULACAO_ESTIMADA,
            _META_SOURCE_FILE_RAW AS _META_SOURCE_FILE,
            'IBGE_POPULACAO' AS _META_SOURCE_FAMILY,
            '$(vIBGEYear)' AS _META_SOURCE_YEAR,
            _META_SOURCE_PATH_RAW AS _META_SOURCE_PATH
        RESIDENT IBGE_RAW
        WHERE Trim([$(vIBGEFieldUF)]) = 'PB';

    ELSE

        Concatenate (SRC_IBGE_POPULACAO)
        LOAD
            '$(vIBGEYear)' AS ANO_REFERENCIA,
            Trim([$(vIBGEFieldUF)]) AS UF,
            Right('00' & KeepChar(Text([$(vIBGEFieldCodUF)]), '0123456789'), 2) AS COD_UF_IBGE_2,
            Right('00000' & KeepChar(Text([$(vIBGEFieldCodMun)]), '0123456789'), 5) AS COD_MUNIC_IBGE_5,
            Right('00' & KeepChar(Text([$(vIBGEFieldCodUF)]), '0123456789'), 2)
                & Right('00000' & KeepChar(Text([$(vIBGEFieldCodMun)]), '0123456789'), 5) AS COD_IBGE_7,
            Trim([$(vIBGEFieldNome)]) AS NOME_MUNICIPIO,
            Num#(
                KeepChar(Text([$(vIBGEFieldPop)]), '0123456789'),
                '###############'
            ) AS POPULACAO_ESTIMADA,
            _META_SOURCE_FILE_RAW AS _META_SOURCE_FILE,
            'IBGE_POPULACAO' AS _META_SOURCE_FAMILY,
            '$(vIBGEYear)' AS _META_SOURCE_YEAR,
            _META_SOURCE_PATH_RAW AS _META_SOURCE_PATH
        RESIDENT IBGE_RAW
        WHERE Trim([$(vIBGEFieldUF)]) = 'PB';

    ENDIF

    DROP TABLE IBGE_RAW;

    IF ScriptErrorCount > $(vExtractionErrorsBefore) THEN
        TRACE [EXTRACAO][IBGE][$(vIBGEYear)] staging LOAD failed. Errors=$(ScriptErrorList);
        EXIT SCRIPT;
    ENDIF

    TMP_IBGE_YEAR_CHECK:
    LOAD
        Count(*) AS row_count,
        Count(DISTINCT COD_IBGE_7) AS distinct_municipality_count,
        Sum(POPULACAO_ESTIMADA) AS population_sum
    RESIDENT SRC_IBGE_POPULACAO
    WHERE ANO_REFERENCIA = '$(vIBGEYear)';

    LET vIBGERowsYear = Peek('row_count', 0, 'TMP_IBGE_YEAR_CHECK');
    LET vIBGEDistinctMunicipalitiesYear = Peek('distinct_municipality_count', 0, 'TMP_IBGE_YEAR_CHECK');
    LET vIBGEPopulationYear = Peek('population_sum', 0, 'TMP_IBGE_YEAR_CHECK');

    DROP TABLE TMP_IBGE_YEAR_CHECK;

    IF $(vIBGERowsYear) <> 223 THEN
        TRACE [EXTRACAO][IBGE][$(vIBGEYear)] row count mismatch. Expected=223 Actual=$(vIBGERowsYear);
        EXIT SCRIPT;
    ENDIF

    IF $(vIBGEDistinctMunicipalitiesYear) <> 223 THEN
        TRACE [EXTRACAO][IBGE][$(vIBGEYear)] municipality uniqueness mismatch. Expected=223 Actual=$(vIBGEDistinctMunicipalitiesYear);
        EXIT SCRIPT;
    ENDIF

    IF $(vIBGEPopulationYear) <> $(vIBGEExpectedPopulation) THEN
        TRACE [EXTRACAO][IBGE][$(vIBGEYear)] population total mismatch. Expected=$(vIBGEExpectedPopulation) Actual=$(vIBGEPopulationYear);
        EXIT SCRIPT;
    ENDIF

    TRACE [EXTRACAO][IBGE][$(vIBGEYear)] PASS rows=$(vIBGERowsYear) population=$(vIBGEPopulationYear);

NEXT vIBGEYear

LET vIBGERows = NoOfRows('SRC_IBGE_POPULACAO');

IF $(vIBGERows) <> 669 THEN
    TRACE [EXTRACAO][IBGE] total row count mismatch. Expected=669 Actual=$(vIBGERows);
    EXIT SCRIPT;
ENDIF

TMP_IBGE_FINAL_CHECK:
LOAD
    Count(DISTINCT COD_IBGE_7 & '|' & ANO_REFERENCIA) AS distinct_grain_count,
    Count(DISTINCT ANO_REFERENCIA) AS distinct_year_count
RESIDENT SRC_IBGE_POPULACAO;

LET vIBGEDistinctGrain = Peek('distinct_grain_count', 0, 'TMP_IBGE_FINAL_CHECK');
LET vIBGEDistinctYears = Peek('distinct_year_count', 0, 'TMP_IBGE_FINAL_CHECK');

DROP TABLE TMP_IBGE_FINAL_CHECK;

IF $(vIBGEDistinctGrain) <> 669 THEN
    TRACE [EXTRACAO][IBGE] grain uniqueness mismatch. Expected=669 Actual=$(vIBGEDistinctGrain);
    EXIT SCRIPT;
ENDIF

IF $(vIBGEDistinctYears) <> 3 THEN
    TRACE [EXTRACAO][IBGE] year coverage mismatch. Expected=3 Actual=$(vIBGEDistinctYears);
    EXIT SCRIPT;
ENDIF

STORE SRC_IBGE_POPULACAO INTO [QVD\SRC_IBGE_POPULACAO.qvd] (qvd);

IF ScriptErrorCount > $(vExtractionErrorsBefore) THEN
    TRACE [EXTRACAO][IBGE] QVD STORE failed. Errors=$(ScriptErrorList);
    EXIT SCRIPT;
ENDIF

TRACE [EXTRACAO][IBGE] PASS rows=$(vIBGERows) years=$(vIBGEDistinctYears);

DROP TABLE SRC_IBGE_POPULACAO;

EXTRACAO_IBGE_CHECKPOINT:
LOAD
    Timestamp(Now(1)) AS generated_at,
    'EXTRACAO_IBGE' AS stage,
    'PASS_PARTIAL' AS status,
    $(vIBGERows) AS ibge_rows,
    223 AS municipalities_2017,
    4025558 AS population_2017,
    223 AS municipalities_2018,
    3996496 AS population_2018,
    223 AS municipalities_2019,
    4018127 AS population_2019
AUTOGENERATE 1;

STORE EXTRACAO_IBGE_CHECKPOINT INTO [QVD\_CHECKPOINT_EXTRACAO_IBGE.csv]
(txt, utf8, delimiter is ';', embedded labels);

IF ScriptErrorCount > $(vExtractionErrorsBefore) THEN
    TRACE [EXTRACAO][IBGE] checkpoint STORE failed. Errors=$(ScriptErrorList);
    EXIT SCRIPT;
ENDIF

DROP TABLE EXTRACAO_IBGE_CHECKPOINT;

TRACE [EXTRACAO] PHASE_III_B_IBGE_STAGING_PASS ROWS=$(vIBGERows);
TRACE [EXTRACAO] PARTIAL ONLY — auxiliary references remain pending; no final extraction success marker emitted.
;
LET vIBGEExpectedFieldNome = 'NOME DO MUNIC' & Chr(205) & 'PIO';
LET vIBGEExpectedFieldPop = 'POPULA' & Chr(199) & Chr(195) & 'O ESTIMADA';

// A inspeção física confirmou:
// - planilha: Municípios
// - linha 1: título
// - linha 2: cabeçalho
// - colunas úteis: UF, COD. UF, COD. MUNIC, NOME DO MUNICÍPIO, POPULAÇÃO ESTIMADA
//
// O header é lido dinamicamente por posição somente para descobrir os nomes
// efetivos dos cinco primeiros campos. Em seguida, esses nomes são validados
// antes da carga de staging.

FOR EACH vIBGEYear IN '2017', '2018', '2019'

    IF '$(vIBGEYear)' = '2017' THEN
        LET vIBGEFile = '..\BASE\IBGE\estimativa_dou_2017.xls';
        LET vIBGEExpectedPopulation = 4025558;
    ELSEIF '$(vIBGEYear)' = '2018' THEN
        LET vIBGEFile = '..\BASE\IBGE\estimativa_dou_2018_20181019.xls';
        LET vIBGEExpectedPopulation = 3996496;
    ELSE
        LET vIBGEFile = '..\BASE\IBGE\estimativa_dou_2019.xls';
        LET vIBGEExpectedPopulation = 4018127;
    ENDIF

    IBGE_RAW:
    LOAD
        *,
        FileName() AS _META_SOURCE_FILE_RAW,
        FilePath() AS _META_SOURCE_PATH_RAW
    FROM [$(vIBGEFile)]
    (biff, embedded labels, table is [Municípios$], header is 1 lines);

    IF ScriptErrorCount > $(vExtractionErrorsBefore) THEN
        TRACE [EXTRACAO][IBGE][$(vIBGEYear)] XLS LOAD failed. Errors=$(ScriptErrorList);
        EXIT SCRIPT;
    ENDIF

    LET vIBGEFieldUF = FieldName(1, 'IBGE_RAW');
    LET vIBGEFieldCodUF = FieldName(2, 'IBGE_RAW');
    LET vIBGEFieldCodMun = FieldName(3, 'IBGE_RAW');
    LET vIBGEFieldNome = FieldName(4, 'IBGE_RAW');
    LET vIBGEFieldPop = FieldName(5, 'IBGE_RAW');

    IF Trim('$(vIBGEFieldUF)') <> 'UF' THEN
        TRACE [EXTRACAO][IBGE][$(vIBGEYear)] unexpected field 1. Actual=$(vIBGEFieldUF);
        EXIT SCRIPT;
    ENDIF

    IF Trim('$(vIBGEFieldCodUF)') <> 'COD. UF' THEN
        TRACE [EXTRACAO][IBGE][$(vIBGEYear)] unexpected field 2. Actual=$(vIBGEFieldCodUF);
        EXIT SCRIPT;
    ENDIF

    IF Trim('$(vIBGEFieldCodMun)') <> 'COD. MUNIC' THEN
        TRACE [EXTRACAO][IBGE][$(vIBGEYear)] unexpected field 3. Actual=$(vIBGEFieldCodMun);
        EXIT SCRIPT;
    ENDIF

    IF Trim('$(vIBGEFieldNome)') <> 'NOME DO MUNICÍPIO' THEN
        TRACE [EXTRACAO][IBGE][$(vIBGEYear)] unexpected field 4. Actual=$(vIBGEFieldNome);
        EXIT SCRIPT;
    ENDIF

    IF Trim('$(vIBGEFieldPop)') <> 'POPULAÇÃO ESTIMADA' THEN
        TRACE [EXTRACAO][IBGE][$(vIBGEYear)] unexpected field 5. Actual=$(vIBGEFieldPop);
        EXIT SCRIPT;
    ENDIF

    IF '$(vIBGEYear)' = '2017' THEN

        SRC_IBGE_POPULACAO:
        LOAD
            '$(vIBGEYear)' AS ANO_REFERENCIA,
            Trim([$(vIBGEFieldUF)]) AS UF,
            Right('00' & KeepChar(Text([$(vIBGEFieldCodUF)]), '0123456789'), 2) AS COD_UF_IBGE_2,
            Right('00000' & KeepChar(Text([$(vIBGEFieldCodMun)]), '0123456789'), 5) AS COD_MUNIC_IBGE_5,
            Right('00' & KeepChar(Text([$(vIBGEFieldCodUF)]), '0123456789'), 2)
                & Right('00000' & KeepChar(Text([$(vIBGEFieldCodMun)]), '0123456789'), 5) AS COD_IBGE_7,
            Trim([$(vIBGEFieldNome)]) AS NOME_MUNICIPIO,
            Num#(
                KeepChar(Text([$(vIBGEFieldPop)]), '0123456789'),
                '###############'
            ) AS POPULACAO_ESTIMADA,
            _META_SOURCE_FILE_RAW AS _META_SOURCE_FILE,
            'IBGE_POPULACAO' AS _META_SOURCE_FAMILY,
            '$(vIBGEYear)' AS _META_SOURCE_YEAR,
            _META_SOURCE_PATH_RAW AS _META_SOURCE_PATH
        RESIDENT IBGE_RAW
        WHERE Trim([$(vIBGEFieldUF)]) = 'PB';

    ELSE

        Concatenate (SRC_IBGE_POPULACAO)
        LOAD
            '$(vIBGEYear)' AS ANO_REFERENCIA,
            Trim([$(vIBGEFieldUF)]) AS UF,
            Right('00' & KeepChar(Text([$(vIBGEFieldCodUF)]), '0123456789'), 2) AS COD_UF_IBGE_2,
            Right('00000' & KeepChar(Text([$(vIBGEFieldCodMun)]), '0123456789'), 5) AS COD_MUNIC_IBGE_5,
            Right('00' & KeepChar(Text([$(vIBGEFieldCodUF)]), '0123456789'), 2)
                & Right('00000' & KeepChar(Text([$(vIBGEFieldCodMun)]), '0123456789'), 5) AS COD_IBGE_7,
            Trim([$(vIBGEFieldNome)]) AS NOME_MUNICIPIO,
            Num#(
                KeepChar(Text([$(vIBGEFieldPop)]), '0123456789'),
                '###############'
            ) AS POPULACAO_ESTIMADA,
            _META_SOURCE_FILE_RAW AS _META_SOURCE_FILE,
            'IBGE_POPULACAO' AS _META_SOURCE_FAMILY,
            '$(vIBGEYear)' AS _META_SOURCE_YEAR,
            _META_SOURCE_PATH_RAW AS _META_SOURCE_PATH
        RESIDENT IBGE_RAW
        WHERE Trim([$(vIBGEFieldUF)]) = 'PB';

    ENDIF

    DROP TABLE IBGE_RAW;

    IF ScriptErrorCount > $(vExtractionErrorsBefore) THEN
        TRACE [EXTRACAO][IBGE][$(vIBGEYear)] staging LOAD failed. Errors=$(ScriptErrorList);
        EXIT SCRIPT;
    ENDIF

    TMP_IBGE_YEAR_CHECK:
    LOAD
        Count(*) AS row_count,
        Count(DISTINCT COD_IBGE_7) AS distinct_municipality_count,
        Sum(POPULACAO_ESTIMADA) AS population_sum
    RESIDENT SRC_IBGE_POPULACAO
    WHERE ANO_REFERENCIA = '$(vIBGEYear)';

    LET vIBGERowsYear = Peek('row_count', 0, 'TMP_IBGE_YEAR_CHECK');
    LET vIBGEDistinctMunicipalitiesYear = Peek('distinct_municipality_count', 0, 'TMP_IBGE_YEAR_CHECK');
    LET vIBGEPopulationYear = Peek('population_sum', 0, 'TMP_IBGE_YEAR_CHECK');

    DROP TABLE TMP_IBGE_YEAR_CHECK;

    IF $(vIBGERowsYear) <> 223 THEN
        TRACE [EXTRACAO][IBGE][$(vIBGEYear)] row count mismatch. Expected=223 Actual=$(vIBGERowsYear);
        EXIT SCRIPT;
    ENDIF

    IF $(vIBGEDistinctMunicipalitiesYear) <> 223 THEN
        TRACE [EXTRACAO][IBGE][$(vIBGEYear)] municipality uniqueness mismatch. Expected=223 Actual=$(vIBGEDistinctMunicipalitiesYear);
        EXIT SCRIPT;
    ENDIF

    IF $(vIBGEPopulationYear) <> $(vIBGEExpectedPopulation) THEN
        TRACE [EXTRACAO][IBGE][$(vIBGEYear)] population total mismatch. Expected=$(vIBGEExpectedPopulation) Actual=$(vIBGEPopulationYear);
        EXIT SCRIPT;
    ENDIF

    TRACE [EXTRACAO][IBGE][$(vIBGEYear)] PASS rows=$(vIBGERowsYear) population=$(vIBGEPopulationYear);

NEXT vIBGEYear

LET vIBGERows = NoOfRows('SRC_IBGE_POPULACAO');

IF $(vIBGERows) <> 669 THEN
    TRACE [EXTRACAO][IBGE] total row count mismatch. Expected=669 Actual=$(vIBGERows);
    EXIT SCRIPT;
ENDIF

TMP_IBGE_FINAL_CHECK:
LOAD
    Count(DISTINCT COD_IBGE_7 & '|' & ANO_REFERENCIA) AS distinct_grain_count,
    Count(DISTINCT ANO_REFERENCIA) AS distinct_year_count
RESIDENT SRC_IBGE_POPULACAO;

LET vIBGEDistinctGrain = Peek('distinct_grain_count', 0, 'TMP_IBGE_FINAL_CHECK');
LET vIBGEDistinctYears = Peek('distinct_year_count', 0, 'TMP_IBGE_FINAL_CHECK');

DROP TABLE TMP_IBGE_FINAL_CHECK;

IF $(vIBGEDistinctGrain) <> 669 THEN
    TRACE [EXTRACAO][IBGE] grain uniqueness mismatch. Expected=669 Actual=$(vIBGEDistinctGrain);
    EXIT SCRIPT;
ENDIF

IF $(vIBGEDistinctYears) <> 3 THEN
    TRACE [EXTRACAO][IBGE] year coverage mismatch. Expected=3 Actual=$(vIBGEDistinctYears);
    EXIT SCRIPT;
ENDIF

STORE SRC_IBGE_POPULACAO INTO [QVD\SRC_IBGE_POPULACAO.qvd] (qvd);

IF ScriptErrorCount > $(vExtractionErrorsBefore) THEN
    TRACE [EXTRACAO][IBGE] QVD STORE failed. Errors=$(ScriptErrorList);
    EXIT SCRIPT;
ENDIF

TRACE [EXTRACAO][IBGE] PASS rows=$(vIBGERows) years=$(vIBGEDistinctYears);

DROP TABLE SRC_IBGE_POPULACAO;

EXTRACAO_IBGE_CHECKPOINT:
LOAD
    Timestamp(Now(1)) AS generated_at,
    'EXTRACAO_IBGE' AS stage,
    'PASS_PARTIAL' AS status,
    $(vIBGERows) AS ibge_rows,
    223 AS municipalities_2017,
    4025558 AS population_2017,
    223 AS municipalities_2018,
    3996496 AS population_2018,
    223 AS municipalities_2019,
    4018127 AS population_2019
AUTOGENERATE 1;

STORE EXTRACAO_IBGE_CHECKPOINT INTO [QVD\_CHECKPOINT_EXTRACAO_IBGE.csv]
(txt, utf8, delimiter is ';', embedded labels);

IF ScriptErrorCount > $(vExtractionErrorsBefore) THEN
    TRACE [EXTRACAO][IBGE] checkpoint STORE failed. Errors=$(ScriptErrorList);
    EXIT SCRIPT;
ENDIF

DROP TABLE EXTRACAO_IBGE_CHECKPOINT;

TRACE [EXTRACAO] PHASE_III_B_IBGE_STAGING_PASS ROWS=$(vIBGERows);
TRACE [EXTRACAO] PARTIAL ONLY — auxiliary references remain pending; no final extraction success marker emitted.
