// FASE III — Extração / staging
// Script versionável carregado por EXTRACAO/EXT.qvw.
//
// A Fase III implementa staging das fontes validadas e das referências
// auxiliares efetivamente materializadas. Checkpoints já implementados:
// saúde (RD/LT/ST), IBGE, referências normativas pequenas (III-C1) e
// integração CID-10 descritiva (III-C2; reload local ainda valida o gate).
// Referências auxiliares restantes continuam pendentes antes do fechamento.
//
// Não construir fatos, dimensões ou LINK_ANALISE neste script.

SET ErrorMode=0;

LET vExtractionErrorsBefore = ScriptErrorCount;

TRACE [EXTRACAO] Phase III-A health staging start;

// -----------------------------------------------------------------------------
// SIH/RD
// -----------------------------------------------------------------------------

LET vRDFiles = 0;

FOR EACH vFile IN FileList('..\BASE\CONVERTIDA\RD\RDPB*.csv')

    LET vRDFiles = $(vRDFiles) + 1;

    IF $(vRDFiles) = 1 THEN

        SRC_SIH_RD:
        LOAD
            Text(ANO_CMPT) AS ANO_CMPT,
            Text(MES_CMPT) AS MES_CMPT,
            Text(N_AIH) AS N_AIH,
            Text(IDENT) AS IDENT,
            Text(MUNIC_RES) AS MUNIC_RES,
            Text(MUNIC_MOV) AS MUNIC_MOV,
            Text(CNES) AS CNES,
            Text(PROC_SOLIC) AS PROC_SOLIC,
            Text(PROC_REA) AS PROC_REA,
            Text(DIAG_PRINC) AS DIAG_PRINC,
            Text(CAR_INT) AS CAR_INT,
            Text(COBRANCA) AS COBRANCA,
            Text(DT_INTER) AS DT_INTER,
            Text(DT_SAIDA) AS DT_SAIDA,
            DIAS_PERM,
            VAL_TOT,
            MORTE,
            FileName() AS _META_SOURCE_FILE,
            'RD' AS _META_SOURCE_FAMILY,
            '20' & Mid(FileBaseName(), 5, 4) AS _META_SOURCE_COMPETENCE,
            FilePath() AS _META_SOURCE_PATH
        FROM [$(vFile)]
        (txt, utf8, embedded labels, delimiter is ';', msq);

    ELSE

        Concatenate (SRC_SIH_RD)
        LOAD
            Text(ANO_CMPT) AS ANO_CMPT,
            Text(MES_CMPT) AS MES_CMPT,
            Text(N_AIH) AS N_AIH,
            Text(IDENT) AS IDENT,
            Text(MUNIC_RES) AS MUNIC_RES,
            Text(MUNIC_MOV) AS MUNIC_MOV,
            Text(CNES) AS CNES,
            Text(PROC_SOLIC) AS PROC_SOLIC,
            Text(PROC_REA) AS PROC_REA,
            Text(DIAG_PRINC) AS DIAG_PRINC,
            Text(CAR_INT) AS CAR_INT,
            Text(COBRANCA) AS COBRANCA,
            Text(DT_INTER) AS DT_INTER,
            Text(DT_SAIDA) AS DT_SAIDA,
            DIAS_PERM,
            VAL_TOT,
            MORTE,
            FileName() AS _META_SOURCE_FILE,
            'RD' AS _META_SOURCE_FAMILY,
            '20' & Mid(FileBaseName(), 5, 4) AS _META_SOURCE_COMPETENCE,
            FilePath() AS _META_SOURCE_PATH
        FROM [$(vFile)]
        (txt, utf8, embedded labels, delimiter is ';', msq);

    ENDIF

NEXT vFile

IF ScriptErrorCount > $(vExtractionErrorsBefore) THEN
    TRACE [EXTRACAO][RD] LOAD failed. Errors=$(ScriptErrorList);
    EXIT SCRIPT;
ENDIF

IF $(vRDFiles) <> 36 THEN
    TRACE [EXTRACAO][RD] file count mismatch. Expected=36 Actual=$(vRDFiles);
    EXIT SCRIPT;
ENDIF

LET vRDRows = NoOfRows('SRC_SIH_RD');

IF $(vRDRows) <> 566672 THEN
    TRACE [EXTRACAO][RD] row count mismatch. Expected=566672 Actual=$(vRDRows);
    EXIT SCRIPT;
ENDIF

TMP_RD_CHECK:
LOAD
    Count(DISTINCT _META_SOURCE_COMPETENCE) AS distinct_competence_count,
    Sum(
        If(
            Right('0000' & Trim(ANO_CMPT), 4)
                & Right('00' & Trim(MES_CMPT), 2)
                <> _META_SOURCE_COMPETENCE,
            1,
            0
        )
    ) AS competence_mismatch
RESIDENT SRC_SIH_RD;

LET vRDDistinctCompetences = Peek('distinct_competence_count', 0, 'TMP_RD_CHECK');
LET vRDCompetenceMismatch = Peek('competence_mismatch', 0, 'TMP_RD_CHECK');

DROP TABLE TMP_RD_CHECK;

IF $(vRDDistinctCompetences) <> 36 THEN
    TRACE [EXTRACAO][RD] competence coverage mismatch. Expected=36 Actual=$(vRDDistinctCompetences);
    EXIT SCRIPT;
ENDIF

IF $(vRDCompetenceMismatch) <> 0 THEN
    TRACE [EXTRACAO][RD] source competence mismatch. Count=$(vRDCompetenceMismatch);
    EXIT SCRIPT;
ENDIF

STORE SRC_SIH_RD INTO [QVD\SRC_SIH_RD.qvd] (qvd);

IF ScriptErrorCount > $(vExtractionErrorsBefore) THEN
    TRACE [EXTRACAO][RD] QVD STORE failed. Errors=$(ScriptErrorList);
    EXIT SCRIPT;
ENDIF

TRACE [EXTRACAO][RD] PASS files=$(vRDFiles) rows=$(vRDRows) competences=$(vRDDistinctCompetences);

DROP TABLE SRC_SIH_RD;

// -----------------------------------------------------------------------------
// CNES/LT
// -----------------------------------------------------------------------------

LET vLTFiles = 0;

FOR EACH vFile IN FileList('..\BASE\CONVERTIDA\LT\LTPB*.csv')

    LET vLTFiles = $(vLTFiles) + 1;

    IF $(vLTFiles) = 1 THEN

        SRC_CNES_LT:
        LOAD
            Text(CNES) AS CNES,
            Text(CODUFMUN) AS CODUFMUN,
            Text(TP_LEITO) AS TP_LEITO,
            Text(CODLEITO) AS CODLEITO,
            QT_EXIST,
            QT_SUS,
            QT_NSUS,
            Text(COMPETEN) AS COMPETEN,
            FileName() AS _META_SOURCE_FILE,
            'LT' AS _META_SOURCE_FAMILY,
            '20' & Mid(FileBaseName(), 5, 4) AS _META_SOURCE_COMPETENCE,
            FilePath() AS _META_SOURCE_PATH
        FROM [$(vFile)]
        (txt, utf8, embedded labels, delimiter is ';', msq);

    ELSE

        Concatenate (SRC_CNES_LT)
        LOAD
            Text(CNES) AS CNES,
            Text(CODUFMUN) AS CODUFMUN,
            Text(TP_LEITO) AS TP_LEITO,
            Text(CODLEITO) AS CODLEITO,
            QT_EXIST,
            QT_SUS,
            QT_NSUS,
            Text(COMPETEN) AS COMPETEN,
            FileName() AS _META_SOURCE_FILE,
            'LT' AS _META_SOURCE_FAMILY,
            '20' & Mid(FileBaseName(), 5, 4) AS _META_SOURCE_COMPETENCE,
            FilePath() AS _META_SOURCE_PATH
        FROM [$(vFile)]
        (txt, utf8, embedded labels, delimiter is ';', msq);

    ENDIF

NEXT vFile

IF ScriptErrorCount > $(vExtractionErrorsBefore) THEN
    TRACE [EXTRACAO][LT] LOAD failed. Errors=$(ScriptErrorList);
    EXIT SCRIPT;
ENDIF

IF $(vLTFiles) <> 36 THEN
    TRACE [EXTRACAO][LT] file count mismatch. Expected=36 Actual=$(vLTFiles);
    EXIT SCRIPT;
ENDIF

LET vLTRows = NoOfRows('SRC_CNES_LT');

IF $(vLTRows) <> 35518 THEN
    TRACE [EXTRACAO][LT] row count mismatch. Expected=35518 Actual=$(vLTRows);
    EXIT SCRIPT;
ENDIF

TMP_LT_CHECK:
LOAD
    Count(DISTINCT _META_SOURCE_COMPETENCE) AS distinct_competence_count,
    Sum(
        If(
            Right('000000' & Trim(COMPETEN), 6)
                <> _META_SOURCE_COMPETENCE,
            1,
            0
        )
    ) AS competence_mismatch
RESIDENT SRC_CNES_LT;

LET vLTDistinctCompetences = Peek('distinct_competence_count', 0, 'TMP_LT_CHECK');
LET vLTCompetenceMismatch = Peek('competence_mismatch', 0, 'TMP_LT_CHECK');

DROP TABLE TMP_LT_CHECK;

IF $(vLTDistinctCompetences) <> 36 THEN
    TRACE [EXTRACAO][LT] competence coverage mismatch. Expected=36 Actual=$(vLTDistinctCompetences);
    EXIT SCRIPT;
ENDIF

IF $(vLTCompetenceMismatch) <> 0 THEN
    TRACE [EXTRACAO][LT] source competence mismatch. Count=$(vLTCompetenceMismatch);
    EXIT SCRIPT;
ENDIF

STORE SRC_CNES_LT INTO [QVD\SRC_CNES_LT.qvd] (qvd);

IF ScriptErrorCount > $(vExtractionErrorsBefore) THEN
    TRACE [EXTRACAO][LT] QVD STORE failed. Errors=$(ScriptErrorList);
    EXIT SCRIPT;
ENDIF

TRACE [EXTRACAO][LT] PASS files=$(vLTFiles) rows=$(vLTRows) competences=$(vLTDistinctCompetences);

DROP TABLE SRC_CNES_LT;

// -----------------------------------------------------------------------------
// CNES/ST
// -----------------------------------------------------------------------------

LET vSTFiles = 0;

FOR EACH vFile IN FileList('..\BASE\CONVERTIDA\ST\STPB*.csv')

    LET vSTFiles = $(vSTFiles) + 1;

    IF $(vSTFiles) = 1 THEN

        SRC_CNES_ST:
        LOAD
            Text(CNES) AS CNES,
            Text(CODUFMUN) AS CODUFMUN,
            Text(COD_CEP) AS COD_CEP,
            Text(CNPJ_MAN) AS CNPJ_MAN,
            Text(VINC_SUS) AS VINC_SUS,
            Text(TPGESTAO) AS TPGESTAO,
            Text(TP_UNID) AS TP_UNID,
            Text(NATUREZA) AS NATUREZA,
            Text(NAT_JUR) AS NAT_JUR,
            Text(COMPETEN) AS COMPETEN,
            FileName() AS _META_SOURCE_FILE,
            'ST' AS _META_SOURCE_FAMILY,
            '20' & Mid(FileBaseName(), 5, 4) AS _META_SOURCE_COMPETENCE,
            FilePath() AS _META_SOURCE_PATH
        FROM [$(vFile)]
        (txt, utf8, embedded labels, delimiter is ';', msq);

    ELSE

        Concatenate (SRC_CNES_ST)
        LOAD
            Text(CNES) AS CNES,
            Text(CODUFMUN) AS CODUFMUN,
            Text(COD_CEP) AS COD_CEP,
            Text(CNPJ_MAN) AS CNPJ_MAN,
            Text(VINC_SUS) AS VINC_SUS,
            Text(TPGESTAO) AS TPGESTAO,
            Text(TP_UNID) AS TP_UNID,
            Text(NATUREZA) AS NATUREZA,
            Text(NAT_JUR) AS NAT_JUR,
            Text(COMPETEN) AS COMPETEN,
            FileName() AS _META_SOURCE_FILE,
            'ST' AS _META_SOURCE_FAMILY,
            '20' & Mid(FileBaseName(), 5, 4) AS _META_SOURCE_COMPETENCE,
            FilePath() AS _META_SOURCE_PATH
        FROM [$(vFile)]
        (txt, utf8, embedded labels, delimiter is ';', msq);

    ENDIF

NEXT vFile

IF ScriptErrorCount > $(vExtractionErrorsBefore) THEN
    TRACE [EXTRACAO][ST] LOAD failed. Errors=$(ScriptErrorList);
    EXIT SCRIPT;
ENDIF

IF $(vSTFiles) <> 36 THEN
    TRACE [EXTRACAO][ST] file count mismatch. Expected=36 Actual=$(vSTFiles);
    EXIT SCRIPT;
ENDIF

LET vSTRows = NoOfRows('SRC_CNES_ST');

IF $(vSTRows) <> 220390 THEN
    TRACE [EXTRACAO][ST] row count mismatch. Expected=220390 Actual=$(vSTRows);
    EXIT SCRIPT;
ENDIF

TMP_ST_CHECK:
LOAD
    Count(DISTINCT _META_SOURCE_COMPETENCE) AS distinct_competence_count,
    Sum(
        If(
            Right('000000' & Trim(COMPETEN), 6)
                <> _META_SOURCE_COMPETENCE,
            1,
            0
        )
    ) AS competence_mismatch
RESIDENT SRC_CNES_ST;

LET vSTDistinctCompetences = Peek('distinct_competence_count', 0, 'TMP_ST_CHECK');
LET vSTCompetenceMismatch = Peek('competence_mismatch', 0, 'TMP_ST_CHECK');

DROP TABLE TMP_ST_CHECK;

IF $(vSTDistinctCompetences) <> 36 THEN
    TRACE [EXTRACAO][ST] competence coverage mismatch. Expected=36 Actual=$(vSTDistinctCompetences);
    EXIT SCRIPT;
ENDIF

IF $(vSTCompetenceMismatch) <> 0 THEN
    TRACE [EXTRACAO][ST] source competence mismatch. Count=$(vSTCompetenceMismatch);
    EXIT SCRIPT;
ENDIF

STORE SRC_CNES_ST INTO [QVD\SRC_CNES_ST.qvd] (qvd);

IF ScriptErrorCount > $(vExtractionErrorsBefore) THEN
    TRACE [EXTRACAO][ST] QVD STORE failed. Errors=$(ScriptErrorList);
    EXIT SCRIPT;
ENDIF

TRACE [EXTRACAO][ST] PASS files=$(vSTFiles) rows=$(vSTRows) competences=$(vSTDistinctCompetences);

DROP TABLE SRC_CNES_ST;

// -----------------------------------------------------------------------------
// Partial checkpoint only.
// Full extraction success remains blocked until IBGE and auxiliary references
// are implemented and reconciled.
// -----------------------------------------------------------------------------

EXTRACAO_SAUDE_CHECKPOINT:
LOAD
    Timestamp(Now(1)) AS generated_at,
    'EXTRACAO_SAUDE' AS stage,
    'PASS_PARTIAL' AS status,
    $(vRDFiles) AS rd_files,
    $(vRDRows) AS rd_rows,
    $(vLTFiles) AS lt_files,
    $(vLTRows) AS lt_rows,
    $(vSTFiles) AS st_files,
    $(vSTRows) AS st_rows
AUTOGENERATE 1;

STORE EXTRACAO_SAUDE_CHECKPOINT INTO [QVD\_CHECKPOINT_EXTRACAO_SAUDE.csv]
(txt, utf8, delimiter is ';', embedded labels);

IF ScriptErrorCount > $(vExtractionErrorsBefore) THEN
    TRACE [EXTRACAO] health checkpoint STORE failed. Errors=$(ScriptErrorList);
    EXIT SCRIPT;
ENDIF

DROP TABLE EXTRACAO_SAUDE_CHECKPOINT;

TRACE [EXTRACAO] PHASE_III_A_HEALTH_STAGING_PASS RD=$(vRDRows) LT=$(vLTRows) ST=$(vSTRows);

// -----------------------------------------------------------------------------
// IBGE — estimativas populacionais municipais 2017–2019
// -----------------------------------------------------------------------------

TRACE [EXTRACAO] Phase III-B IBGE staging start;

// Evita dependência da codificação do include .qvs para identificadores
// acentuados exigidos pelo BIFF e pela validação de schema.
LET vIBGESheet = 'Munic' & Chr(237) & 'pios$';
LET vIBGEExpectedFieldNome = 'NOME DO MUNIC' & Chr(205) & 'PIO';
LET vIBGEExpectedFieldPop = 'POPULA' & Chr(199) & Chr(195) & 'O ESTIMADA';

// Notas numéricas anexadas à população (ex.: 7386(4), 15276(5))
// devem ser removidas antes da normalização numérica. O valor populacional é
// somente o trecho anterior ao primeiro parêntese.
//
// A inspeção física confirmou:
// - planilha: Municípios
// - linha 1: título
// - linha 2: cabeçalho
// - colunas úteis: UF, COD. UF, COD. MUNIC, NOME DO MUNICÍPIO, POPULAÇÃO ESTIMADA
//
// O header é lido dinamicamente por posição somente para descobrir os nomes
// efetivos dos cinco primeiros campos. Em seguida, esses nomes são validados
// antes da carga de staging.

FOR EACH vIBGEYear IN '2017', '2018', '2019'

    IF '$(vIBGEYear)' = '2017' THEN
        LET vIBGEFile = '..\BASE\IBGE\estimativa_dou_2017.xls';
        LET vIBGEExpectedPopulation = 4025558;
    ELSEIF '$(vIBGEYear)' = '2018' THEN
        LET vIBGEFile = '..\BASE\IBGE\estimativa_dou_2018_20181019.xls';
        LET vIBGEExpectedPopulation = 3996496;
    ELSE
        LET vIBGEFile = '..\BASE\IBGE\estimativa_dou_2019.xls';
        LET vIBGEExpectedPopulation = 4018127;
    ENDIF

    IBGE_RAW:
    LOAD
        *,
        FileName() AS _META_SOURCE_FILE_RAW,
        FilePath() AS _META_SOURCE_PATH_RAW
    FROM [$(vIBGEFile)]
    (biff, embedded labels, table is [$(vIBGESheet)], header is 1 lines);

    IF ScriptErrorCount > $(vExtractionErrorsBefore) THEN
        TRACE [EXTRACAO][IBGE][$(vIBGEYear)] XLS LOAD failed. Errors=$(ScriptErrorList);
        EXIT SCRIPT;
    ENDIF

    LET vIBGEFieldUF = FieldName(1, 'IBGE_RAW');
    LET vIBGEFieldCodUF = FieldName(2, 'IBGE_RAW');
    LET vIBGEFieldCodMun = FieldName(3, 'IBGE_RAW');
    LET vIBGEFieldNome = FieldName(4, 'IBGE_RAW');
    LET vIBGEFieldPop = FieldName(5, 'IBGE_RAW');

    IF Trim('$(vIBGEFieldUF)') <> 'UF' THEN
        TRACE [EXTRACAO][IBGE][$(vIBGEYear)] unexpected field 1. Actual=$(vIBGEFieldUF);
        EXIT SCRIPT;
    ENDIF

    IF Trim('$(vIBGEFieldCodUF)') <> 'COD. UF' THEN
        TRACE [EXTRACAO][IBGE][$(vIBGEYear)] unexpected field 2. Actual=$(vIBGEFieldCodUF);
        EXIT SCRIPT;
    ENDIF

    IF Trim('$(vIBGEFieldCodMun)') <> 'COD. MUNIC' THEN
        TRACE [EXTRACAO][IBGE][$(vIBGEYear)] unexpected field 3. Actual=$(vIBGEFieldCodMun);
        EXIT SCRIPT;
    ENDIF

    IF Trim('$(vIBGEFieldNome)') <> '$(vIBGEExpectedFieldNome)' THEN
        TRACE [EXTRACAO][IBGE][$(vIBGEYear)] unexpected field 4. Actual=$(vIBGEFieldNome);
        EXIT SCRIPT;
    ENDIF

    IF Trim('$(vIBGEFieldPop)') <> '$(vIBGEExpectedFieldPop)' THEN
        TRACE [EXTRACAO][IBGE][$(vIBGEYear)] unexpected field 5. Actual=$(vIBGEFieldPop);
        EXIT SCRIPT;
    ENDIF

    IF '$(vIBGEYear)' = '2017' THEN

        SRC_IBGE_POPULACAO:
        LOAD
            '$(vIBGEYear)' AS ANO_REFERENCIA,
            Trim([$(vIBGEFieldUF)]) AS UF,
            Right('00' & KeepChar(Text([$(vIBGEFieldCodUF)]), '0123456789'), 2) AS COD_UF_IBGE_2,
            Right('00000' & KeepChar(Text([$(vIBGEFieldCodMun)]), '0123456789'), 5) AS COD_MUNIC_IBGE_5,
            Right('00' & KeepChar(Text([$(vIBGEFieldCodUF)]), '0123456789'), 2)
                & Right('00000' & KeepChar(Text([$(vIBGEFieldCodMun)]), '0123456789'), 5) AS COD_IBGE_7,
            Trim([$(vIBGEFieldNome)]) AS NOME_MUNICIPIO,
            Num#(
                KeepChar(
                    SubField(Text([$(vIBGEFieldPop)]), '(', 1),
                    '0123456789'
                ),
                '###############'
            ) AS POPULACAO_ESTIMADA,
            _META_SOURCE_FILE_RAW AS _META_SOURCE_FILE,
            'IBGE_POPULACAO' AS _META_SOURCE_FAMILY,
            '$(vIBGEYear)' AS _META_SOURCE_YEAR,
            _META_SOURCE_PATH_RAW AS _META_SOURCE_PATH
        RESIDENT IBGE_RAW
        WHERE Trim([$(vIBGEFieldUF)]) = 'PB';

    ELSE

        Concatenate (SRC_IBGE_POPULACAO)
        LOAD
            '$(vIBGEYear)' AS ANO_REFERENCIA,
            Trim([$(vIBGEFieldUF)]) AS UF,
            Right('00' & KeepChar(Text([$(vIBGEFieldCodUF)]), '0123456789'), 2) AS COD_UF_IBGE_2,
            Right('00000' & KeepChar(Text([$(vIBGEFieldCodMun)]), '0123456789'), 5) AS COD_MUNIC_IBGE_5,
            Right('00' & KeepChar(Text([$(vIBGEFieldCodUF)]), '0123456789'), 2)
                & Right('00000' & KeepChar(Text([$(vIBGEFieldCodMun)]), '0123456789'), 5) AS COD_IBGE_7,
            Trim([$(vIBGEFieldNome)]) AS NOME_MUNICIPIO,
            Num#(
                KeepChar(
                    SubField(Text([$(vIBGEFieldPop)]), '(', 1),
                    '0123456789'
                ),
                '###############'
            ) AS POPULACAO_ESTIMADA,
            _META_SOURCE_FILE_RAW AS _META_SOURCE_FILE,
            'IBGE_POPULACAO' AS _META_SOURCE_FAMILY,
            '$(vIBGEYear)' AS _META_SOURCE_YEAR,
            _META_SOURCE_PATH_RAW AS _META_SOURCE_PATH
        RESIDENT IBGE_RAW
        WHERE Trim([$(vIBGEFieldUF)]) = 'PB';

    ENDIF

    DROP TABLE IBGE_RAW;

    IF ScriptErrorCount > $(vExtractionErrorsBefore) THEN
        TRACE [EXTRACAO][IBGE][$(vIBGEYear)] staging LOAD failed. Errors=$(ScriptErrorList);
        EXIT SCRIPT;
    ENDIF

    TMP_IBGE_YEAR_CHECK:
    LOAD
        Count(*) AS row_count,
        Count(DISTINCT COD_IBGE_7) AS distinct_municipality_count,
        Sum(POPULACAO_ESTIMADA) AS population_sum
    RESIDENT SRC_IBGE_POPULACAO
    WHERE ANO_REFERENCIA = '$(vIBGEYear)';

    LET vIBGERowsYear = Peek('row_count', 0, 'TMP_IBGE_YEAR_CHECK');
    LET vIBGEDistinctMunicipalitiesYear = Peek('distinct_municipality_count', 0, 'TMP_IBGE_YEAR_CHECK');
    LET vIBGEPopulationYear = Peek('population_sum', 0, 'TMP_IBGE_YEAR_CHECK');

    DROP TABLE TMP_IBGE_YEAR_CHECK;

    IF $(vIBGERowsYear) <> 223 THEN
        TRACE [EXTRACAO][IBGE][$(vIBGEYear)] row count mismatch. Expected=223 Actual=$(vIBGERowsYear);
        EXIT SCRIPT;
    ENDIF

    IF $(vIBGEDistinctMunicipalitiesYear) <> 223 THEN
        TRACE [EXTRACAO][IBGE][$(vIBGEYear)] municipality uniqueness mismatch. Expected=223 Actual=$(vIBGEDistinctMunicipalitiesYear);
        EXIT SCRIPT;
    ENDIF

    IF $(vIBGEPopulationYear) <> $(vIBGEExpectedPopulation) THEN
        TRACE [EXTRACAO][IBGE][$(vIBGEYear)] population total mismatch. Expected=$(vIBGEExpectedPopulation) Actual=$(vIBGEPopulationYear);
        EXIT SCRIPT;
    ENDIF

    TRACE [EXTRACAO][IBGE][$(vIBGEYear)] PASS rows=$(vIBGERowsYear) population=$(vIBGEPopulationYear);

NEXT vIBGEYear

LET vIBGERows = NoOfRows('SRC_IBGE_POPULACAO');

IF $(vIBGERows) <> 669 THEN
    TRACE [EXTRACAO][IBGE] total row count mismatch. Expected=669 Actual=$(vIBGERows);
    EXIT SCRIPT;
ENDIF

TMP_IBGE_FINAL_CHECK:
LOAD
    Count(DISTINCT COD_IBGE_7 & '|' & ANO_REFERENCIA) AS distinct_grain_count,
    Count(DISTINCT ANO_REFERENCIA) AS distinct_year_count
RESIDENT SRC_IBGE_POPULACAO;

LET vIBGEDistinctGrain = Peek('distinct_grain_count', 0, 'TMP_IBGE_FINAL_CHECK');
LET vIBGEDistinctYears = Peek('distinct_year_count', 0, 'TMP_IBGE_FINAL_CHECK');

DROP TABLE TMP_IBGE_FINAL_CHECK;

IF $(vIBGEDistinctGrain) <> 669 THEN
    TRACE [EXTRACAO][IBGE] grain uniqueness mismatch. Expected=669 Actual=$(vIBGEDistinctGrain);
    EXIT SCRIPT;
ENDIF

IF $(vIBGEDistinctYears) <> 3 THEN
    TRACE [EXTRACAO][IBGE] year coverage mismatch. Expected=3 Actual=$(vIBGEDistinctYears);
    EXIT SCRIPT;
ENDIF

STORE SRC_IBGE_POPULACAO INTO [QVD\SRC_IBGE_POPULACAO.qvd] (qvd);

IF ScriptErrorCount > $(vExtractionErrorsBefore) THEN
    TRACE [EXTRACAO][IBGE] QVD STORE failed. Errors=$(ScriptErrorList);
    EXIT SCRIPT;
ENDIF

TRACE [EXTRACAO][IBGE] PASS rows=$(vIBGERows) years=$(vIBGEDistinctYears);

DROP TABLE SRC_IBGE_POPULACAO;

EXTRACAO_IBGE_CHECKPOINT:
LOAD
    Timestamp(Now(1)) AS generated_at,
    'EXTRACAO_IBGE' AS stage,
    'PASS_PARTIAL' AS status,
    $(vIBGERows) AS ibge_rows,
    223 AS municipalities_2017,
    4025558 AS population_2017,
    223 AS municipalities_2018,
    3996496 AS population_2018,
    223 AS municipalities_2019,
    4018127 AS population_2019
AUTOGENERATE 1;

STORE EXTRACAO_IBGE_CHECKPOINT INTO [QVD\_CHECKPOINT_EXTRACAO_IBGE.csv]
(txt, utf8, delimiter is ';', embedded labels);

IF ScriptErrorCount > $(vExtractionErrorsBefore) THEN
    TRACE [EXTRACAO][IBGE] checkpoint STORE failed. Errors=$(ScriptErrorList);
    EXIT SCRIPT;
ENDIF

DROP TABLE EXTRACAO_IBGE_CHECKPOINT;

TRACE [EXTRACAO] PHASE_III_B_IBGE_STAGING_PASS ROWS=$(vIBGERows);

// -----------------------------------------------------------------------------
// Referências normativas pequenas — Caráter + Motivo de Saída/Permanência
// -----------------------------------------------------------------------------

TRACE [EXTRACAO] Phase III-C1 normative reference staging start;

// Caráter de Atendimento -------------------------------------------------------

REF_CARATER_ATENDIMENTO:
LOAD
    Right('00' & KeepChar(Text(codigo_fonte), '0123456789'), 2) AS CAR_INT,
    Text(descricao) AS CARATER_DESCRICAO,
    Text(fonte_oficial) AS CARATER_FONTE_OFICIAL,
    FileName() AS _META_SOURCE_FILE,
    'REF_CARATER_ATENDIMENTO' AS _META_SOURCE_FAMILY,
    FilePath() AS _META_SOURCE_PATH
FROM [..\BASE\REFERENCIAS\carater_atendimento.csv]
(txt, utf8, embedded labels, delimiter is ';', msq);

IF ScriptErrorCount > $(vExtractionErrorsBefore) THEN
    TRACE [EXTRACAO][REF_CARATER] CSV LOAD failed. Errors=$(ScriptErrorList);
    EXIT SCRIPT;
ENDIF

LET vCaraterRows = NoOfRows('REF_CARATER_ATENDIMENTO');

TMP_CARATER_CHECK:
LOAD
    Count(DISTINCT CAR_INT) AS distinct_code_count,
    Sum(
        If(
            Match(CAR_INT, '01', '02', '03', '04', '05', '06') = 0,
            1,
            0
        )
    ) AS invalid_code_count
RESIDENT REF_CARATER_ATENDIMENTO;

LET vCaraterDistinctCodes = Peek('distinct_code_count', 0, 'TMP_CARATER_CHECK');
LET vCaraterInvalidCodes = Peek('invalid_code_count', 0, 'TMP_CARATER_CHECK');

DROP TABLE TMP_CARATER_CHECK;

IF $(vCaraterRows) <> 6 THEN
    TRACE [EXTRACAO][REF_CARATER] row count mismatch. Expected=6 Actual=$(vCaraterRows);
    EXIT SCRIPT;
ENDIF

IF $(vCaraterDistinctCodes) <> 6 THEN
    TRACE [EXTRACAO][REF_CARATER] distinct code mismatch. Expected=6 Actual=$(vCaraterDistinctCodes);
    EXIT SCRIPT;
ENDIF

IF $(vCaraterInvalidCodes) <> 0 THEN
    TRACE [EXTRACAO][REF_CARATER] invalid official code count=$(vCaraterInvalidCodes);
    EXIT SCRIPT;
ENDIF

MAP_CARATER_ATENDIMENTO:
MAPPING LOAD
    CAR_INT,
    1
RESIDENT REF_CARATER_ATENDIMENTO;

TMP_CARATER_RD_COVERAGE:
LOAD
    Count(*) AS rd_rows,
    Sum(
        If(
            ApplyMap(
                'MAP_CARATER_ATENDIMENTO',
                Right('00' & KeepChar(Text(CAR_INT), '0123456789'), 2),
                0
            ) = 0,
            1,
            0
        )
    ) AS unmatched_rows
FROM [QVD\SRC_SIH_RD.qvd] (qvd);

LET vCaraterRDRows = Peek('rd_rows', 0, 'TMP_CARATER_RD_COVERAGE');
LET vCaraterUnmatchedRows = Peek('unmatched_rows', 0, 'TMP_CARATER_RD_COVERAGE');

DROP TABLE TMP_CARATER_RD_COVERAGE;

IF $(vCaraterRDRows) <> 566672 THEN
    TRACE [EXTRACAO][REF_CARATER] RD reconciliation mismatch. Expected=566672 Actual=$(vCaraterRDRows);
    EXIT SCRIPT;
ENDIF

IF $(vCaraterUnmatchedRows) <> 0 THEN
    TRACE [EXTRACAO][REF_CARATER] unmatched RD rows=$(vCaraterUnmatchedRows);
    EXIT SCRIPT;
ENDIF

STORE REF_CARATER_ATENDIMENTO INTO [QVD\REF_CARATER_ATENDIMENTO.qvd] (qvd);

IF ScriptErrorCount > $(vExtractionErrorsBefore) THEN
    TRACE [EXTRACAO][REF_CARATER] QVD STORE failed. Errors=$(ScriptErrorList);
    EXIT SCRIPT;
ENDIF

TRACE [EXTRACAO][REF_CARATER] PASS rows=$(vCaraterRows) unmatched_rd=$(vCaraterUnmatchedRows);

DROP TABLE REF_CARATER_ATENDIMENTO;

// Motivo de Saída/Permanência -------------------------------------------------

REF_MOTIVO_SAIDA:
LOAD
    Right('00' & KeepChar(Text(codigo_fonte), '0123456789'), 2) AS COBRANCA,
    Text(codigo_normativo) AS MOTIVO_CODIGO_NORMATIVO,
    Text(descricao) AS MOTIVO_DESCRICAO,
    Text(grupo) AS MOTIVO_GRUPO,
    Text(fonte_oficial_base) AS MOTIVO_FONTE_OFICIAL_BASE,
    Text(fonte_oficial_atualizacao) AS MOTIVO_FONTE_OFICIAL_ATUALIZACAO,
    FileName() AS _META_SOURCE_FILE,
    'REF_MOTIVO_SAIDA' AS _META_SOURCE_FAMILY,
    FilePath() AS _META_SOURCE_PATH
FROM [..\BASE\REFERENCIAS\motivo_saida_permanencia.csv]
(txt, utf8, embedded labels, delimiter is ';', msq);

IF ScriptErrorCount > $(vExtractionErrorsBefore) THEN
    TRACE [EXTRACAO][REF_MOTIVO] CSV LOAD failed. Errors=$(ScriptErrorList);
    EXIT SCRIPT;
ENDIF

LET vMotivoRows = NoOfRows('REF_MOTIVO_SAIDA');

TMP_MOTIVO_CHECK:
LOAD
    Count(DISTINCT COBRANCA) AS distinct_code_count,
    Sum(
        If(
            Match(
                COBRANCA,
                '11', '12', '14', '15', '16', '18', '19',
                '21', '22', '23', '24', '25', '26', '27', '28',
                '31', '32', '41', '42', '43', '51',
                '61', '62', '63', '64', '65', '66', '67'
            ) = 0,
            1,
            0
        )
    ) AS invalid_code_count,
    Sum(
        If(
            COBRANCA = '24'
                AND MOTIVO_CODIGO_NORMATIVO = '2.4',
            1,
            0
        )
    ) AS code_24_mapping_count,
    Sum(If(Match(COBRANCA, '13', '17') > 0, 1, 0)) AS deprecated_code_count
RESIDENT REF_MOTIVO_SAIDA;

LET vMotivoDistinctCodes = Peek('distinct_code_count', 0, 'TMP_MOTIVO_CHECK');
LET vMotivoInvalidCodes = Peek('invalid_code_count', 0, 'TMP_MOTIVO_CHECK');
LET vMotivoCode24Mapping = Peek('code_24_mapping_count', 0, 'TMP_MOTIVO_CHECK');
LET vMotivoDeprecatedCodes = Peek('deprecated_code_count', 0, 'TMP_MOTIVO_CHECK');

DROP TABLE TMP_MOTIVO_CHECK;

IF $(vMotivoRows) <> 28 THEN
    TRACE [EXTRACAO][REF_MOTIVO] row count mismatch. Expected=28 Actual=$(vMotivoRows);
    EXIT SCRIPT;
ENDIF

IF $(vMotivoDistinctCodes) <> 28 THEN
    TRACE [EXTRACAO][REF_MOTIVO] distinct code mismatch. Expected=28 Actual=$(vMotivoDistinctCodes);
    EXIT SCRIPT;
ENDIF

IF $(vMotivoInvalidCodes) <> 0 THEN
    TRACE [EXTRACAO][REF_MOTIVO] invalid official code count=$(vMotivoInvalidCodes);
    EXIT SCRIPT;
ENDIF

IF $(vMotivoDeprecatedCodes) <> 0 THEN
    TRACE [EXTRACAO][REF_MOTIVO] deprecated codes 13/17 must not be materialized. Count=$(vMotivoDeprecatedCodes);
    EXIT SCRIPT;
ENDIF

IF $(vMotivoCode24Mapping) <> 1 THEN
    TRACE [EXTRACAO][REF_MOTIVO] COBRANCA=24 mapping mismatch. Expected=1 Actual=$(vMotivoCode24Mapping);
    EXIT SCRIPT;
ENDIF

MAP_MOTIVO_SAIDA:
MAPPING LOAD
    COBRANCA,
    1
RESIDENT REF_MOTIVO_SAIDA;

TMP_MOTIVO_RD_COVERAGE:
LOAD
    Count(*) AS rd_rows,
    Sum(
        If(
            ApplyMap(
                'MAP_MOTIVO_SAIDA',
                Right('00' & KeepChar(Text(COBRANCA), '0123456789'), 2),
                0
            ) = 0,
            1,
            0
        )
    ) AS unmatched_rows
FROM [QVD\SRC_SIH_RD.qvd] (qvd);

LET vMotivoRDRows = Peek('rd_rows', 0, 'TMP_MOTIVO_RD_COVERAGE');
LET vMotivoUnmatchedRows = Peek('unmatched_rows', 0, 'TMP_MOTIVO_RD_COVERAGE');

DROP TABLE TMP_MOTIVO_RD_COVERAGE;

IF $(vMotivoRDRows) <> 566672 THEN
    TRACE [EXTRACAO][REF_MOTIVO] RD reconciliation mismatch. Expected=566672 Actual=$(vMotivoRDRows);
    EXIT SCRIPT;
ENDIF

IF $(vMotivoUnmatchedRows) <> 0 THEN
    TRACE [EXTRACAO][REF_MOTIVO] unmatched RD rows=$(vMotivoUnmatchedRows);
    EXIT SCRIPT;
ENDIF

STORE REF_MOTIVO_SAIDA INTO [QVD\REF_MOTIVO_SAIDA.qvd] (qvd);

IF ScriptErrorCount > $(vExtractionErrorsBefore) THEN
    TRACE [EXTRACAO][REF_MOTIVO] QVD STORE failed. Errors=$(ScriptErrorList);
    EXIT SCRIPT;
ENDIF

TRACE [EXTRACAO][REF_MOTIVO] PASS rows=$(vMotivoRows) unmatched_rd=$(vMotivoUnmatchedRows);

DROP TABLE REF_MOTIVO_SAIDA;

// Checkpoint parcial III-C1 ----------------------------------------------------

EXTRACAO_REFERENCIAS_NORMATIVAS_CHECKPOINT:
LOAD
    Timestamp(Now(1)) AS generated_at,
    'EXTRACAO_REFERENCIAS_NORMATIVAS' AS stage,
    'PASS_PARTIAL' AS status,
    $(vCaraterRows) AS carater_rows,
    $(vCaraterUnmatchedRows) AS carater_unmatched_rd_rows,
    $(vMotivoRows) AS motivo_rows,
    $(vMotivoUnmatchedRows) AS motivo_unmatched_rd_rows
AUTOGENERATE 1;

STORE EXTRACAO_REFERENCIAS_NORMATIVAS_CHECKPOINT
INTO [QVD\_CHECKPOINT_EXTRACAO_REFERENCIAS_NORMATIVAS.csv]
(txt, utf8, delimiter is ';', embedded labels);

IF ScriptErrorCount > $(vExtractionErrorsBefore) THEN
    TRACE [EXTRACAO][REF_NORMATIVAS] checkpoint STORE failed. Errors=$(ScriptErrorList);
    EXIT SCRIPT;
ENDIF

DROP TABLE EXTRACAO_REFERENCIAS_NORMATIVAS_CHECKPOINT;

TRACE [EXTRACAO] PHASE_III_C1_NORMATIVE_REFERENCES_PASS CARATER=$(vCaraterRows) MOTIVO=$(vMotivoRows);

// -----------------------------------------------------------------------------
// CID-10 — referência descritiva estática/superset (competência 201912)
// -----------------------------------------------------------------------------

TRACE [EXTRACAO] Phase III-C2 CID-10 staging start;

REF_CID10:
LOAD
    Text(codigo_cid10) AS CID10_CODIGO,
    Text(descricao) AS CID10_DESCRICAO,
    Text(competencia_referencia) AS CID10_COMPETENCIA_REFERENCIA,
    Text(fonte_arquivo) AS CID10_FONTE_ARQUIVO,
    FileName() AS _META_SOURCE_FILE,
    'REF_CID10' AS _META_SOURCE_FAMILY,
    FilePath() AS _META_SOURCE_PATH
FROM [..\BASE\REFERENCIAS\cid10_referencia.csv]
(txt, utf8, embedded labels, delimiter is ';', msq);

IF ScriptErrorCount > $(vExtractionErrorsBefore) THEN
    TRACE [EXTRACAO][REF_CID10] CSV LOAD failed. Errors=$(ScriptErrorList);
    EXIT SCRIPT;
ENDIF

LET vCID10Rows = NoOfRows('REF_CID10');

TMP_CID10_CHECK:
LOAD
    Count(DISTINCT CID10_CODIGO) AS distinct_code_count,
    Sum(If(Len(CID10_CODIGO) = 3, 1, 0)) AS length_3_count,
    Sum(If(Len(CID10_CODIGO) = 4, 1, 0)) AS length_4_count,
    Sum(If(CID10_COMPETENCIA_REFERENCIA <> '201912', 1, 0)) AS invalid_competence_count,
    Sum(If(Len(Trim(CID10_DESCRICAO)) = 0, 1, 0)) AS empty_description_count
RESIDENT REF_CID10;

LET vCID10DistinctCodes = Peek('distinct_code_count', 0, 'TMP_CID10_CHECK');
LET vCID10Length3 = Peek('length_3_count', 0, 'TMP_CID10_CHECK');
LET vCID10Length4 = Peek('length_4_count', 0, 'TMP_CID10_CHECK');
LET vCID10InvalidCompetence = Peek('invalid_competence_count', 0, 'TMP_CID10_CHECK');
LET vCID10EmptyDescriptions = Peek('empty_description_count', 0, 'TMP_CID10_CHECK');

DROP TABLE TMP_CID10_CHECK;

IF $(vCID10Rows) <> 14230 THEN
    TRACE [EXTRACAO][REF_CID10] row count mismatch. Expected=14230 Actual=$(vCID10Rows);
    EXIT SCRIPT;
ENDIF

IF $(vCID10DistinctCodes) <> 14230 THEN
    TRACE [EXTRACAO][REF_CID10] distinct code mismatch. Expected=14230 Actual=$(vCID10DistinctCodes);
    EXIT SCRIPT;
ENDIF

IF $(vCID10Length3) <> 2042 THEN
    TRACE [EXTRACAO][REF_CID10] length-3 count mismatch. Expected=2042 Actual=$(vCID10Length3);
    EXIT SCRIPT;
ENDIF

IF $(vCID10Length4) <> 12188 THEN
    TRACE [EXTRACAO][REF_CID10] length-4 count mismatch. Expected=12188 Actual=$(vCID10Length4);
    EXIT SCRIPT;
ENDIF

IF $(vCID10InvalidCompetence) <> 0 THEN
    TRACE [EXTRACAO][REF_CID10] reference competence mismatch. Count=$(vCID10InvalidCompetence);
    EXIT SCRIPT;
ENDIF

IF $(vCID10EmptyDescriptions) <> 0 THEN
    TRACE [EXTRACAO][REF_CID10] empty description count=$(vCID10EmptyDescriptions);
    EXIT SCRIPT;
ENDIF

MAP_CID10:
MAPPING LOAD
    CID10_CODIGO,
    1
RESIDENT REF_CID10;

TMP_CID10_RD_COVERAGE:
LOAD
    Count(*) AS rd_rows,
    Sum(
        If(
            ApplyMap(
                'MAP_CID10',
                Text(RTrim(Text(DIAG_PRINC))),
                0
            ) = 0,
            1,
            0
        )
    ) AS unmatched_rows
FROM [QVD\SRC_SIH_RD.qvd] (qvd);

LET vCID10RDRows = Peek('rd_rows', 0, 'TMP_CID10_RD_COVERAGE');
LET vCID10UnmatchedRows = Peek('unmatched_rows', 0, 'TMP_CID10_RD_COVERAGE');

DROP TABLE TMP_CID10_RD_COVERAGE;

IF $(vCID10RDRows) <> 566672 THEN
    TRACE [EXTRACAO][REF_CID10] RD reconciliation mismatch. Expected=566672 Actual=$(vCID10RDRows);
    EXIT SCRIPT;
ENDIF

IF $(vCID10UnmatchedRows) <> 0 THEN

    TRACE [EXTRACAO][REF_CID10] unmatched RD rows=$(vCID10UnmatchedRows). Generating diagnostic before controlled exit;

    CID10_QVD_UNMATCHED_DIAGNOSTIC:
    LOAD
        Text(DIAG_PRINC) AS diag_princ_qvd,
        RTrim(Text(DIAG_PRINC)) AS diag_princ_rtrim,
        Upper(RTrim(Text(DIAG_PRINC))) AS diag_princ_upper_rtrim,
        Text(RTrim(Text(DIAG_PRINC))) AS diag_princ_text_after_rtrim,
        Len(Text(DIAG_PRINC)) AS qvd_length,
        Len(RTrim(Text(DIAG_PRINC))) AS rtrim_length,
        Len(Text(RTrim(Text(DIAG_PRINC)))) AS text_after_rtrim_length,
        IsNum(DIAG_PRINC) AS is_num,
        IsText(DIAG_PRINC) AS is_text,
        If(
            IsNum(DIAG_PRINC),
            Num(DIAG_PRINC, '0.###############', '.', ''),
            ''
        ) AS numeric_value,
        Ord(Mid(Text(DIAG_PRINC), 1, 1)) AS char_1_ord,
        Ord(Mid(Text(DIAG_PRINC), 2, 1)) AS char_2_ord,
        Ord(Mid(Text(DIAG_PRINC), 3, 1)) AS char_3_ord,
        Ord(Mid(Text(DIAG_PRINC), 4, 1)) AS char_4_ord,
        Count(*) AS occurrences,
        ApplyMap(
            'MAP_CID10',
            Text(DIAG_PRINC),
            0
        ) AS direct_text_match,
        ApplyMap(
            'MAP_CID10',
            Text(RTrim(Text(DIAG_PRINC))),
            0
        ) AS text_after_rtrim_match,
        ApplyMap(
            'MAP_CID10',
            Upper(RTrim(Text(DIAG_PRINC))),
            0
        ) AS upper_rtrim_match
    FROM [QVD\SRC_SIH_RD.qvd] (qvd)
    WHERE ApplyMap(
        'MAP_CID10',
        RTrim(Text(DIAG_PRINC)),
        0
    ) = 0
    GROUP BY
        Text(DIAG_PRINC),
        RTrim(Text(DIAG_PRINC)),
        Upper(RTrim(Text(DIAG_PRINC))),
        Text(RTrim(Text(DIAG_PRINC))),
        Len(Text(DIAG_PRINC)),
        Len(RTrim(Text(DIAG_PRINC))),
        Len(Text(RTrim(Text(DIAG_PRINC)))),
        IsNum(DIAG_PRINC),
        IsText(DIAG_PRINC),
        If(
            IsNum(DIAG_PRINC),
            Num(DIAG_PRINC, '0.###############', '.', ''),
            ''
        ),
        Ord(Mid(Text(DIAG_PRINC), 1, 1)),
        Ord(Mid(Text(DIAG_PRINC), 2, 1)),
        Ord(Mid(Text(DIAG_PRINC), 3, 1)),
        Ord(Mid(Text(DIAG_PRINC), 4, 1)),
        ApplyMap(
            'MAP_CID10',
            Text(DIAG_PRINC),
            0
        ),
        ApplyMap(
            'MAP_CID10',
            Text(RTrim(Text(DIAG_PRINC))),
            0
        ),
        ApplyMap(
            'MAP_CID10',
            Upper(RTrim(Text(DIAG_PRINC))),
            0
        );

    IF ScriptErrorCount > $(vExtractionErrorsBefore) THEN
        TRACE [EXTRACAO][REF_CID10] unmatched diagnostic LOAD failed. Errors=$(ScriptErrorList);
        EXIT SCRIPT;
    ENDIF

    LET vCID10UnmatchedDistinct = NoOfRows('CID10_QVD_UNMATCHED_DIAGNOSTIC');

    STORE CID10_QVD_UNMATCHED_DIAGNOSTIC
    INTO [QVD\_DIAGNOSTIC_CID10_QVD_UNMATCHED.csv]
    (txt, utf8, delimiter is ';', embedded labels);

    IF ScriptErrorCount > $(vExtractionErrorsBefore) THEN
        TRACE [EXTRACAO][REF_CID10] unmatched diagnostic STORE failed. Errors=$(ScriptErrorList);
        EXIT SCRIPT;
    ENDIF

    TRACE [EXTRACAO][REF_CID10] unmatched diagnostic written. Distinct=$(vCID10UnmatchedDistinct) File=QVD\_DIAGNOSTIC_CID10_QVD_UNMATCHED.csv;

    DROP TABLE CID10_QVD_UNMATCHED_DIAGNOSTIC;

    EXIT SCRIPT;
ENDIF

STORE REF_CID10 INTO [QVD\REF_CID10.qvd] (qvd);

IF ScriptErrorCount > $(vExtractionErrorsBefore) THEN
    TRACE [EXTRACAO][REF_CID10] QVD STORE failed. Errors=$(ScriptErrorList);
    EXIT SCRIPT;
ENDIF

TRACE [EXTRACAO][REF_CID10] PASS rows=$(vCID10Rows) unmatched_rd=$(vCID10UnmatchedRows);

DROP TABLE REF_CID10;

EXTRACAO_CID10_CHECKPOINT:
LOAD
    Timestamp(Now(1)) AS generated_at,
    'EXTRACAO_CID10' AS stage,
    'PASS_PARTIAL' AS status,
    $(vCID10Rows) AS cid10_rows,
    $(vCID10DistinctCodes) AS cid10_distinct_codes,
    $(vCID10Length3) AS cid10_length_3,
    $(vCID10Length4) AS cid10_length_4,
    $(vCID10RDRows) AS rd_rows,
    $(vCID10UnmatchedRows) AS cid10_unmatched_rd_rows
AUTOGENERATE 1;

STORE EXTRACAO_CID10_CHECKPOINT
INTO [QVD\_CHECKPOINT_EXTRACAO_CID10.csv]
(txt, utf8, delimiter is ';', embedded labels);

IF ScriptErrorCount > $(vExtractionErrorsBefore) THEN
    TRACE [EXTRACAO][REF_CID10] checkpoint STORE failed. Errors=$(ScriptErrorList);
    EXIT SCRIPT;
ENDIF

DROP TABLE EXTRACAO_CID10_CHECKPOINT;

TRACE [EXTRACAO] PHASE_III_C2_CID10_STAGING_PASS ROWS=$(vCID10Rows) UNMATCHED_RD=$(vCID10UnmatchedRows);
TRACE [EXTRACAO] PARTIAL ONLY — SIGTAP procedure, CNES tipo/leito, municipal reference and establishment history remain pending; no final extraction success marker emitted.
